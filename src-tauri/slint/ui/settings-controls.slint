import { Palette } from "palette.slint";
import { LineEdit } from "std-widgets.slint";

// Settings-only controls: fixed touch targets, persistent labels, intrinsic cards.
export component SettingsAction inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> danger: false;
    callback clicked;
    min-width: 0px;
    height: 44px;
    border-radius: 10px;
    border-width: 1px;
    border-color: !root.enabled ? Palette.n200 : root.danger ? Palette.r300 : root.primary ? Palette.e600 : Palette.n300;
    background: !root.enabled ? Palette.n100 : root.primary ? (touch.pressed ? #047857 : touch.has-hover ? Palette.e500 : Palette.e600) : touch.pressed ? Palette.n200 : touch.has-hover ? Palette.n100 : Palette.surface;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    Image { width: 22px; height: 22px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: root.icon; colorize: root.primary ? white : Palette.n600; visible: root.text == ""; image-fit: contain; }
    if root.text != "": Text {
        x: 10px; width: parent.width - 20px;
        text: root.text;
        color: !root.enabled ? Palette.n400 : root.primary ? white : root.danger ? Palette.r600 : Palette.n700;
        font-size: 13px; font-weight: 650;
        horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

export component SettingsTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked;
    min-width: 0px;
    height: 44px;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.selected ? Palette.e300 : transparent;
    background: !root.enabled ? Palette.n50 : root.selected ? Palette.e50 : touch.has-hover ? Palette.n100 : Palette.surface;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    Text {
        x: 8px; width: parent.width - 16px;
        text: root.text;
        color: !root.enabled ? Palette.n400 : root.selected ? Palette.e700 : Palette.n600;
        font-size: 13px; font-weight: root.selected ? 700 : 500;
        horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

export component SettingsCard inherits Rectangle {
    in property <string> title;
    in property <string> description: "";
    min-width: 0px;
    min-height: content.min-height;
    preferred-height: content.preferred-height;
    vertical-stretch: 0;
    border-radius: 14px; border-width: 1px; border-color: Palette.n200; background: Palette.surface;
    content := VerticalLayout {
        padding: 16px; spacing: 12px; alignment: start;
        VerticalLayout {
            spacing: 4px;
            Text { min-width: 0px; text: root.title; color: Palette.n800; font-size: 16px; font-weight: 700; wrap: word-wrap; }
            if root.description != "": Text { min-width: 0px; text: root.description; color: Palette.n500; font-size: 12px; wrap: word-wrap; }
        }
        @children
    }
}

export component SettingsField inherits Rectangle {
    in property <string> label;
    in property <string> hint: "";
    in property <string> placeholder: "";
    in property <bool> enabled: true;
    in-out property <string> text;
    callback edited;
    callback keyboard;
    min-width: 0px;
    min-height: content.min-height;
    preferred-height: content.preferred-height;
    vertical-stretch: 0;
    forward-focus: edit;
    content := VerticalLayout {
        alignment: start; spacing: 6px;
        Text { min-width: 0px; text: root.label; font-size: 12px; font-weight: 600; color: Palette.n600; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 6px; height: 44px;
            edit := LineEdit { min-width: 0px; horizontal-stretch: 1; height: 44px; text <=> root.text; placeholder-text: root.placeholder; enabled: root.enabled; edited => { root.edited(); } }
            SettingsAction { width: 46px; text: ""; icon: @image-url("../assets/icons/settings-keyboard.svg"); accessible-label: root.label; enabled: root.enabled; clicked => { root.keyboard(); } }
        }
        if root.hint != "": Text { min-width: 0px; text: root.hint; font-size: 11px; color: Palette.n500; wrap: word-wrap; }
    }
}

export component SettingsSelect inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> hint: "";
    in property <bool> enabled: true;
    in property <bool> option: false;
    in property <bool> selected: false;
    callback clicked;
    min-width: 0px;
    min-height: content.min-height;
    preferred-height: content.preferred-height;
    vertical-stretch: 0;
    content := VerticalLayout {
        spacing: 6px; alignment: start;
        if root.label != "": Text { min-width: 0px; text: root.label; font-size: 12px; font-weight: 600; color: Palette.n600; wrap: word-wrap; }
        Rectangle {
            min-height: max(48px, value-row.min-height); preferred-height: max(48px, value-row.preferred-height);
            border-radius: 10px; border-width: 1px; border-color: root.selected || touch.has-hover ? Palette.e500 : Palette.n300;
            background: !root.enabled ? Palette.n100 : root.selected || touch.pressed ? Palette.e50 : Palette.surface;
            accessible-role: button; accessible-label: root.label + ": " + root.value; accessible-enabled: root.enabled;
            value-row := HorizontalLayout {
                padding: 10px; spacing: 10px;
                Text { min-width: 0px; horizontal-stretch: 1; text: root.value; font-size: 14px; color: root.enabled ? Palette.n800 : Palette.n400; wrap: word-wrap; vertical-alignment: center; }
                Image { width: 22px; height: 22px; source: root.option ? @image-url("../assets/icons/settings-check.svg") : @image-url("../assets/icons/settings-chevron.svg"); visible: !root.option || root.selected; colorize: root.option ? Palette.e700 : Palette.n500; image-fit: contain; }
            }
            touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
        }
        if root.hint != "": Text { min-width: 0px; text: root.hint; font-size: 12px; color: Palette.n500; wrap: word-wrap; }
    }
}

export component SettingsToggle inherits Rectangle {
    in property <string> label;
    in property <string> description: "";
    in property <string> state-label;
    in property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled;
    min-width: 0px;
    min-height: max(48px, content.min-height);
    preferred-height: max(48px, content.preferred-height);
    vertical-stretch: 0;
    accessible-role: button; accessible-label: root.label + ": " + root.state-label; accessible-enabled: root.enabled;
    content := HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1; spacing: 4px; alignment: center;
            Text { min-width: 0px; text: root.label; font-size: 14px; font-weight: 600; color: Palette.n800; wrap: word-wrap; }
            if root.description != "": Text { min-width: 0px; text: root.description; font-size: 12px; color: Palette.n500; wrap: word-wrap; }
        }
        Text { text: root.state-label; color: root.checked ? Palette.e700 : Palette.n500; font-size: 12px; vertical-alignment: center; }
        Rectangle {
            width: 48px; height: 28px; border-radius: 14px;
            background: !root.enabled ? Palette.n300 : root.checked ? Palette.e600 : Palette.n400;
            Rectangle { width: 22px; height: 22px; x: root.checked ? 23px : 3px; y: 3px; border-radius: 11px; background: white; }
        }
    }
    TouchArea { enabled: root.enabled; clicked => { root.toggled(); } }
}

export component SettingsNotice inherits Rectangle {
    in property <string> text;
    in property <bool> warning: false;
    in property <bool> success: false;
    min-width: 0px;
    min-height: content.min-height;
    preferred-height: content.preferred-height;
    vertical-stretch: 0;
    border-radius: 10px; border-width: 1px;
    border-color: root.warning ? Palette.a300 : root.success ? Palette.e200 : Palette.n200;
    background: root.warning ? Palette.a50 : root.success ? Palette.e50 : Palette.n100;
    content := VerticalLayout {
        padding: 12px;
        Text { min-width: 0px; text: root.text; color: root.warning ? Palette.a700 : root.success ? Palette.e700 : Palette.n600; font-size: 12px; wrap: word-wrap; }
    }
}
