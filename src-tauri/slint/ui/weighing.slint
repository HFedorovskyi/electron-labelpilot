component ProductionJobFlowCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> detail;
    in property <image> icon;
    in property <bool> compact: false;

    height: root.compact ? 48px : 58px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Palette.n200;
    background: Palette.n50;

    HorizontalLayout {
        padding-left: root.compact ? 7px : 9px;
        padding-right: root.compact ? 7px : 9px;
        spacing: root.compact ? 6px : 8px;

        Rectangle {
            width: root.compact ? 28px : 32px;
            height: root.compact ? 28px : 32px;
            y: (parent.height - self.height) / 2;
            border-radius: root.compact ? 8px : 9px;
            background: Palette.e100;
            AppIcon {
                width: root.compact ? 16px : 18px;
                height: root.compact ? 16px : 18px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                icon: root.icon;
                icon-color: Palette.e700;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: root.label;
                color: Palette.n500;
                font-size: root.compact ? 7px : 8px;
                font-weight: 750;
                letter-spacing: 0.35px;
                overflow: elide;
            }
            Text {
                text: root.value;
                color: Palette.n900;
                font-family: "Consolas";
                font-size: root.compact ? 11px : 13px;
                font-weight: 800;
                overflow: elide;
            }
            Text {
                text: root.detail;
                color: Palette.n500;
                font-size: root.compact ? 7px : 8px;
                font-weight: 650;
                overflow: elide;
            }
        }
    }
}
export struct PrintQueueRow {
