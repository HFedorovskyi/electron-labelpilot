import { LineEdit, ScrollView } from "std-widgets.slint";
import "../assets/fonts/Inter-Regular.ttf";
import "../assets/fonts/Inter-Bold.ttf";

global Palette {
    out property <color> n50: #fafafa;
    out property <color> n100: #f5f5f5;
    out property <color> n200: #e5e5e5;
    out property <color> n300: #d4d4d4;
    out property <color> n400: #a3a3a3;
    out property <color> n500: #737373;
    out property <color> n600: #525252;
    out property <color> n700: #404040;
    out property <color> n800: #262626;
    out property <color> n900: #171717;
    out property <color> e50: #ecfdf5;
    out property <color> e100: #d1fae5;
    out property <color> e200: #a7f3d0;
    out property <color> e300: #6ee7b7;
    out property <color> e400: #34d399;
    out property <color> e500: #10b981;
    out property <color> e600: #059669;
    out property <color> e700: #047857;
    out property <color> a50: #fffbeb;
    out property <color> a300: #fcd34d;
    out property <color> a500: #f59e0b;
    out property <color> a600: #d97706;
    out property <color> a700: #b45309;
    out property <color> r50: #fef2f2;
    out property <color> r100: #fee2e2;
    out property <color> r300: #fca5a5;
    out property <color> r400: #f87171;
    out property <color> r500: #ef4444;
    out property <color> r600: #dc2626;
    out property <color> r700: #b91c1c;
}

component AppIcon inherits Rectangle {
    in property <image> icon;
    in property <color> icon-color: Palette.n500;
    background: transparent;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.icon;
        image-fit: contain;
    }
}

// Slint layouts align fixed-size children to the cross-axis origin. These
// slots occupy that cross-axis and keep the bitmap centered at any DPI.
component HorizontalIcon inherits Rectangle {
    in property <image> icon;
    in property <color> icon-color: Palette.n500;
    in property <length> icon-size: 20px;
    width: root.icon-size;
    vertical-stretch: 1;
    background: transparent;
    AppIcon {
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.icon;
        icon-color: root.icon-color;
    }
}

component VerticalIcon inherits Rectangle {
    in property <image> icon;
    in property <color> icon-color: Palette.n500;
    in property <length> icon-size: 20px;
    height: root.icon-size;
    horizontal-stretch: 1;
    background: transparent;
    AppIcon {
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.icon;
        icon-color: root.icon-color;
    }
}

component StatusDot inherits Rectangle {
    in property <color> dot-color: Palette.e500;
    in property <length> dot-size: 8px;
    width: root.dot-size;
    vertical-stretch: 1;
    background: transparent;
    Rectangle {
        width: root.dot-size;
        height: root.dot-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: root.dot-size / 2;
        background: root.dot-color;
    }
}

component SidebarItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active: false;
    in property <bool> collapsed: false;
    in property <bool> danger: false;
    callback clicked;

    height: 44px;
    border-radius: 12px;
    border-width: root.active ? 1px : 0px;
    border-color: #10b98133;
    background: root.active ? #d1fae580 : touch.has-hover ? (root.danger ? Palette.r100 : Palette.n100) : transparent;

    HorizontalLayout {
        alignment: root.collapsed ? center : start;
        spacing: 12px;
        padding-left: root.collapsed ? 0px : 16px;
        padding-right: root.collapsed ? 0px : 16px;
        HorizontalIcon {
            icon-size: 20px;
            icon: root.icon;
            icon-color: root.danger ? Palette.r500 : root.active ? Palette.e600 : touch.has-hover ? Palette.n900 : Palette.n500;
        }
        Text {
            visible: !root.collapsed;
            text: root.text;
            color: root.danger ? Palette.r500 : root.active ? Palette.e600 : touch.has-hover ? Palette.n900 : Palette.n500;
            font-size: 14px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component MainButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <color> normal-color: Palette.e600;
    in property <color> hover-color: Palette.e500;
    in property <color> pressed-color: Palette.e700;
    in property <bool> enabled: true;
    callback clicked;

    height: 56px;
    border-radius: 24px;
    background: !root.enabled ? #05966966 : touch.pressed ? root.pressed-color : touch.has-hover ? root.hover-color : root.normal-color;
    drop-shadow-color: root.enabled ? #10b98155 : transparent;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;

    HorizontalLayout {
        alignment: center;
        spacing: 12px;
        HorizontalIcon { icon-size: 24px; icon: root.icon; icon-color: white; }
        Text { text: root.text; color: white; font-size: 20px; font-weight: 700; vertical-alignment: center; overflow: elide; }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component TileButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <color> normal-color: Palette.n100;
    in property <color> hover-color: Palette.n200;
    in property <color> pressed-color: Palette.n300;
    in property <color> outline: Palette.n300;
    in property <color> foreground: Palette.n500;
    in property <bool> enabled: true;
    in property <bool> short: false;
    callback clicked;

    height: root.short ? 66px : 80px;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.outline;
    background: !root.enabled ? #f5f5f580 : touch.pressed ? root.pressed-color : touch.has-hover ? root.hover-color : root.normal-color;
    drop-shadow-color: #0000000d;
    drop-shadow-blur: 5px;
    drop-shadow-offset-y: 1px;

    VerticalLayout {
        alignment: center;
        spacing: root.short ? 4px : 8px;
        VerticalIcon {
            icon-size: root.short ? 21px : 24px;
            icon: root.icon;
            icon-color: root.enabled ? (touch.has-hover ? Palette.n800 : root.foreground) : Palette.n400;
        }
        Text {
            text: root.text;
            color: root.enabled ? (touch.has-hover ? Palette.n800 : root.foreground) : Palette.n400;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 1.2px;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component StatusPill inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> show-icon: false;
    in property <bool> good: true;

    height: 38px;
    min-width: 142px;
    border-radius: 19px;
    border-width: 1px;
    border-color: root.good ? #10b98133 : #ef444433;
    background: root.good ? #10b9811a : #ef44441a;

    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        padding-left: 14px;
        padding-right: 14px;
        if root.show-icon: HorizontalIcon {
            icon-size: 14px;
            icon: root.icon;
            icon-color: root.good ? Palette.e600 : Palette.r500;
        }
        if !root.show-icon: StatusDot {
            dot-size: 8px;
            dot-color: root.good ? Palette.e500 : Palette.r500;
        }
        Text {
            text: root.text;
            color: root.good ? Palette.e600 : Palette.r500;
            font-size: 14px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

component ThinStatRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Palette.n900;
    in property <bool> compact: false;
    height: root.compact ? 24px : 28px;
    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.n200; }
    HorizontalLayout {
        Text { text: root.label; color: Palette.n500; font-size: 14px; vertical-alignment: center; }
        Text { text: root.value; color: root.value-color; font-size: 14px; font-family: "Consolas"; horizontal-alignment: right; vertical-alignment: center; }
    }
}

component StatEditorRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <image> icon;
    in property <bool> compact: false;
    callback clicked;

    height: root.compact ? 42px : 46px;
    border-radius: 12px;
    border-width: 1px;
    border-color: touch.has-hover ? Palette.e300 : Palette.n300;
    background: touch.pressed ? Palette.e100 : touch.has-hover ? Palette.e50 : Palette.n100;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text { text: root.label; color: Palette.n500; font-size: 12px; font-weight: 700; letter-spacing: 0.8px; vertical-alignment: center; }
        HorizontalLayout {
            alignment: end;
            spacing: 12px;
            Text { text: root.value; color: touch.has-hover ? Palette.e600 : Palette.n900; font-family: "Consolas"; font-size: 17px; font-weight: 700; vertical-alignment: center; }
            Rectangle {
                width: 34px;
                vertical-stretch: 1;
                Rectangle {
                    width: 34px;
                    height: 34px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: touch.has-hover ? Palette.e400 : Palette.n300;
                    background: touch.has-hover ? Palette.e100 : white;
                    AppIcon { width: 16px; height: 16px; x: 9px; y: 9px; icon: root.icon; icon-color: Palette.e600; }
                }
            }
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component KeyButton inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 56px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Palette.n300;
    background: touch.pressed ? Palette.e100 : touch.has-hover ? Palette.e50 : Palette.n50;
    Text { text: root.text; color: Palette.n900; font-size: 22px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component CompactActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <bool> primary: false;
    callback clicked;
    min-width: 112px;
    height: 48px;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.danger ? Palette.r300 : root.primary ? Palette.e500 : Palette.n300;
    background: !root.enabled ? Palette.n100 : touch.pressed ? (root.danger ? Palette.r300 : Palette.e200) : touch.has-hover ? (root.danger ? Palette.r100 : Palette.e50) : root.primary ? Palette.e600 : white;
    Text {
        text: root.text;
        color: !root.enabled ? Palette.n400 : root.primary ? white : root.danger ? Palette.r600 : Palette.e700;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component SettingsChoiceButton inherits Rectangle {
    in property <string> text;
    in property <string> subtext: "";
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 52px;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.selected ? Palette.e500 : Palette.n300;
    background: !root.enabled ? Palette.n100 : touch.pressed ? Palette.e200 : root.selected ? Palette.e50 : touch.has-hover ? Palette.n100 : white;
    VerticalLayout {
        alignment: center;
        spacing: 1px;
        Text { text: root.text; color: !root.enabled ? Palette.n400 : root.selected ? Palette.e700 : Palette.n700; font-size: 13px; font-weight: 700; horizontal-alignment: center; overflow: elide; }
        if root.subtext != "": Text { text: root.subtext; color: root.selected ? Palette.e600 : Palette.n400; font-size: 10px; horizontal-alignment: center; overflow: elide; }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component QueueSummaryCard inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <color> accent: Palette.e600;
    horizontal-stretch: 1;
    height: 78px;
    border-radius: 18px;
    border-width: 1px;
    border-color: Palette.n200;
    background: white;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        Rectangle { width: 5px; height: 42px; border-radius: 3px; background: root.accent; }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: root.value; color: Palette.n900; font-size: 24px; font-weight: 800; }
            Text { text: root.label; color: Palette.n500; font-size: 12px; font-weight: 600; overflow: elide; }
        }
    }
}

export struct PrintQueueRow {
    job-id: string,
    short-id: string,
    state: string,
    state-label: string,
    printer-name: string,
    route: string,
    action: string,
    payload: string,
    attempts: int,
    updated: string,
    error: string,
    can-retry: bool,
    can-cancel: bool,
    uncertain: bool,
    good: bool,
    warning: bool,
}

export struct PrinterDiagnosticRow {
    role: string,
    role-label: string,
    printer-name: string,
    endpoint: string,
    transport: string,
    status: string,
    status-label: string,
    details: string,
    reachable: bool,
    configured: bool,
    queried: string,
}

export struct PrinterSettingsRoleRow {
    role: string,
    role-label: string,
    description: string,
    active: bool,
    name: string,
    endpoint: string,
    connection: string,
    protocol: string,
    dpi: string,
    profile: string,
}

export struct PrinterChoiceRow {
    value: string,
    label: string,
    details: string,
}

export struct ScaleProtocolRow {
    id: string,
    name: string,
    description: string,
    polling-required: bool,
    default-baud-rate: int,
    serial-format: string,
}

export struct ProductRow {
    id: int,
    name: string,
    article: string,
    details: string,
}

export struct ProductionJobRow {
    job-id: int,
    product-id: int,
    product-name: string,
    article: string,
    quantity: string,
    printed: string,
    remaining: string,
    progress: float,
    unit: string,
    batch: string,
    marking-date: string,
    status: string,
    status-label: string,
    completed: bool,
}

export struct OperatorRow {
    uuid: string,
    full-name: string,
    short-code: string,
    has-pin: bool,
    is-last: bool,
}
export component WeighingPrototype inherits Window {
    title: "LabelPilot";
    preferred-width: 1366px;
    preferred-height: 768px;
    min-width: 1024px;
    min-height: 640px;
    in-out property <bool> kiosk-mode: true;
    no-frame: root.kiosk-mode;
    background: Palette.n50;
    default-font-family: "Inter";

    in-out property <string> gross-weight: "0.000";
    in-out property <string> net-weight: "0.000";
    in-out property <bool> stable: false;
    in-out property <int> units-in-box: 0;
    in-out property <int> boxes-on-pallet: 0;
    in-out property <int> total-units: 0;
    in-out property <string> pack-number: "—";
    in-out property <string> box-number: "—";
    in-out property <string> batch-number: "";
    in-out property <string> labeling-date: "—";
    in-out property <string> today-date: "—";
    in-out property <string> previous-date: "—";
    in-out property <string> last-print: "—";
    in-out property <[ProductRow]> products: [];
    in-out property <int> selected-product-id: 0;
    in-out property <string> product-name: "Товары не загружены";
    in-out property <string> product-article: "";
    in-out property <int> expiration-days: 0;
    in-out property <float> product-tare-kg: 0;
    in-out property <int> box-limit: 0;
    in-out property <string> product-search: "";
    in-out property <string> station-number: "--";
    in-out property <string> operator-name: "Оператор не выбран";
    in-out property <[OperatorRow]> operators: [];
    in-out property <bool> operator-login-visible: false;
    in-out property <bool> operator-bypass-active: false;
    in-out property <string> operator-login-error: "";
    in-out property <bool> operator-login-busy: false;
    in-out property <bool> operator-pin-visible: false;
    in-out property <string> operator-pin: "";
    in-out property <int> selected-operator-index: -1;
    in-out property <string> selected-operator-name: "";
    in-out property <string> server-status: "Локальные данные";
    in-out property <bool> server-online: false;
    in-out property <string> scale-status: "Весы: отключены";
    in-out property <bool> scale-online: false;
    in-out property <string> printer-status: "Принтер: не настроен";
    in-out property <bool> printer-ready: false;
    in-out property <bool> auto-print-enabled: false;
    in-out property <string> auto-print-status: "";
    in-out property <bool> toast-visible: false;
    in-out property <string> toast-text: "";
    in-out property <bool> alert-visible: false;
    in-out property <string> alert-text: "";
    in-out property <int> active-page: 0;
    in-out property <[PrintQueueRow]> durable-jobs: [];
    in-out property <int> queue-waiting: 0;
    in-out property <int> queue-accepted: 0;
    in-out property <int> queue-problems: 0;
    in-out property <int> queue-total: 0;
    in-out property <bool> queue-busy: false;
    in-out property <string> queue-status: "Очередь ещё не загружена";
    in-out property <[PrinterDiagnosticRow]> printer-diagnostics: [];
    in-out property <bool> diagnostics-busy: false;
    in-out property <string> diagnostics-status: "Проверка ещё не запускалась";
    in-out property <[PrinterSettingsRoleRow]> printer-settings-roles: [];
    in-out property <[PrinterChoiceRow]> settings-system-printers: [];
    in-out property <[PrinterChoiceRow]> settings-serial-ports: [];
    in-out property <string> settings-selected-role: "packPrinter";
    in-out property <string> settings-selected-role-label: "Этикетка упаковки";
    in-out property <string> settings-selected-description: "";
    in-out property <bool> settings-active: false;
    in-out property <string> settings-name: "Pack Printer";
    in-out property <string> settings-connection: "windows_driver";
    in-out property <string> settings-protocol: "image";
    in-out property <string> settings-compatibility: "auto";
    in-out property <string> settings-effective-profile: "generic-zpl-safe";
    property <string> settings-profile-language: root.settings-protocol == "image" ? "zpl" : root.settings-protocol;
    property <string> settings-preview-profile: root.settings-protocol == "browser" ? "windows-driver" : !root.settings-dirty && root.settings-compatibility == "auto" ? root.settings-effective-profile : root.settings-compatibility == "advanced" && root.settings-profile-language == "zpl" ? "zpl-full" : root.settings-compatibility == "advanced" && root.settings-profile-language == "tspl" ? "tspl2-full" : root.settings-profile-language == "tspl" ? "generic-tspl-safe" : root.settings-profile-language == "epl" ? "generic-epl-raster" : root.settings-profile-language == "cpcl" ? "generic-cpcl-raster" : root.settings-profile-language == "dpl" ? "generic-dpl-raster" : root.settings-profile-language == "sbpl" ? "generic-sbpl-raster" : "generic-zpl-safe";
    in-out property <string> settings-ip: "";
    in-out property <string> settings-port: "9100";
    in-out property <string> settings-serial-port: "";
    in-out property <string> settings-baud-rate: "9600";
    in-out property <string> settings-driver-name: "";
    in-out property <string> settings-dpi: "203";
    in-out property <string> settings-ram-cache: "auto";
    in-out property <bool> settings-z64: false;
    in-out property <bool> settings-persistent-connection: false;
    in-out property <string> settings-darkness: "";
    in-out property <string> settings-print-speed: "";
    in-out property <string> settings-gap-mm: "";
    in-out property <string> settings-width-mm: "";
    in-out property <string> settings-height-mm: "";
    in-out property <bool> settings-auto-print: true;
    in-out property <bool> settings-dirty: false;
    in-out property <bool> settings-busy: false;
    in-out property <bool> settings-advanced-visible: false;
    in-out property <string> settings-status: "Настройки ещё не загружены";
    in-out property <string> settings-detection: "";
    in-out property <[ScaleProtocolRow]> scale-settings-protocols: [];
    in-out property <[PrinterChoiceRow]> scale-settings-serial-ports: [];
    in-out property <string> scale-settings-connection: "simulator";
    in-out property <string> scale-settings-protocol: "simulator";
    in-out property <string> scale-settings-protocol-name: "Simulator";
    in-out property <string> scale-settings-protocol-description: "Встроенные виртуальные весы";
    in-out property <string> scale-settings-endpoint: "Встроенный симулятор";
    in-out property <string> scale-settings-serial-path: "";
    in-out property <string> scale-settings-baud-rate: "9600";
    in-out property <string> scale-settings-host: "";
    in-out property <string> scale-settings-port: "4001";
    in-out property <string> scale-settings-polling: "250";
    in-out property <string> scale-settings-stability-count: "4";
    in-out property <string> scale-settings-runtime-status: "disconnected";
    in-out property <bool> scale-settings-dirty: false;
    in-out property <bool> scale-settings-busy: false;
    in-out property <string> scale-settings-status: "Настройки весов ещё не загружены";
    in-out property <string> scale-settings-probe: "";

    in-out property <[ProductRow]> fixed-products: [];
    in-out property <int> fixed-selected-product-id: 0;
    in-out property <string> fixed-product-name: "Товары фиксированного веса не загружены";
    in-out property <string> fixed-product-article: "";
    in-out property <string> fixed-nominal-weight: "0.000";
    in-out property <string> fixed-min-weight: "0";
    in-out property <string> fixed-max-weight: "∞";
    in-out property <bool> fixed-control-in-range: false;
    in-out property <string> fixed-mode: "verify";
    in-out property <string> fixed-copies: "1";
    in-out property <bool> fixed-busy: false;
    in-out property <int> fixed-progress: 0;
    in-out property <int> fixed-progress-total: 0;
    in-out property <string> fixed-status: "Выберите товар фиксированного веса";
    in-out property <bool> fixed-product-modal-visible: false;
    in-out property <string> fixed-product-search: "";

    in-out property <[ProductionJobRow]> production-jobs: [];
    in-out property <bool> production-jobs-completed: false;
    in-out property <int> selected-production-job-id: 0;
    in-out property <int> selected-production-product-id: 0;
    in-out property <string> selected-production-job-product: "Выберите задание";
    in-out property <string> selected-production-job-article: "";
    in-out property <string> selected-production-job-quantity: "0";
    in-out property <string> selected-production-job-printed: "0";
    in-out property <string> selected-production-job-remaining: "0";
    in-out property <float> selected-production-job-progress: 0;
    in-out property <string> selected-production-job-unit: "pcs";
    in-out property <string> selected-production-job-batch: "";
    in-out property <string> selected-production-job-date: "—";
    in-out property <string> selected-production-job-status: "pending";
    in-out property <bool> selected-production-product-fixed: false;
    in-out property <string> selected-production-product-weight: "0.000";
    in-out property <bool> production-job-weight-valid: false;
    in-out property <bool> production-jobs-busy: false;
    in-out property <string> production-jobs-status: "Задания ещё не загружены";
    in-out property <[ProductRow]> catalog-products: [];
    in-out property <int> catalog-selected-product-id: 0;
    in-out property <string> catalog-search: "";
    in-out property <int> catalog-total: 0;
    in-out property <bool> catalog-truncated: false;
    in-out property <bool> catalog-busy: false;
    in-out property <string> catalog-status: "Каталог ещё не загружен";
    in-out property <string> catalog-name: "Выберите товар";
    in-out property <string> catalog-article: "—";
    in-out property <string> catalog-expiration: "—";
    in-out property <string> catalog-mode: "Весовой";
    in-out property <string> catalog-fixed-weight: "—";
    in-out property <string> catalog-portion-container: "Не назначена";
    in-out property <string> catalog-portion-tare: "0 г";
    in-out property <string> catalog-box-container: "Не назначена";
    in-out property <string> catalog-box-tare: "0 г";
    in-out property <string> catalog-box-limit: "—";
    in-out property <string> catalog-pack-label: "Не назначен";
    in-out property <string> catalog-box-label: "Не назначен";
    in-out property <string> catalog-pallet-label: "Не назначен";
    in-out property <string> catalog-extra: "Нет дополнительных данных";

    in-out property <bool> license-busy: false;
    in-out property <string> license-status: "Статус ещё не проверен";
    in-out property <string> license-station-name: "Станция не настроена";
    in-out property <string> license-station-uuid: "—";
    in-out property <string> license-station-number: "—";
    in-out property <string> license-last-sync: "Нет синхронизации";
    in-out property <string> license-server-address: "";
    in-out property <bool> license-server-configured: false;
    in-out property <bool> license-server-online: false;
    in-out property <bool> license-server-compatible: true;
    in-out property <string> license-server-version: "—";
    in-out property <string> license-min-client-version: "—";
    in-out property <string> license-compatibility: "";
    in-out property <bool> license-online: false;
    in-out property <bool> license-active: false;
    in-out property <bool> license-expired: false;
    in-out property <string> license-mode: "DEMO";
    in-out property <string> license-edition: "Demo";
    in-out property <string> license-customer: "—";
    in-out property <string> license-expires: "—";
    in-out property <string> license-id: "—";
    in-out property <string> license-stations: "—";
    in-out property <string> license-features: "Функции не получены";
    in-out property <string> license-signature: "Не проверена";
    in-out property <string> license-machine: "—";
    in-out property <bool> update-busy: false;
    in-out property <string> update-state: "idle";
    in-out property <string> update-status: "Готово к проверке обновлений";
    in-out property <string> update-current-version: "2.0.1";
    in-out property <string> update-available-version: "—";
    in-out property <string> update-notes: "Канал обновлений ещё не проверен";
    in-out property <string> update-size: "—";
    in-out property <int> update-progress: 0;
    in-out property <bool> update-available: false;
    in-out property <bool> update-ready: false;
    in-out property <bool> update-rollback-available: false;
    in-out property <string> update-offline-path: "";
    in-out property <string> update-error: "";


    in-out property <bool> confirm-print-action-visible: false;
    in-out property <string> confirm-print-action: "";
    in-out property <string> confirm-print-job-id: "";
    in-out property <string> confirm-print-job-title: "";
    in-out property <bool> confirm-print-uncertain: false;
    property <bool> product-modal-visible: false;
    property <bool> keypad-visible: false;
    property <bool> date-modal-visible: false;
    property <bool> delete-modal-visible: false;
    property <bool> sidebar-collapsed: false;
    in-out property <bool> compact: false;
    in-out property <bool> narrow: false;
    in-out property <bool> short: false;
    property <bool> effective-collapsed: root.sidebar-collapsed || root.compact;
    property <length> sidebar-width: root.effective-collapsed ? 72px : 256px;
    property <length> content-padding: root.narrow ? 18px : root.compact ? 24px : 36px;
    property <length> shell-width: min(root.width, 1920px);
    property <length> work-area-width: root.shell-width - root.sidebar-width;
    property <length> right-panel-width: (root.work-area-width - root.content-padding * 2 - (root.narrow ? 16px : 24px)) / 3;

    callback print-label;
    callback repeat-print;
    callback close-box;
    callback print-pallet;
    callback delete-last;
    callback quit-app;
    callback select-product(int);
    callback search-products(string);
    callback select-operator(int);
    callback submit-operator-pin(int, string);
    callback continue-without-operator;
    callback switch-operator;
    callback refresh-print-queue;
    callback retry-print-job(string);
    callback cancel-print-job(string);
    callback probe-printers;
    callback reload-printer-settings;
    callback select-printer-role(string);
    callback save-printer-settings;
    callback detect-printer-settings;
    callback test-printer-settings;
    callback reload-scale-settings;
    callback save-scale-settings;
    callback test-scale-settings;
    callback reload-fixed-weight;
    callback search-fixed-products(string);
    callback select-fixed-product(int);
    callback print-fixed-weight;
    callback start-fixed-batch;
    callback cancel-fixed-batch;
    callback reload-production-jobs;
    callback select-production-job(int);
    callback print-production-job-pack;
    callback complete-production-job;
    callback delete-production-job;
callback reload-catalog;
    callback search-catalog(string);
    callback select-catalog-product(int);
    callback reload-license;
    callback save-server-address(string);
    callback check-update;
    callback download-update;
    callback install-update;
    callback stage-offline-update(string);


    HorizontalLayout {
        width: root.shell-width;
        height: parent.height;
        x: (parent.width - self.width) / 2;
        spacing: 0px;

        Rectangle {
            width: root.sidebar-width;
            background: #ffffffee;
            border-width: 1px;
            border-color: Palette.n200;

            VerticalLayout {
                padding-left: root.effective-collapsed ? 12px : 16px;
                padding-right: root.effective-collapsed ? 12px : 16px;
                padding-top: root.effective-collapsed ? 12px : 16px;
                padding-bottom: root.effective-collapsed ? 12px : 16px;
                spacing: 0px;

                header := Rectangle {
                    height: root.effective-collapsed ? 76px : 108px;
                    background: header-touch.has-hover && root.effective-collapsed ? Palette.n100 : transparent;
                    border-radius: 12px;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        if root.effective-collapsed: HorizontalIcon {
                            icon-size: 24px;
                            icon: @image-url("../assets/icons/menu.png");
                        }
                        if !root.effective-collapsed: HorizontalLayout {
                            width: 224px;
                            alignment: start;
                            spacing: 8px;
                            HorizontalIcon {
                                icon-size: 36px;
                                icon: @image-url("../assets/sidebar-logo.svg");
                            }
                            Text {
                                text: "LabelPilot";
                                color: Palette.n800;
                                font-size: 22px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            HorizontalIcon {
                                icon-size: 20px;
                                icon: @image-url("../assets/icons/chevron-left.png");
                            }
                        }
                    }
                    header-touch := TouchArea {
                        clicked => { root.sidebar-collapsed = !root.sidebar-collapsed; }
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    SidebarItem {
                        text: "Весовая станция";
                        icon: @image-url("../assets/icons/scale-green.png");
                        active: root.active-page == 0;
                        collapsed: root.effective-collapsed;
                        clicked => { root.active-page = 0; }
                    }
                    SidebarItem {
                        text: "Фиксированный вес";
                        icon: @image-url("../assets/icons/weight.png");
                        active: root.active-page == 5;
                        collapsed: root.effective-collapsed;
                        clicked => { root.active-page = 5; root.reload-fixed-weight(); }
                    }
                    SidebarItem {
                        text: "Задания на печать";
                        icon: @image-url("../assets/icons/clipboard-list.png");
                        active: root.active-page == 6;
                        collapsed: root.effective-collapsed;
                        clicked => { root.active-page = 6; root.reload-production-jobs(); }
                    }
                    SidebarItem {
                        text: "Очередь печати";
                        icon: @image-url("../assets/icons/list-restart.png");
                        active: root.active-page == 1;
                        collapsed: root.effective-collapsed;
                        clicked => { root.active-page = 1; root.refresh-print-queue(); }
                    }
                    SidebarItem {
                        text: "Диагностика";
                        icon: @image-url("../assets/icons/stethoscope.png");
                        active: root.active-page == 2;
                        collapsed: root.effective-collapsed;
                        clicked => { root.active-page = 2; root.probe-printers(); }
                    }
                    SidebarItem {
                        text: "Товары";
                        icon: @image-url("../assets/icons/package.png");
                        active: root.active-page == 7;
                        collapsed: root.effective-collapsed;
                        clicked => { root.active-page = 7; root.reload-catalog(); }
                    }
                    SidebarItem {
                        text: "Лицензия";
                        icon: @image-url("../assets/icons/key-round.png");
                        active: root.active-page == 8;
                        collapsed: root.effective-collapsed;
                        clicked => { root.active-page = 8; root.reload-license(); }
                    }

                    SidebarItem {
                        text: "Обновление";
                        icon: @image-url("../assets/icons/refresh-cw.png");
                        active: root.active-page == 9;
                        collapsed: root.effective-collapsed;
                        clicked => { root.active-page = 9; root.check-update(); }
                    }
                    SidebarItem {
                        text: "Настройки";
                        icon: @image-url("../assets/icons/settings.png");
                        active: root.active-page == 3 || root.active-page == 4;
                        collapsed: root.effective-collapsed;
                        clicked => { root.active-page = 3; root.reload-printer-settings(); root.reload-scale-settings(); }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                SidebarItem {
                    text: "Выход";
                    icon: @image-url("../assets/icons/log-out-red.png");
                    collapsed: root.effective-collapsed;
                    danger: true;
                    clicked => { root.quit-app(); }
                }

                Rectangle {
                    height: root.effective-collapsed ? 116px : 156px;
                    Rectangle { y: 0px; height: 1px; background: Palette.n200; }

                    VerticalLayout {
                        padding-top: 14px;
                        spacing: 9px;

                        HorizontalLayout {
                            alignment: root.effective-collapsed ? center : start;
                            if !root.effective-collapsed: Text {
                                text: "СТАТУС СЕРВЕРА";
                                color: Palette.n500;
                                font-size: 10px;
                                font-weight: 700;
                                letter-spacing: 0.8px;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: root.effective-collapsed ? 0 : 1; }
                            StatusDot {
                                dot-size: root.effective-collapsed ? 12px : 7px;
                                dot-color: root.server-online ? Palette.e500 : Palette.a500;
                            }
                            if !root.effective-collapsed: Text {
                                text: root.server-status;
                                color: Palette.e600;
                                font-size: 12px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            alignment: root.effective-collapsed ? center : start;
                            if !root.effective-collapsed: Text {
                                text: "СТАНЦИЯ";
                                color: Palette.n500;
                                font-size: 10px;
                                font-weight: 700;
                                letter-spacing: 0.8px;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: root.effective-collapsed ? 0 : 1; }
                            Rectangle {
                                width: 40px;
                                height: 24px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Palette.n200;
                                background: Palette.n100;
                                Text {
                                    text: root.station-number;
                                    color: Palette.n700;
                                    font-family: "Consolas";
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        operator-switch-card := Rectangle {
                            height: 32px;
                            border-radius: 9px;
                            border-width: 1px;
                            border-color: operator-switch-touch.has-hover ? Palette.e300 : Palette.n200;
                            background: operator-switch-touch.pressed ? Palette.e100 : operator-switch-touch.has-hover ? Palette.e50 : transparent;
                            HorizontalLayout {
                                alignment: root.effective-collapsed ? center : start;
                                padding-left: root.effective-collapsed ? 0px : 7px;
                                padding-right: root.effective-collapsed ? 0px : 7px;
                                spacing: 7px;
                                HorizontalIcon {
                                    icon-size: 16px;
                                    icon: @image-url("../assets/icons/user.png");
                                }
                                if !root.effective-collapsed: Text {
                                    text: root.operator-name;
                                    color: operator-switch-touch.has-hover ? Palette.e700 : Palette.n700;
                                    font-size: 12px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            operator-switch-touch := TouchArea { clicked => { root.switch-operator(); } }
                        }
                        if !root.effective-collapsed: Text {
                            text: "ВЕРСИЯ 2.0.1";
                            color: Palette.e600;
                            font-size: 10px;
                            font-weight: 700;
                            letter-spacing: 1px;
                        }
                    }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: Palette.n50;

            HorizontalLayout {
                width: root.work-area-width;
                x: (parent.width - self.width) / 2;
                padding: root.content-padding;
                spacing: root.narrow ? 16px : 24px;

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: Palette.n200;
                    background: white;
                    drop-shadow-color: #00000012;
                    drop-shadow-blur: 8px;
                    drop-shadow-offset-y: 2px;

                    VerticalLayout {
                        padding: root.narrow ? 16px : 20px;
                        spacing: 16px;

                        HorizontalLayout {
                            height: 40px;
                            Text {
                                text: "Весовая станция";
                                color: Palette.n900;
                                font-size: 24px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;
                                if root.auto-print-enabled && !root.narrow: StatusPill {
                                    text: root.auto-print-status;
                                    good: true;
                                }
                                StatusPill {
                                    text: root.scale-status;
                                    good: root.scale-online;
                                }
                                StatusPill {
                                    text: root.printer-status;
                                    good: root.printer-ready;
                                    icon: @image-url("../assets/icons/printer-green.png");
                                    show-icon: true;
                                }
                            }
                        }

                        VerticalLayout {
                            height: 84px;
                            spacing: 8px;
                            Text {
                                text: "Поиск товара";
                                color: Palette.n400;
                                font-size: 14px;
                                font-weight: 500;
                            }
                            product-picker := Rectangle {
                                height: 58px;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: Palette.n300;
                                background: product-touch.pressed ? Palette.n200 : product-touch.has-hover ? Palette.n100 : Palette.n50;

                                HorizontalLayout {
                                    padding-left: 20px;
                                    padding-right: 20px;
                                    Text {
                                        text: root.product-name;
                                        color: Palette.n900;
                                        font-size: root.narrow ? 15px : 18px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    HorizontalIcon {
                                        icon-size: 24px;
                                        icon: @image-url("../assets/icons/search.png");
                                        icon-color: Palette.n400;
                                    }
                                }
                                product-touch := TouchArea {
                                    clicked => { root.product-modal-visible = true; root.product-search = ""; root.search-products(""); }
                                }
                            }
                        }

                        Rectangle {
                            height: root.narrow ? 130px : 140px;
                            border-radius: 16px;
                            border-width: 1px;
                            border-color: Palette.e200;
                            background: Palette.e50;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 6px;
                                Text {
                                    text: "НАИМЕНОВАНИЕ";
                                    color: Palette.e600;
                                    font-size: 14px;
                                    font-weight: 700;
                                    letter-spacing: 0.8px;
                                }
                                Text {
                                    text: root.product-name;
                                    color: Palette.e700;
                                    font-size: root.narrow ? 22px : 28px;
                                    font-weight: 700;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "АРТИКУЛ: " + (root.product-article == "" ? "—" : root.product-article) + "     СРОК ГОДНОСТИ: " + root.expiration-days;
                                    color: #34d39999;
                                    font-family: "Consolas";
                                    font-size: 14px;
                                }
                            }
                        }

                        HorizontalLayout {
                            height: root.short ? 140px : 158px;
                            spacing: 16px;

                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: Palette.n200;
                                background: Palette.n50;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Text {
                                        text: "ВЕС БРУТТО";
                                        color: Palette.n500;
                                        font-size: 12px;
                                        font-weight: 700;
                                        letter-spacing: 1.5px;
                                        horizontal-alignment: center;
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 5px;
                                        Text {
                                            text: root.gross-weight;
                                            color: Palette.e600;
                                            font-family: "Consolas";
                                            font-size: root.narrow ? 44px : 58px;
                                            font-weight: 300;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "кг";
                                            color: #10b98180;
                                            font-size: 24px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if root.stable: HorizontalLayout {
                                        alignment: center;
                                        spacing: 8px;
                                        StatusDot {
                                            dot-size: 4px;
                                            dot-color: Palette.e500;
                                        }
                                        Text {
                                            text: root.auto-print-enabled && root.auto-print-status != "" ? root.auto-print-status : "СТАБИЛЬНО";
                                            color: Palette.e600;
                                            font-size: 12px;
                                            font-weight: 700;
                                            letter-spacing: 1.4px;
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: Palette.n200;
                                background: Palette.n50;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Text {
                                        text: "ВЕС НЕТТО";
                                        color: Palette.n500;
                                        font-size: 12px;
                                        font-weight: 700;
                                        letter-spacing: 1.5px;
                                        horizontal-alignment: center;
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 5px;
                                        Text {
                                            text: root.net-weight;
                                            color: Palette.n700;
                                            font-family: "Consolas";
                                            font-size: root.narrow ? 44px : 58px;
                                            font-weight: 300;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "кг";
                                            color: Palette.n500;
                                            font-size: 24px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }
                }

                Rectangle {
                    width: root.right-panel-width;
                    background: transparent;

                    VerticalLayout {
                        width: root.right-panel-width;
                        height: parent.height;
                        spacing: 16px;

                            MainButton {
                                text: "ПЕЧАТЬ ЭТИКЕТКИ";
                                icon: @image-url("../assets/icons/printer-white.png");
                                clicked => { root.print-label(); }
                            }

                            HorizontalLayout {
                                width: root.right-panel-width;
                                spacing: 16px;
                                TileButton {
                                    width: (root.right-panel-width - 16px) / 2;
                                    text: "ПОВТОР";
                                    icon: @image-url("../assets/icons/refresh-cw.png");
                                    short: root.short;
                                    clicked => { root.repeat-print(); }
                                }
                                TileButton {
                                    horizontal-stretch: 1;
                                    text: "КОРОБ";
                                    icon: @image-url("../assets/icons/box.png");
                                    short: root.short;
                                    enabled: root.units-in-box > 0;
                                    clicked => { root.close-box(); }
                                }
                            }

                            HorizontalLayout {
                                width: root.right-panel-width;
                                spacing: 16px;
                                TileButton {
                                    width: (root.right-panel-width - 16px) / 2;
                                    text: "УДАЛИТЬ";
                                    icon: @image-url("../assets/icons/trash2-red.png");
                                    short: root.short;
                                    normal-color: Palette.r50;
                                    hover-color: Palette.r100;
                                    pressed-color: #fecaca;
                                    outline: Palette.r300;
                                    foreground: Palette.r600;
                                    clicked => { root.delete-modal-visible = true; }
                                }
                                Rectangle { width: (root.right-panel-width - 16px) / 2; background: transparent; }
                            }

                            MainButton {
                                height: 52px;
                                border-radius: 16px;
                                text: "ПАЛЛЕТНЫЙ ЛИСТ";
                                icon: @image-url("../assets/icons/layers-white.png");
                                normal-color: Palette.a600;
                                hover-color: Palette.a500;
                                pressed-color: Palette.a700;
                                clicked => { root.print-pallet(); }
                            }

                            Rectangle {
                                min-height: root.short ? 282px : 338px;
                                vertical-stretch: 1;
                                border-radius: 24px;
                                border-width: 1px;
                                border-color: Palette.n200;
                                background: white;
                                drop-shadow-color: #0000000d;
                                drop-shadow-blur: 5px;
                                drop-shadow-offset-y: 1px;

                                VerticalLayout {
                                    padding: root.short ? 12px : 16px;
                                    spacing: root.short ? 2px : 3px;
                                    Text {
                                        text: "СТАТИСТИКА СЕССИИ";
                                        color: Palette.n500;
                                        font-size: 14px;
                                        font-weight: 600;
                                        letter-spacing: 1.4px;
                                    }
                                    StatEditorRow {
                                        compact: root.short;
                                        label: "ПАРТИЯ";
                                        value: root.batch-number;
                                        icon: @image-url("../assets/icons/hash-green.png");
                                        clicked => { root.keypad-visible = true; }
                                    }
                                    StatEditorRow {
                                        compact: root.short;
                                        label: "ДАТА";
                                        value: root.labeling-date;
                                        icon: @image-url("../assets/icons/calendar-green.png");
                                        clicked => { root.date-modal-visible = true; }
                                    }
                                    ThinStatRow {
                                        compact: root.short;
                                        label: "Упаковка №";
                                        value: root.pack-number;
                                        value-color: Palette.e600;
                                    }
                                    ThinStatRow {
                                        compact: root.short;
                                        label: "Короб №";
                                        value: root.box-number;
                                        value-color: Palette.e600;
                                    }
                                    VerticalLayout {
                                        height: root.short ? 34px : 42px;
                                        spacing: root.short ? 3px : 5px;
                                        HorizontalLayout {
                                            Text {
                                                text: "В коробе";
                                                color: Palette.n500;
                                                font-size: 14px;
                                            }
                                            Text {
                                                text: root.box-limit > 0 ? root.units-in-box + " / " + root.box-limit : root.units-in-box + " / —";
                                                color: Palette.n900;
                                                font-family: "Consolas";
                                                font-size: 14px;
                                                horizontal-alignment: right;
                                            }
                                        }
                                        Rectangle {
                                            height: 8px;
                                            border-radius: 4px;
                                            background: Palette.n200;
                                            Rectangle {
                                                width: root.box-limit > 0 ? parent.width * root.units-in-box / root.box-limit : 0px;
                                                height: parent.height;
                                                border-radius: 4px;
                                                background: Palette.e500;
                                            }
                                        }
                                    }
                                    ThinStatRow {
                                        compact: root.short;
                                        label: "Коробов на паллете";
                                        value: root.boxes-on-pallet;
                                        value-color: Palette.a600;
                                    }
                                    ThinStatRow {
                                        compact: root.short;
                                        label: "Всего упаковок";
                                        value: root.total-units;
                                    }
                                    Text {
                                        text: "ПОСЛЕДНЯЯ ПЕЧАТЬ    " + root.last-print;
                                        color: Palette.a600;
                                        font-size: 11px;
                                        horizontal-alignment: right;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                }
            }
        }
    }

    if root.active-page == 1: Rectangle {
        x: (parent.width - root.shell-width) / 2 + root.sidebar-width;
        width: root.work-area-width;
        height: parent.height;
        background: Palette.n50;

        VerticalLayout {
            padding: root.content-padding;
            spacing: root.narrow ? 12px : 16px;

            HorizontalLayout {
                height: 54px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: "Очередь печати"; color: Palette.n900; font-size: 26px; font-weight: 750; }
                    Text { text: root.queue-status; color: Palette.n500; font-size: 13px; overflow: elide; }
                }
                Rectangle { horizontal-stretch: 1; }
                CompactActionButton {
                    width: root.narrow ? 148px : 180px;
                    text: root.queue-busy ? "ОБНОВЛЕНИЕ…" : "ОБНОВИТЬ";
                    primary: true;
                    enabled: !root.queue-busy;
                    clicked => { root.refresh-print-queue(); }
                }
            }

            HorizontalLayout {
                height: 78px;
                spacing: root.narrow ? 8px : 12px;
                QueueSummaryCard { label: "В РАБОТЕ"; value: root.queue-waiting; accent: Palette.a500; }
                QueueSummaryCard { label: "ПРИНЯТО"; value: root.queue-accepted; accent: Palette.e500; }
                QueueSummaryCard { label: "ТРЕБУЕТ РЕШЕНИЯ"; value: root.queue-problems; accent: Palette.r500; }
                QueueSummaryCard { label: "ВСЕГО"; value: root.queue-total; accent: Palette.n500; }
            }

            Rectangle {
                vertical-stretch: 1;
                border-radius: 20px;
                border-width: 1px;
                border-color: Palette.n200;
                background: white;
                clip: true;

                VerticalLayout {
                    padding: root.narrow ? 12px : 16px;
                    spacing: 10px;
                    HorizontalLayout {
                        height: 26px;
                        Text { text: "ПОСЛЕДНИЕ ЗАДАНИЯ"; color: Palette.n500; font-size: 12px; font-weight: 700; letter-spacing: 1px; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.durable-jobs.length + " записей"; color: Palette.n400; font-size: 12px; }
                    }
                    if root.durable-jobs.length == 0: Rectangle {
                        vertical-stretch: 1;
                        border-radius: 18px;
                        background: Palette.n50;
                        VerticalLayout {
                            alignment: center;
                            spacing: 12px;
                            VerticalIcon { icon-size: 46px; icon: @image-url("../assets/icons/list-restart.png"); icon-color: Palette.n400; }
                            Text { text: root.queue-busy ? "Загрузка очереди…" : "Очередь пуста"; color: Palette.n700; font-size: 19px; font-weight: 650; horizontal-alignment: center; }
                            Text { text: "Новые задания появятся здесь автоматически"; color: Palette.n500; font-size: 14px; horizontal-alignment: center; }
                        }
                    }
                    if root.durable-jobs.length > 0: ScrollView {
                        vertical-stretch: 1;
                        viewport-width: self.width;
                        VerticalLayout {
                            spacing: 9px;
                            for job in root.durable-jobs: Rectangle {
                                height: root.narrow ? 118px : 108px;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: job.warning ? Palette.a300 : job.good ? Palette.e200 : job.state == "failed" ? Palette.r300 : Palette.n200;
                                background: job.warning ? Palette.a50 : job.good ? Palette.e50 : job.state == "failed" ? Palette.r50 : Palette.n50;
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 12px;
                                    spacing: 14px;
                                    StatusDot {
                                        dot-size: 12px;
                                        dot-color: job.warning ? Palette.a500 : job.good ? Palette.e500 : job.state == "failed" ? Palette.r500 : Palette.n400;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            spacing: 9px;
                                            Text { text: job.printer-name; color: Palette.n900; font-size: 16px; font-weight: 700; overflow: elide; }
                                            Rectangle {
                                                width: 116px;
                                                height: 28px;
                                                border-radius: 14px;
                                                background: job.warning ? #f59e0b22 : job.good ? #10b98122 : job.state == "failed" ? #ef444422 : Palette.n200;
                                                Text { text: job.state-label; color: job.warning ? Palette.a700 : job.good ? Palette.e700 : job.state == "failed" ? Palette.r700 : Palette.n600; font-size: 11px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                            }
                                        }
                                        Text { text: job.action + " · " + job.route + " · " + job.payload; color: Palette.n600; font-size: 13px; overflow: elide; }
                                        Text { text: "#" + job.short-id + " · попытка " + job.attempts + " · " + job.updated; color: Palette.n400; font-family: "Consolas"; font-size: 11px; overflow: elide; }
                                        if job.error != "": Text { text: job.error; color: job.warning ? Palette.a700 : Palette.r600; font-size: 11px; overflow: elide; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    HorizontalLayout {
                                        width: root.narrow ? 230px : 252px;
                                        alignment: end;
                                        spacing: 8px;
                                        if job.can-retry: CompactActionButton {
                                            text: "ПОВТОРИТЬ";
                                            primary: !job.uncertain;
                                            clicked => {
                                                root.confirm-print-action = "retry";
                                                root.confirm-print-job-id = job.job-id;
                                                root.confirm-print-job-title = job.short-id;
                                                root.confirm-print-uncertain = job.uncertain;
                                                root.confirm-print-action-visible = true;
                                            }
                                        }
                                        if job.can-cancel: CompactActionButton {
                                            text: "ОТМЕНИТЬ";
                                            danger: true;
                                            clicked => {
                                                root.confirm-print-action = "cancel";
                                                root.confirm-print-job-id = job.job-id;
                                                root.confirm-print-job-title = job.short-id;
                                                root.confirm-print-uncertain = false;
                                                root.confirm-print-action-visible = true;
                                            }
                                        }
                                        if !job.can-retry && !job.can-cancel: Text {
                                            width: 116px;
                                            text: "ЗАВЕРШЕНО";
                                            color: Palette.n400;
                                            font-size: 11px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.active-page == 2: Rectangle {
        x: (parent.width - root.shell-width) / 2 + root.sidebar-width;
        width: root.work-area-width;
        height: parent.height;
        background: Palette.n50;

        VerticalLayout {
            padding: root.content-padding;
            spacing: root.narrow ? 12px : 16px;
            HorizontalLayout {
                height: 62px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    Text { text: "Диагностика принтеров"; color: Palette.n900; font-size: 26px; font-weight: 750; }
                    Text { text: root.diagnostics-status; color: Palette.n500; font-size: 13px; overflow: elide; }
                }
                Rectangle { horizontal-stretch: 1; }
                CompactActionButton {
                    width: root.narrow ? 168px : 210px;
                    text: root.diagnostics-busy ? "ПРОВЕРКА…" : "ПРОВЕРИТЬ ВСЕ";
                    primary: true;
                    enabled: !root.diagnostics-busy;
                    clicked => { root.probe-printers(); }
                }
            }

            Rectangle {
                height: 64px;
                border-radius: 16px;
                border-width: 1px;
                border-color: Palette.e200;
                background: Palette.e50;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 12px;
                    HorizontalIcon { icon-size: 26px; icon: @image-url("../assets/icons/stethoscope.png"); icon-color: Palette.e600; }
                    Text { text: "Проверка выполняется напрямую через TCP, Serial или очередь Windows. Рабочий экран остаётся отзывчивым."; color: Palette.e700; font-size: 13px; wrap: word-wrap; vertical-alignment: center; }
                }
            }

            ScrollView {
                vertical-stretch: 1;
                viewport-width: self.width;
                VerticalLayout {
                    spacing: 12px;
                    if root.printer-diagnostics.length == 0: Rectangle {
                        height: 260px;
                        border-radius: 22px;
                        border-width: 1px;
                        border-color: Palette.n200;
                        background: white;
                        VerticalLayout {
                            alignment: center;
                            spacing: 12px;
                            VerticalIcon { icon-size: 50px; icon: @image-url("../assets/icons/printer.png"); icon-color: Palette.n400; }
                            Text { text: root.diagnostics-busy ? "Опрашиваем оборудование…" : "Нажмите «Проверить все»"; color: Palette.n700; font-size: 19px; font-weight: 650; horizontal-alignment: center; }
                        }
                    }
                    for device in root.printer-diagnostics: Rectangle {
                        height: root.narrow ? 138px : 128px;
                        border-radius: 20px;
                        border-width: 1px;
                        border-color: !device.configured ? Palette.n300 : device.reachable ? Palette.e300 : Palette.r300;
                        background: !device.configured ? Palette.n100 : device.reachable ? Palette.e50 : Palette.r50;
                        HorizontalLayout {
                            padding: 18px;
                            spacing: 16px;
                            Rectangle {
                                width: 58px;
                                vertical-stretch: 1;
                                Rectangle {
                                    width: 58px;
                                    height: 58px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 18px;
                                    background: !device.configured ? Palette.n200 : device.reachable ? Palette.e100 : Palette.r100;
                                    AppIcon { width: 30px; height: 30px; x: 14px; y: 14px; icon: @image-url("../assets/icons/printer.png"); icon-color: !device.configured ? Palette.n500 : device.reachable ? Palette.e600 : Palette.r600; }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                Text { text: device.role-label; color: Palette.n500; font-size: 11px; font-weight: 750; letter-spacing: 0.8px; }
                                Text { text: device.printer-name; color: Palette.n900; font-size: 17px; font-weight: 700; overflow: elide; }
                                Text { text: device.transport + " · " + device.endpoint; color: Palette.n500; font-family: "Consolas"; font-size: 12px; overflow: elide; }
                                Text { text: device.details; color: device.reachable ? Palette.e700 : device.configured ? Palette.r700 : Palette.n500; font-size: 12px; overflow: elide; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout {
                                width: 170px;
                                alignment: center;
                                spacing: 6px;
                                Rectangle {
                                    height: 38px;
                                    border-radius: 19px;
                                    background: !device.configured ? Palette.n200 : device.reachable ? #10b98122 : #ef444422;
                                    Text { text: device.status-label; color: !device.configured ? Palette.n600 : device.reachable ? Palette.e700 : Palette.r700; font-size: 12px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                }
                                Text { text: device.queried; color: Palette.n400; font-size: 11px; horizontal-alignment: center; }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.active-page == 3: Rectangle {
        x: (parent.width - root.shell-width) / 2 + root.sidebar-width;
        width: root.work-area-width;
        height: parent.height;
        background: Palette.n50;

        VerticalLayout {
            padding: root.content-padding;
            spacing: root.narrow ? 10px : 14px;
            HorizontalLayout {
                height: 56px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: "Настройки принтеров"; color: Palette.n900; font-size: 25px; font-weight: 750; }
                    Text { text: root.settings-status; color: root.settings-dirty ? Palette.a700 : Palette.n500; font-size: 12px; overflow: elide; }
                }
                Rectangle { horizontal-stretch: 1; }
                SettingsChoiceButton { width: 118px; height: 44px; text: "ПРИНТЕРЫ"; selected: true; enabled: !root.settings-busy; clicked => { root.active-page = 3; } }
                SettingsChoiceButton { width: 104px; height: 44px; text: "ВЕСЫ"; selected: false; enabled: !root.settings-busy; clicked => { root.active-page = 4; root.reload-scale-settings(); } }
                if root.settings-dirty: Rectangle {
                    width: 154px;
                    height: 34px;
                    border-radius: 17px;
                    background: Palette.a50;
                    border-width: 1px;
                    border-color: Palette.a300;
                    Text { text: "ЕСТЬ ИЗМЕНЕНИЯ"; color: Palette.a700; font-size: 11px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; }
                }
                CompactActionButton {
                    width: 138px;
                    text: "ОБНОВИТЬ";
                    enabled: !root.settings-busy;
                    clicked => { root.reload-printer-settings(); }
                }
            }

            HorizontalLayout {
                height: root.short ? 86px : 98px;
                spacing: 10px;
                for role in root.printer-settings-roles: Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 18px;
                    border-width: role.role == root.settings-selected-role ? 2px : 1px;
                    border-color: role.role == root.settings-selected-role ? Palette.e500 : Palette.n300;
                    background: role.role == root.settings-selected-role ? Palette.e50 : role-touch.has-hover ? Palette.n100 : white;
                    HorizontalLayout {
                        padding: 13px;
                        spacing: 11px;
                        Rectangle {
                            width: 44px;
                            vertical-stretch: 1;
                            Rectangle {
                                width: 44px;
                                height: 44px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 13px;
                                background: role.active ? Palette.e100 : Palette.n200;
                                AppIcon { width: 22px; height: 22px; x: 11px; y: 11px; icon: @image-url("../assets/icons/printer.png"); icon-color: role.active ? Palette.e600 : Palette.n500; }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            Text { text: role.role-label; color: Palette.n900; font-size: 14px; font-weight: 700; overflow: elide; }
                            Text { text: role.connection + " · " + role.protocol + " · " + role.dpi; color: Palette.n500; font-size: 11px; overflow: elide; }
                            Text { text: role.endpoint; color: role.active ? Palette.e700 : Palette.n400; font-family: "Consolas"; font-size: 10px; overflow: elide; }
                        }
                    }
                    role-touch := TouchArea { enabled: !root.settings-busy; clicked => { root.select-printer-role(role.role); } }
                }
            }

            Rectangle {
                height: 42px;
                border-radius: 13px;
                border-width: 1px;
                border-color: Palette.n200;
                background: white;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 10px;
                    Text { text: root.settings-selected-role-label; color: Palette.n900; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                    Text { text: root.settings-selected-description; color: Palette.n500; font-size: 12px; vertical-alignment: center; overflow: elide; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.settings-preview-profile; color: Palette.e700; font-family: "Consolas"; font-size: 11px; font-weight: 650; vertical-alignment: center; }
                }
            }

            ScrollView {
                vertical-stretch: 1;
                viewport-width: self.width;
                VerticalLayout {
                    spacing: 12px;
                    Rectangle {
                        height: 128px;
                        border-radius: 18px;
                        border-width: 1px;
                        border-color: Palette.n200;
                        background: white;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            HorizontalLayout {
                                height: 22px;
                                Text { text: "ОСНОВНОЕ"; color: Palette.n500; font-size: 11px; font-weight: 750; letter-spacing: 0.8px; }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: root.settings-active ? "ПРИНТЕР АКТИВЕН" : "ПРИНТЕР ОТКЛЮЧЕН"; color: root.settings-active ? Palette.e700 : Palette.n500; font-size: 11px; font-weight: 750; }
                            }
                            HorizontalLayout {
                                height: 52px;
                                spacing: 8px;
                                LineEdit {
                                    horizontal-stretch: 1;
                                    text <=> root.settings-name;
                                    placeholder-text: "Название принтера";
                                    enabled: !root.settings-busy;
                                    edited => { root.settings-dirty = true; }
                                }
                                SettingsChoiceButton { width: 142px; text: "ВКЛЮЧЕН"; selected: root.settings-active; enabled: !root.settings-busy; clicked => { root.settings-active = true; root.settings-dirty = true; } }
                                SettingsChoiceButton { width: 142px; text: "ОТКЛЮЧЕН"; selected: !root.settings-active; enabled: !root.settings-busy; clicked => { root.settings-active = false; root.settings-dirty = true; } }
                                SettingsChoiceButton { width: 158px; text: root.settings-auto-print ? "АВТОПЕЧАТЬ: ДА" : "АВТОПЕЧАТЬ: НЕТ"; selected: root.settings-auto-print; enabled: !root.settings-busy; clicked => { root.settings-auto-print = !root.settings-auto-print; root.settings-dirty = true; } }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: root.settings-connection == "windows_driver" || root.settings-connection == "serial" ? 312px : 220px;
                            border-radius: 18px;
                            border-width: 1px;
                            border-color: Palette.n200;
                            background: white;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 9px;
                                Text { text: "ПОДКЛЮЧЕНИЕ"; color: Palette.n500; font-size: 11px; font-weight: 750; letter-spacing: 0.8px; }
                                HorizontalLayout {
                                    height: 52px;
                                    spacing: 7px;
                                    SettingsChoiceButton { horizontal-stretch: 1; text: "DRIVER"; selected: root.settings-connection == "windows_driver"; enabled: !root.settings-busy; clicked => { root.settings-connection = "windows_driver"; root.settings-dirty = true; } }
                                    SettingsChoiceButton { horizontal-stretch: 1; text: "ETHERNET"; selected: root.settings-connection == "tcp"; enabled: !root.settings-busy; clicked => { root.settings-connection = "tcp"; root.settings-dirty = true; } }
                                    SettingsChoiceButton { horizontal-stretch: 1; text: "SERIAL"; selected: root.settings-connection == "serial"; enabled: !root.settings-busy; clicked => { root.settings-connection = "serial"; root.settings-dirty = true; } }
                                }
                                if root.settings-connection == "tcp": HorizontalLayout {
                                    height: 52px;
                                    spacing: 8px;
                                    LineEdit { horizontal-stretch: 1; text <=> root.settings-ip; placeholder-text: "IP или имя узла"; enabled: !root.settings-busy; edited => { root.settings-dirty = true; } }
                                    LineEdit { width: 132px; text <=> root.settings-port; placeholder-text: "Порт"; enabled: !root.settings-busy; edited => { root.settings-dirty = true; } }
                                }
                                if root.settings-connection == "tcp": SettingsChoiceButton {
                                    height: 48px;
                                    text: root.settings-persistent-connection ? "СОЕДИНЕНИЕ: ДЕРЖАТЬ ОТКРЫТЫМ" : "СОЕДИНЕНИЕ: ЗАКРЫВАТЬ";
                                    selected: root.settings-persistent-connection;
                                    enabled: !root.settings-busy;
                                    clicked => { root.settings-persistent-connection = !root.settings-persistent-connection; root.settings-dirty = true; }
                                }
                                if root.settings-connection == "windows_driver": LineEdit {
                                    height: 48px;
                                    text <=> root.settings-driver-name;
                                    placeholder-text: "Имя очереди Windows (пусто = по умолчанию)";
                                    enabled: !root.settings-busy;
                                    edited => { root.settings-dirty = true; }
                                }
                                if root.settings-connection == "windows_driver": ScrollView {
                                    height: 100px;
                                    viewport-width: self.width;
                                    VerticalLayout {
                                        spacing: 5px;
                                        if root.settings-system-printers.length == 0: Text { height: 44px; text: "Очереди Windows не найдены"; color: Palette.n500; font-size: 12px; vertical-alignment: center; horizontal-alignment: center; }
                                        for choice in root.settings-system-printers: Rectangle {
                                            height: 44px;
                                            border-radius: 11px;
                                            border-width: 1px;
                                            border-color: choice.value == root.settings-driver-name ? Palette.e400 : Palette.n200;
                                            background: choice.value == root.settings-driver-name ? Palette.e50 : Palette.n50;
                                            HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 8px; Text { text: choice.label; color: Palette.n800; font-size: 12px; font-weight: 650; overflow: elide; } Text { text: choice.details; color: Palette.n400; font-size: 10px; horizontal-alignment: right; overflow: elide; } }
                                            TouchArea { enabled: !root.settings-busy; clicked => { root.settings-driver-name = choice.value; root.settings-dirty = true; } }
                                        }
                                    }
                                }
                                if root.settings-connection == "serial": HorizontalLayout {
                                    height: 48px;
                                    spacing: 8px;
                                    LineEdit { horizontal-stretch: 1; text <=> root.settings-serial-port; placeholder-text: "COM-порт"; enabled: !root.settings-busy; edited => { root.settings-dirty = true; } }
                                    LineEdit { width: 142px; text <=> root.settings-baud-rate; placeholder-text: "Baud"; enabled: !root.settings-busy; edited => { root.settings-dirty = true; } }
                                }
                                if root.settings-connection == "serial": ScrollView {
                                    height: 100px;
                                    viewport-width: self.width;
                                    VerticalLayout {
                                        spacing: 5px;
                                        if root.settings-serial-ports.length == 0: Text { height: 44px; text: "Serial-порты не найдены"; color: Palette.n500; font-size: 12px; vertical-alignment: center; horizontal-alignment: center; }
                                        for choice in root.settings-serial-ports: Rectangle {
                                            height: 44px;
                                            border-radius: 11px;
                                            border-width: 1px;
                                            border-color: choice.value == root.settings-serial-port ? Palette.e400 : Palette.n200;
                                            background: choice.value == root.settings-serial-port ? Palette.e50 : Palette.n50;
                                            HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 8px; Text { text: choice.label; color: Palette.n800; font-size: 12px; font-weight: 650; } Text { text: choice.details; color: Palette.n400; font-size: 10px; horizontal-alignment: right; overflow: elide; } }
                                            TouchArea { enabled: !root.settings-busy; clicked => { root.settings-serial-port = choice.value; root.settings-dirty = true; } }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 312px;
                            border-radius: 18px;
                            border-width: 1px;
                            border-color: Palette.n200;
                            background: white;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                Text { text: "ЯЗЫК И ПРОФИЛЬ"; color: Palette.n500; font-size: 11px; font-weight: 750; letter-spacing: 0.8px; }
                                HorizontalLayout {
                                    height: 52px; spacing: 6px;
                                    SettingsChoiceButton { horizontal-stretch: 1; text: "ZPL"; selected: root.settings-protocol == "zpl"; enabled: !root.settings-busy; clicked => { root.settings-protocol = "zpl"; root.settings-dirty = true; } }
                                    SettingsChoiceButton { horizontal-stretch: 1; text: "TSPL"; selected: root.settings-protocol == "tspl"; enabled: !root.settings-busy; clicked => { root.settings-protocol = "tspl"; root.settings-dirty = true; } }
                                    SettingsChoiceButton { horizontal-stretch: 1; text: "EPL"; selected: root.settings-protocol == "epl"; enabled: !root.settings-busy; clicked => { root.settings-protocol = "epl"; root.settings-dirty = true; } }
                                    SettingsChoiceButton { horizontal-stretch: 1; text: "CPCL"; selected: root.settings-protocol == "cpcl"; enabled: !root.settings-busy; clicked => { root.settings-protocol = "cpcl"; root.settings-dirty = true; } }
                                }
                                HorizontalLayout {
                                    height: 52px; spacing: 6px;
                                    SettingsChoiceButton { horizontal-stretch: 1; text: "DPL"; selected: root.settings-protocol == "dpl"; enabled: !root.settings-busy; clicked => { root.settings-protocol = "dpl"; root.settings-dirty = true; } }
                                    SettingsChoiceButton { horizontal-stretch: 1; text: "SBPL"; selected: root.settings-protocol == "sbpl"; enabled: !root.settings-busy; clicked => { root.settings-protocol = "sbpl"; root.settings-dirty = true; } }
                                    SettingsChoiceButton { horizontal-stretch: 1; text: "ZPL BITMAP"; selected: root.settings-protocol == "image"; enabled: !root.settings-busy; clicked => { root.settings-protocol = "image"; root.settings-dirty = true; } }
                                    SettingsChoiceButton { horizontal-stretch: 1; text: "WINDOWS"; selected: root.settings-protocol == "browser"; enabled: !root.settings-busy; clicked => { root.settings-protocol = "browser"; root.settings-dirty = true; } }
                                }
                                Text { text: "ПРОФИЛЬ СОВМЕСТИМОСТИ"; color: Palette.n500; font-size: 10px; font-weight: 700; }
                                HorizontalLayout {
                                    height: 52px; spacing: 6px;
                                    SettingsChoiceButton { horizontal-stretch: 1; text: "АВТО"; selected: root.settings-compatibility == "auto"; enabled: !root.settings-busy; clicked => { root.settings-compatibility = "auto"; root.settings-dirty = true; } }
                                    SettingsChoiceButton { horizontal-stretch: 1; text: "СОВМЕСТИМЫЙ"; selected: root.settings-compatibility == "compatible"; enabled: !root.settings-busy; clicked => { root.settings-compatibility = "compatible"; root.settings-dirty = true; } }
                                    SettingsChoiceButton { horizontal-stretch: 1; text: "РАСШИРЕННЫЙ"; selected: root.settings-compatibility == "advanced"; enabled: !root.settings-busy; clicked => { root.settings-compatibility = "advanced"; root.settings-dirty = true; } }
                                }
                                Text { text: "Эффективно: " + root.settings-preview-profile; color: Palette.e700; font-family: "Consolas"; font-size: 11px; horizontal-alignment: right; overflow: elide; }
                            }
                        }
                    }

                    Rectangle {
                        height: root.settings-advanced-visible ? 254px : 124px;
                        border-radius: 18px;
                        border-width: 1px;
                        border-color: Palette.n200;
                        background: white;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            HorizontalLayout {
                                height: 22px;
                                Text { text: "КАЧЕСТВО И ГРАФИКА"; color: Palette.n500; font-size: 11px; font-weight: 750; letter-spacing: 0.8px; }
                                Rectangle { horizontal-stretch: 1; }
                                CompactActionButton { width: 190px; height: 40px; text: root.settings-advanced-visible ? "СКРЫТЬ ДОПОЛНИТЕЛЬНЫЕ" : "ПОКАЗАТЬ ДОПОЛНИТЕЛЬНЫЕ"; enabled: !root.settings-busy; clicked => { root.settings-advanced-visible = !root.settings-advanced-visible; } }
                            }
                            HorizontalLayout {
                                height: 52px; spacing: 7px;
                                SettingsChoiceButton { horizontal-stretch: 1; text: "203 DPI"; selected: root.settings-dpi == "203"; enabled: !root.settings-busy; clicked => { root.settings-dpi = "203"; root.settings-dirty = true; } }
                                SettingsChoiceButton { horizontal-stretch: 1; text: "300 DPI"; selected: root.settings-dpi == "300"; enabled: !root.settings-busy; clicked => { root.settings-dpi = "300"; root.settings-dirty = true; } }
                                SettingsChoiceButton { horizontal-stretch: 1; text: "600 DPI"; selected: root.settings-dpi == "600"; enabled: !root.settings-busy; clicked => { root.settings-dpi = "600"; root.settings-dirty = true; } }
                                SettingsChoiceButton { horizontal-stretch: 1; text: "RAM: АВТО"; selected: root.settings-ram-cache == "auto"; enabled: !root.settings-busy; clicked => { root.settings-ram-cache = "auto"; root.settings-dirty = true; } }
                                SettingsChoiceButton { horizontal-stretch: 1; text: "RAM: ВКЛ"; selected: root.settings-ram-cache == "on"; enabled: !root.settings-busy; clicked => { root.settings-ram-cache = "on"; root.settings-dirty = true; } }
                                SettingsChoiceButton { horizontal-stretch: 1; text: "RAM: ВЫКЛ"; selected: root.settings-ram-cache == "off"; enabled: !root.settings-busy; clicked => { root.settings-ram-cache = "off"; root.settings-dirty = true; } }
                                SettingsChoiceButton { width: 134px; text: root.settings-z64 ? "Z64: ВКЛ" : "RLE"; selected: root.settings-z64; enabled: !root.settings-busy; clicked => { root.settings-z64 = !root.settings-z64; root.settings-dirty = true; } }
                            }
                            if root.settings-advanced-visible: HorizontalLayout {
                                height: 52px; spacing: 8px;
                                LineEdit { horizontal-stretch: 1; text <=> root.settings-darkness; placeholder-text: "Темнота 0–30"; enabled: !root.settings-busy; edited => { root.settings-dirty = true; } }
                                LineEdit { horizontal-stretch: 1; text <=> root.settings-print-speed; placeholder-text: "Скорость 1–14"; enabled: !root.settings-busy; edited => { root.settings-dirty = true; } }
                                LineEdit { horizontal-stretch: 1; text <=> root.settings-gap-mm; placeholder-text: "Зазор, мм"; enabled: !root.settings-busy; edited => { root.settings-dirty = true; } }
                                LineEdit { horizontal-stretch: 1; text <=> root.settings-width-mm; placeholder-text: "Ширина, мм"; enabled: !root.settings-busy; edited => { root.settings-dirty = true; } }
                                LineEdit { horizontal-stretch: 1; text <=> root.settings-height-mm; placeholder-text: "Высота, мм"; enabled: !root.settings-busy; edited => { root.settings-dirty = true; } }
                            }
                            if root.settings-advanced-visible: Rectangle {
                                height: 48px;
                                border-radius: 12px;
                                background: Palette.a50;
                                border-width: 1px;
                                border-color: Palette.a300;
                                Text { text: "Расширенные параметры сохраняются только для выбранной роли. Остальные поля JSON и профили производителя остаются без изменений."; color: Palette.a700; font-size: 11px; wrap: word-wrap; vertical-alignment: center; horizontal-alignment: center; }
                            }
                        }
                    }
                    if root.settings-detection != "": Rectangle {
                        height: 54px;
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: Palette.e300;
                        background: Palette.e50;
                        Text { text: root.settings-detection; color: Palette.e700; font-size: 12px; wrap: word-wrap; vertical-alignment: center; horizontal-alignment: center; }
                    }
                }
            }

            HorizontalLayout {
                height: 56px;
                spacing: 9px;
                Text { horizontal-stretch: 1; text: root.settings-busy ? "Операция выполняется в фоне…" : "Изменения применяются только после сохранения"; color: Palette.n500; font-size: 12px; vertical-alignment: center; overflow: elide; }
                CompactActionButton { width: 150px; text: "ТЕСТ ПЕЧАТИ"; enabled: !root.settings-busy; clicked => { root.test-printer-settings(); } }
                CompactActionButton { width: 190px; text: "ОПРЕДЕЛИТЬ И ПРИМЕНИТЬ"; enabled: !root.settings-busy; clicked => { root.detect-printer-settings(); } }
                CompactActionButton { width: 164px; text: root.settings-busy ? "СОХРАНЕНИЕ…" : "СОХРАНИТЬ"; primary: true; enabled: !root.settings-busy; clicked => { root.save-printer-settings(); } }
            }
        }
    }

    if root.active-page == 4: Rectangle {
        x: (parent.width - root.shell-width) / 2 + root.sidebar-width;
        width: root.work-area-width;
        height: parent.height;
        background: Palette.n50;

        VerticalLayout {
            padding: root.content-padding;
            spacing: root.narrow ? 10px : 14px;
            HorizontalLayout {
                height: 56px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: "Настройки весового оборудования"; color: Palette.n900; font-size: 25px; font-weight: 750; }
                    Text { text: root.scale-settings-status; color: root.scale-settings-dirty ? Palette.a700 : Palette.n500; font-size: 12px; overflow: elide; }
                }
                Rectangle { horizontal-stretch: 1; }
                SettingsChoiceButton { width: 118px; height: 44px; text: "ПРИНТЕРЫ"; selected: false; enabled: !root.scale-settings-busy; clicked => { root.active-page = 3; root.reload-printer-settings(); } }
                SettingsChoiceButton { width: 104px; height: 44px; text: "ВЕСЫ"; selected: true; enabled: !root.scale-settings-busy; clicked => { root.active-page = 4; } }
                if root.scale-settings-dirty: Rectangle {
                    width: 154px;
                    height: 34px;
                    border-radius: 17px;
                    background: Palette.a50;
                    border-width: 1px;
                    border-color: Palette.a300;
                    Text { text: "ЕСТЬ ИЗМЕНЕНИЯ"; color: Palette.a700; font-size: 11px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; }
                }
                CompactActionButton { width: 138px; text: "ОБНОВИТЬ"; enabled: !root.scale-settings-busy; clicked => { root.reload-scale-settings(); } }
            }

            Rectangle {
                height: 76px;
                border-radius: 18px;
                border-width: 1px;
                border-color: root.scale-settings-runtime-status == "connected" ? Palette.e300 : root.scale-settings-runtime-status == "connecting" || root.scale-settings-runtime-status == "reconnecting" ? Palette.a300 : Palette.n300;
                background: root.scale-settings-runtime-status == "connected" ? Palette.e50 : root.scale-settings-runtime-status == "connecting" || root.scale-settings-runtime-status == "reconnecting" ? Palette.a50 : white;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 12px;
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: 14px;
                        background: root.scale-settings-runtime-status == "connected" ? Palette.e100 : Palette.n200;
                        AppIcon { width: 24px; height: 24px; x: 12px; y: 12px; icon: @image-url("../assets/icons/scale-green.png"); }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        Text { text: root.scale-settings-protocol-name; color: Palette.n900; font-size: 15px; font-weight: 750; overflow: elide; }
                        Text { text: root.scale-settings-endpoint + " · " + root.scale-settings-protocol; color: Palette.n500; font-family: "Consolas"; font-size: 11px; overflow: elide; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 154px;
                        height: 34px;
                        border-radius: 17px;
                        background: root.scale-settings-runtime-status == "connected" ? Palette.e100 : Palette.n200;
                        Text { text: root.scale-settings-runtime-status == "connected" ? "ПОДКЛЮЧЕНЫ" : root.scale-settings-runtime-status == "connecting" || root.scale-settings-runtime-status == "reconnecting" ? "ПОДКЛЮЧЕНИЕ" : "ОТКЛЮЧЕНЫ"; color: root.scale-settings-runtime-status == "connected" ? Palette.e700 : Palette.n600; font-size: 11px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 12px;
                Rectangle {
                    width: root.narrow ? 380px : 430px;
                    border-radius: 18px;
                    border-width: 1px;
                    border-color: Palette.n200;
                    background: white;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 9px;
                        Text { text: "ПОДКЛЮЧЕНИЕ"; color: Palette.n500; font-size: 11px; font-weight: 750; letter-spacing: 0.8px; }
                        HorizontalLayout {
                            height: 52px;
                            spacing: 7px;
                            SettingsChoiceButton { horizontal-stretch: 1; text: "SERIAL"; selected: root.scale-settings-connection == "serial"; enabled: !root.scale-settings-busy; clicked => { root.scale-settings-connection = "serial"; if root.scale-settings-protocol == "simulator" { root.scale-settings-protocol = "generic"; root.scale-settings-protocol-name = "Generic Text"; root.scale-settings-protocol-description = "Универсальный текстовый протокол"; } root.scale-settings-dirty = true; } }
                            SettingsChoiceButton { horizontal-stretch: 1; text: "TCP"; selected: root.scale-settings-connection == "tcp"; enabled: !root.scale-settings-busy; clicked => { root.scale-settings-connection = "tcp"; if root.scale-settings-protocol == "simulator" { root.scale-settings-protocol = "generic"; root.scale-settings-protocol-name = "Generic Text"; root.scale-settings-protocol-description = "Универсальный текстовый протокол"; } root.scale-settings-dirty = true; } }
                            SettingsChoiceButton { horizontal-stretch: 1; text: "СИМУЛЯТОР"; selected: root.scale-settings-connection == "simulator"; enabled: !root.scale-settings-busy; clicked => { root.scale-settings-connection = "simulator"; root.scale-settings-protocol = "simulator"; root.scale-settings-protocol-name = "Simulator"; root.scale-settings-protocol-description = "Встроенные виртуальные весы"; root.scale-settings-dirty = true; } }
                        }
                        if root.scale-settings-connection == "tcp": HorizontalLayout {
                            height: 52px;
                            spacing: 8px;
                            LineEdit { horizontal-stretch: 1; text <=> root.scale-settings-host; placeholder-text: "IP или имя весов"; enabled: !root.scale-settings-busy; edited => { root.scale-settings-dirty = true; } }
                            LineEdit { width: 118px; text <=> root.scale-settings-port; placeholder-text: "Порт"; enabled: !root.scale-settings-busy; edited => { root.scale-settings-dirty = true; } }
                        }
                        if root.scale-settings-connection == "serial": HorizontalLayout {
                            height: 52px;
                            spacing: 8px;
                            LineEdit { horizontal-stretch: 1; text <=> root.scale-settings-serial-path; placeholder-text: "COM-порт"; enabled: !root.scale-settings-busy; edited => { root.scale-settings-dirty = true; } }
                            LineEdit { width: 130px; text <=> root.scale-settings-baud-rate; placeholder-text: "Baud"; enabled: !root.scale-settings-busy; edited => { root.scale-settings-dirty = true; } }
                        }
                        if root.scale-settings-connection == "serial": ScrollView {
                            height: 108px;
                            viewport-width: self.width;
                            VerticalLayout {
                                spacing: 5px;
                                if root.scale-settings-serial-ports.length == 0: Text { height: 46px; text: "Serial-порты не найдены"; color: Palette.n500; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                for choice in root.scale-settings-serial-ports: Rectangle {
                                    height: 46px;
                                    border-radius: 11px;
                                    border-width: 1px;
                                    border-color: choice.value == root.scale-settings-serial-path ? Palette.e400 : Palette.n200;
                                    background: choice.value == root.scale-settings-serial-path ? Palette.e50 : Palette.n50;
                                    HorizontalLayout { padding-left: 11px; padding-right: 11px; spacing: 7px; Text { text: choice.label; color: Palette.n800; font-size: 12px; font-weight: 700; } Text { text: choice.details; color: Palette.n400; font-size: 10px; horizontal-alignment: right; overflow: elide; } }
                                    TouchArea { enabled: !root.scale-settings-busy; clicked => { root.scale-settings-serial-path = choice.value; root.scale-settings-dirty = true; } }
                                }
                            }
                        }
                        if root.scale-settings-connection == "simulator": Rectangle {
                            height: 72px;
                            border-radius: 13px;
                            background: Palette.e50;
                            border-width: 1px;
                            border-color: Palette.e300;
                            Text { text: "Без оборудования · для проверки станции и интерфейса."; color: Palette.e700; font-size: 12px; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: "СТАБИЛЬНОСТЬ ПОКАЗАНИЙ"; color: Palette.n500; font-size: 10px; font-weight: 700; }
                        HorizontalLayout {
                            height: 62px;
                            spacing: 7px;
                            SettingsChoiceButton { horizontal-stretch: 1; text: "БЫСТРО\n~450 мс"; selected: root.scale-settings-polling == "150" && root.scale-settings-stability-count == "3"; enabled: !root.scale-settings-busy; clicked => { root.scale-settings-polling = "150"; root.scale-settings-stability-count = "3"; root.scale-settings-dirty = true; } }
                            SettingsChoiceButton { horizontal-stretch: 1; text: "БАЛАНС\n~1 сек"; selected: root.scale-settings-polling == "250" && root.scale-settings-stability-count == "4"; enabled: !root.scale-settings-busy; clicked => { root.scale-settings-polling = "250"; root.scale-settings-stability-count = "4"; root.scale-settings-dirty = true; } }
                            SettingsChoiceButton { horizontal-stretch: 1; text: "ТОЧНО\n~2.5 сек"; selected: root.scale-settings-polling == "500" && root.scale-settings-stability-count == "5"; enabled: !root.scale-settings-busy; clicked => { root.scale-settings-polling = "500"; root.scale-settings-stability-count = "5"; root.scale-settings-dirty = true; } }
                        }
                        HorizontalLayout {
                            height: 52px;
                            spacing: 8px;
                            LineEdit { horizontal-stretch: 1; text <=> root.scale-settings-polling; placeholder-text: "Опрос, мс"; enabled: !root.scale-settings-busy; edited => { root.scale-settings-dirty = true; } }
                            LineEdit { horizontal-stretch: 1; text <=> root.scale-settings-stability-count; placeholder-text: "Отсчётов 2–32"; enabled: !root.scale-settings-busy; edited => { root.scale-settings-dirty = true; } }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 18px;
                    border-width: 1px;
                    border-color: Palette.n200;
                    background: white;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        HorizontalLayout {
                            height: 46px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text { text: "ПРОТОКОЛЫ · " + root.scale-settings-protocols.length; color: Palette.n500; font-size: 11px; font-weight: 750; letter-spacing: 0.8px; }
                                Text { text: root.scale-settings-protocol-description; color: Palette.n600; font-size: 11px; overflow: elide; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Rectangle {
                                width: 108px;
                                height: 32px;
                                border-radius: 16px;
                                background: Palette.e100;
                                Text { text: root.scale-settings-protocol; color: Palette.e700; font-family: "Consolas"; font-size: 10px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                            }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            viewport-width: self.width;
                            VerticalLayout {
                                spacing: 6px;
                                for protocol in root.scale-settings-protocols: Rectangle {
                                    height: 58px;
                                    border-radius: 13px;
                                    border-width: protocol.id == root.scale-settings-protocol ? 2px : 1px;
                                    border-color: protocol.id == root.scale-settings-protocol ? Palette.e500 : Palette.n200;
                                    background: protocol.id == root.scale-settings-protocol ? Palette.e50 : protocol-touch.has-hover ? Palette.n100 : Palette.n50;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: protocol.name; color: Palette.n900; font-size: 12px; font-weight: 700; overflow: elide; }
                                            Text { text: protocol.description; color: Palette.n500; font-size: 10px; overflow: elide; }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { width: 92px; text: protocol.default-baud-rate + " · " + protocol.serial-format; color: Palette.n500; font-family: "Consolas"; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; }
                                    }
                                    protocol-touch := TouchArea { enabled: !root.scale-settings-busy && root.scale-settings-connection != "simulator" && protocol.id != "simulator"; clicked => { root.scale-settings-protocol = protocol.id; root.scale-settings-protocol-name = protocol.name; root.scale-settings-protocol-description = protocol.description; root.scale-settings-baud-rate = protocol.default-baud-rate; root.scale-settings-dirty = true; } }
                                }
                            }
                        }
                    }
                }
            }

            if root.scale-settings-probe != "": Rectangle {
                height: 52px;
                border-radius: 13px;
                border-width: 1px;
                border-color: Palette.e300;
                background: Palette.e50;
                Text { text: root.scale-settings-probe; color: Palette.e700; font-size: 12px; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; }
            }

            HorizontalLayout {
                height: 56px;
                spacing: 9px;
                Text { horizontal-stretch: 1; text: root.scale-settings-busy ? "Проверка оборудования выполняется в фоне…" : "Сохранение перезапускает только поток весов"; color: Palette.n500; font-size: 12px; vertical-alignment: center; overflow: elide; }
                CompactActionButton { width: 172px; text: "ПРОВЕРИТЬ ВЕСЫ"; enabled: !root.scale-settings-busy; clicked => { root.test-scale-settings(); } }
                CompactActionButton { width: 206px; text: root.scale-settings-busy ? "ПРИМЕНЕНИЕ…" : "СОХРАНИТЬ И ПОДКЛЮЧИТЬ"; primary: true; enabled: !root.scale-settings-busy; clicked => { root.save-scale-settings(); } }
            }
        }
    }


    if root.active-page == 5: Rectangle {
        x: (parent.width - root.shell-width) / 2 + root.sidebar-width;
        width: root.work-area-width;
        height: parent.height;
        background: Palette.n50;

        VerticalLayout {
            padding: root.content-padding;
            spacing: root.narrow ? 12px : 16px;

            HorizontalLayout {
                height: 58px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: "Фиксированный вес"; color: Palette.n900; font-size: 26px; font-weight: 750; }
                    Text { text: root.fixed-status; color: root.fixed-control-in-range ? Palette.e700 : Palette.n500; font-size: 12px; overflow: elide; }
                }
                Rectangle { horizontal-stretch: 1; }
                StatusPill { text: root.scale-status; good: root.scale-online; show-icon: true; icon: @image-url("../assets/icons/scale-green.png"); }
                StatusPill { text: root.printer-status; good: root.printer-ready; show-icon: true; icon: @image-url("../assets/icons/printer-green.png"); }
                CompactActionButton { width: 138px; text: "ОБНОВИТЬ"; enabled: !root.fixed-busy; clicked => { root.reload-fixed-weight(); } }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: root.narrow ? 12px : 18px;

                Rectangle {
                    horizontal-stretch: 5;
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: Palette.n200;
                    background: white;

                    VerticalLayout {
                        padding: root.narrow ? 14px : 18px;
                        spacing: root.narrow ? 10px : 14px;

                        Text { text: "ТОВАР И КОНТРОЛЬ ВЕСА"; color: Palette.n500; font-size: 11px; font-weight: 750; letter-spacing: 0.9px; }

                        product-card := Rectangle {
                            height: 82px;
                            border-radius: 16px;
                            border-width: 1px;
                            border-color: fixed-product-touch.has-hover ? Palette.e400 : Palette.n300;
                            background: fixed-product-touch.pressed ? Palette.e100 : fixed-product-touch.has-hover ? Palette.e50 : Palette.n50;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 12px;
                                Rectangle {
                                    width: 50px;
                                    height: 50px;
                                    border-radius: 14px;
                                    background: Palette.e100;
                                    AppIcon { width: 26px; height: 26px; x: 12px; y: 12px; icon: @image-url("../assets/icons/package.png"); }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;
                                    Text { text: root.fixed-product-name; color: Palette.n900; font-size: 16px; font-weight: 750; overflow: elide; }
                                    Text { text: root.fixed-product-article == "" ? "Нажмите, чтобы выбрать товар" : "АРТИКУЛ " + root.fixed-product-article; color: Palette.n500; font-size: 11px; overflow: elide; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                HorizontalIcon { icon-size: 20px; icon: @image-url("../assets/icons/chevron-left.png"); }
                            }
                            fixed-product-touch := TouchArea { enabled: !root.fixed-busy; clicked => { root.fixed-product-modal-visible = true; root.search-fixed-products(""); } }
                        }

                        HorizontalLayout {
                            height: root.short ? 132px : 154px;
                            spacing: 10px;
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 18px;
                                border-width: 2px;
                                border-color: root.fixed-control-in-range ? Palette.e400 : root.stable ? Palette.a300 : Palette.n300;
                                background: root.fixed-control-in-range ? Palette.e50 : root.stable ? Palette.a50 : Palette.n50;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: "КОНТРОЛЬНЫЙ ВЕС"; color: Palette.n500; font-size: 11px; font-weight: 750; letter-spacing: 0.8px; horizontal-alignment: center; }
                                    Text { text: root.gross-weight; color: root.fixed-control-in-range ? Palette.e700 : Palette.n900; font-family: "Consolas"; font-size: root.short ? 38px : 48px; font-weight: 800; horizontal-alignment: center; }
                                    Text { text: "кг · " + (root.stable ? root.fixed-control-in-range ? "В ДОПУСКЕ" : "ВНЕ ДОПУСКА" : "ОЖИДАНИЕ СТАБИЛЬНОГО ВЕСА"); color: root.fixed-control-in-range ? Palette.e700 : root.stable ? Palette.a700 : Palette.n500; font-size: 11px; font-weight: 750; horizontal-alignment: center; }
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 18px;
                                border-width: 1px;
                                border-color: Palette.e300;
                                background: Palette.e50;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: "ВЕС НА ЭТИКЕТКЕ"; color: Palette.e700; font-size: 11px; font-weight: 750; letter-spacing: 0.8px; horizontal-alignment: center; }
                                    Text { text: root.fixed-nominal-weight; color: Palette.e700; font-family: "Consolas"; font-size: root.short ? 38px : 48px; font-weight: 800; horizontal-alignment: center; }
                                    Text { text: "кг · ДОПУСК " + root.fixed-min-weight + "–" + root.fixed-max-weight + " г"; color: Palette.e700; font-size: 11px; font-weight: 650; horizontal-alignment: center; }
                                }
                            }
                        }

                        HorizontalLayout {
                            height: 54px;
                            spacing: 9px;
                            SettingsChoiceButton { horizontal-stretch: 1; text: "КОНТРОЛЬ + 1 ЭТИКЕТКА"; selected: root.fixed-mode == "verify"; enabled: !root.fixed-busy; clicked => { root.fixed-mode = "verify"; } }
                            SettingsChoiceButton { horizontal-stretch: 1; text: "ПАРТИЯ ПО КОЛИЧЕСТВУ"; selected: root.fixed-mode == "batch"; enabled: !root.fixed-busy; clicked => { root.fixed-mode = "batch"; } }
                        }

                        if root.fixed-mode == "verify": Rectangle {
                            vertical-stretch: 1;
                            border-radius: 18px;
                            border-width: 1px;
                            border-color: root.fixed-control-in-range ? Palette.e300 : Palette.n200;
                            background: root.fixed-control-in-range ? Palette.e50 : Palette.n50;
                            VerticalLayout {
                                padding: 16px;
                                alignment: center;
                                spacing: 12px;
                                Text {
                                    text: root.fixed-selected-product-id == 0 ? "Выберите товар" : !root.stable ? "Дождитесь стабильного веса" : !root.fixed-control-in-range ? "Контрольный вес вне диапазона товара" : "Контроль пройден — на этикетку попадёт фиксированный вес";
                                    color: root.fixed-control-in-range ? Palette.e700 : Palette.n600;
                                    font-size: 14px;
                                    font-weight: 650;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                                MainButton {
                                    width: 420px;
                                    text: root.fixed-busy ? "ПЕЧАТЬ…" : "НАПЕЧАТАТЬ ЭТИКЕТКУ";
                                    icon: @image-url("../assets/icons/printer-white.png");
                                    enabled: !root.fixed-busy && root.fixed-selected-product-id > 0 && root.stable && root.fixed-control-in-range && root.printer-ready;
                                    clicked => { root.print-fixed-weight(); }
                                }
                            }
                        }

                        if root.fixed-mode == "batch": Rectangle {
                            vertical-stretch: 1;
                            border-radius: 18px;
                            border-width: 1px;
                            border-color: root.fixed-busy ? Palette.a300 : Palette.n200;
                            background: root.fixed-busy ? Palette.a50 : Palette.n50;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;
                                HorizontalLayout {
                                    height: 54px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        width: 190px;
                                        spacing: 3px;
                                        Text { text: "КОЛИЧЕСТВО ЭТИКЕТОК"; color: Palette.n500; font-size: 10px; font-weight: 750; }
                                        LineEdit { height: 38px; text <=> root.fixed-copies; placeholder-text: "1–5000"; enabled: !root.fixed-busy; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    CompactActionButton { width: 160px; text: "ОТМЕНИТЬ"; danger: true; enabled: root.fixed-busy; clicked => { root.cancel-fixed-batch(); } }
                                    CompactActionButton { width: 196px; text: root.fixed-busy ? "ПЕЧАТЬ ПАРТИИ…" : "ЗАПУСТИТЬ ПАРТИЮ"; primary: true; enabled: !root.fixed-busy && root.fixed-selected-product-id > 0 && root.printer-ready; clicked => { root.start-fixed-batch(); } }
                                }
                                Rectangle {
                                    height: 16px;
                                    border-radius: 8px;
                                    background: Palette.n200;
                                    Rectangle {
                                        width: root.fixed-progress-total > 0 ? parent.width * root.fixed-progress / root.fixed-progress-total : 0px;
                                        height: parent.height;
                                        border-radius: 8px;
                                        background: root.fixed-busy ? Palette.a500 : Palette.e500;
                                    }
                                }
                                Text {
                                    text: root.fixed-progress-total > 0 ? "Напечатано " + root.fixed-progress + " из " + root.fixed-progress-total : "Печать идёт через общую надёжную очередь принтера";
                                    color: Palette.n600;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 4;
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: Palette.n200;
                    background: white;
                    VerticalLayout {
                        padding: root.narrow ? 14px : 18px;
                        spacing: 12px;
                        Text { text: "ПРЕДПРОСМОТР ДАННЫХ ЭТИКЕТКИ"; color: Palette.n500; font-size: 11px; font-weight: 750; letter-spacing: 0.9px; }
                        Rectangle {
                            vertical-stretch: 1;
                            border-radius: 16px;
                            border-width: 1px;
                            border-color: Palette.n300;
                            background: white;
                            VerticalLayout {
                                padding: root.narrow ? 16px : 24px;
                                spacing: root.narrow ? 8px : 12px;
                                Text { text: root.fixed-product-name; color: Palette.n900; font-size: root.narrow ? 19px : 23px; font-weight: 800; wrap: word-wrap; horizontal-alignment: center; }
                                Rectangle { height: 2px; background: Palette.n900; }
                                ThinStatRow { label: "Артикул"; value: root.fixed-product-article == "" ? "—" : root.fixed-product-article; }
                                ThinStatRow { label: "Фиксированный вес"; value: root.fixed-nominal-weight + " кг"; value-color: Palette.e700; }
                                ThinStatRow { label: "Партия"; value: root.batch-number == "" ? "—" : root.batch-number; }
                                ThinStatRow { label: "Дата производства"; value: root.labeling-date; }
                                ThinStatRow { label: "Срок годности"; value: root.expiration-days + " дн."; }
                                Rectangle { vertical-stretch: 1; }
                                Rectangle {
                                    height: 84px;
                                    border-radius: 8px;
                                    background: Palette.n900;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text { text: "|||| || ||||| | |||| ||| ||"; color: white; font-family: "Consolas"; font-size: 26px; font-weight: 800; horizontal-alignment: center; }
                                        Text { text: root.fixed-product-article == "" ? "0000000000000" : root.fixed-product-article; color: white; font-family: "Consolas"; font-size: 13px; letter-spacing: 2px; horizontal-alignment: center; }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            height: 54px;
                            spacing: 9px;
                            QueueSummaryCard { label: "В КОРОБЕ"; value: root.units-in-box; accent: Palette.e600; }
                            QueueSummaryCard { label: "ВСЕГО"; value: root.total-units; accent: Palette.a500; }
                        }
                    }
                }
            }
        }
    }

    if root.active-page == 6: Rectangle {
        x: (parent.width - root.shell-width) / 2 + root.sidebar-width;
        width: root.work-area-width;
        height: parent.height;
        background: Palette.n50;

        VerticalLayout {
            padding: root.content-padding;
            spacing: root.narrow ? 12px : 16px;

            HorizontalLayout {
                height: 58px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: "Задания на печать"; color: Palette.n900; font-size: 26px; font-weight: 750; }
                    Text { text: root.production-jobs-status; color: Palette.n500; font-size: 12px; overflow: elide; }
                }
                Rectangle { horizontal-stretch: 1; }
                SettingsChoiceButton { width: 122px; height: 44px; text: "АКТИВНЫЕ"; selected: !root.production-jobs-completed; enabled: !root.production-jobs-busy; clicked => { root.production-jobs-completed = false; root.reload-production-jobs(); } }
                SettingsChoiceButton { width: 134px; height: 44px; text: "ЗАВЕРШЁННЫЕ"; selected: root.production-jobs-completed; enabled: !root.production-jobs-busy; clicked => { root.production-jobs-completed = true; root.reload-production-jobs(); } }
                CompactActionButton { width: 138px; text: "ОБНОВИТЬ"; enabled: !root.production-jobs-busy; clicked => { root.reload-production-jobs(); } }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: root.narrow ? 12px : 18px;

                Rectangle {
                    horizontal-stretch: 5;
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: Palette.n200;
                    background: white;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 9px;
                        HorizontalLayout {
                            height: 34px;
                            Text { text: "ЗАДАНИЯ · " + root.production-jobs.length; color: Palette.n500; font-size: 11px; font-weight: 750; letter-spacing: 0.9px; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            if root.production-jobs-busy: Text { text: "ОБНОВЛЕНИЕ…"; color: Palette.e700; font-size: 11px; font-weight: 750; vertical-alignment: center; }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            viewport-width: self.width;
                            VerticalLayout {
                                spacing: 8px;
                                if root.production-jobs.length == 0: Rectangle {
                                    height: 180px;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 10px;
                                        VerticalIcon { icon-size: 48px; icon: @image-url("../assets/icons/clipboard-list.png"); }
                                        Text { text: root.production-jobs-completed ? "Завершённых заданий нет" : "Активных заданий нет"; color: Palette.n600; font-size: 16px; font-weight: 650; horizontal-alignment: center; }
                                    }
                                }
                                for job[index] in root.production-jobs: Rectangle {
                                    height: 112px;
                                    border-radius: 16px;
                                    border-width: job.job-id == root.selected-production-job-id ? 2px : 1px;
                                    border-color: job.job-id == root.selected-production-job-id ? Palette.e500 : Palette.n200;
                                    background: job.job-id == root.selected-production-job-id ? Palette.e50 : job-touch.has-hover ? Palette.n100 : Palette.n50;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 7px;
                                        HorizontalLayout {
                                            height: 28px;
                                            Text { text: "#" + job.job-id + " · " + job.product-name; color: Palette.n900; font-size: 14px; font-weight: 750; overflow: elide; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; }
                                            Rectangle {
                                                width: 106px;
                                                height: 26px;
                                                border-radius: 13px;
                                                background: job.completed ? Palette.e100 : job.status == "in_progress" ? Palette.a50 : Palette.n200;
                                                Text { text: job.status-label; color: job.completed ? Palette.e700 : job.status == "in_progress" ? Palette.a700 : Palette.n600; font-size: 10px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                        }
                                        HorizontalLayout {
                                            height: 18px;
                                            Text { text: "Партия " + (job.batch == "" ? "—" : job.batch) + " · " + job.marking-date; color: Palette.n500; font-size: 10px; overflow: elide; }
                                            Text { text: job.printed + " / " + job.quantity; color: Palette.n800; font-family: "Consolas"; font-size: 11px; font-weight: 700; horizontal-alignment: right; }
                                        }
                                        Rectangle {
                                            height: 9px;
                                            border-radius: 5px;
                                            background: Palette.n200;
                                            Rectangle { width: parent.width * job.progress; height: parent.height; border-radius: 5px; background: job.completed ? Palette.e500 : Palette.a500; }
                                        }
                                    }
                                    job-touch := TouchArea { enabled: !root.production-jobs-busy; clicked => { root.select-production-job(index); } }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 4;
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: Palette.n200;
                    background: white;
                    VerticalLayout {
                        padding: root.narrow ? 14px : 18px;
                        spacing: 11px;
                        Text { text: "ВЫБРАННОЕ ЗАДАНИЕ"; color: Palette.n500; font-size: 11px; font-weight: 750; letter-spacing: 0.9px; }
                        Text { text: root.selected-production-job-product; color: Palette.n900; font-size: 20px; font-weight: 800; wrap: word-wrap; }
                        Text { text: root.selected-production-job-article == "" ? "Артикул —" : "Артикул " + root.selected-production-job-article; color: Palette.n500; font-size: 12px; }
                        HorizontalLayout {
                            height: 78px;
                            spacing: 9px;
                            QueueSummaryCard { label: "ПЛАН"; value: 0; accent: Palette.e600; Text { text: root.selected-production-job-quantity; color: Palette.n900; font-family: "Consolas"; font-size: 18px; font-weight: 800; horizontal-alignment: right; vertical-alignment: center; } }
                            QueueSummaryCard { label: "ОСТАЛОСЬ"; value: 0; accent: Palette.a500; Text { text: root.selected-production-job-remaining; color: Palette.a700; font-family: "Consolas"; font-size: 18px; font-weight: 800; horizontal-alignment: right; vertical-alignment: center; } }
                        }
                        ThinStatRow { label: "Партия"; value: root.selected-production-job-batch == "" ? "—" : root.selected-production-job-batch; }
                        ThinStatRow { label: "Дата маркировки"; value: root.selected-production-job-date; }
                        ThinStatRow { label: "Режим"; value: root.selected-production-job-unit == "kg" ? "ПО ВЕСУ, КГ" : "ПОШТУЧНО"; value-color: Palette.e700; }

                        Rectangle {
                            height: root.short ? 128px : 150px;
                            border-radius: 18px;
                            border-width: 2px;
                            border-color: root.production-job-weight-valid ? Palette.e400 : root.stable ? Palette.a300 : Palette.n300;
                            background: root.production-job-weight-valid ? Palette.e50 : root.stable ? Palette.a50 : Palette.n50;
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text { text: root.selected-production-product-fixed ? "КОНТРОЛЬНЫЙ ВЕС · ЭТИКЕТКА " + root.selected-production-product-weight + " КГ" : "ВЕС УПАКОВКИ"; color: Palette.n500; font-size: 10px; font-weight: 750; horizontal-alignment: center; }
                                Text { text: root.gross-weight; color: root.production-job-weight-valid ? Palette.e700 : Palette.n900; font-family: "Consolas"; font-size: root.short ? 38px : 46px; font-weight: 800; horizontal-alignment: center; }
                                Text { text: root.production-job-weight-valid ? "ГОТОВО К ПЕЧАТИ" : root.stable ? "ПРОВЕРЬТЕ ВЕС" : "ОЖИДАНИЕ СТАБИЛЬНОСТИ"; color: root.production-job-weight-valid ? Palette.e700 : Palette.n500; font-size: 11px; font-weight: 750; horizontal-alignment: center; }
                            }
                        }

                        Rectangle {
                            height: 13px;
                            border-radius: 7px;
                            background: Palette.n200;
                            Rectangle { width: parent.width * root.selected-production-job-progress; height: parent.height; border-radius: 7px; background: root.selected-production-job-status == "completed" ? Palette.e500 : Palette.a500; }
                        }
                        Text { text: "Выполнено " + root.selected-production-job-printed + " из " + root.selected-production-job-quantity; color: Palette.n600; font-size: 12px; horizontal-alignment: center; }

                        Rectangle { vertical-stretch: 1; }

                        MainButton {
                            text: root.production-jobs-busy ? "ПЕЧАТЬ…" : "НАПЕЧАТАТЬ УПАКОВКУ";
                            icon: @image-url("../assets/icons/printer-white.png");
                            enabled: !root.production-jobs-busy && root.selected-production-job-id > 0 && root.selected-production-job-status != "completed" && root.stable && root.production-job-weight-valid && root.printer-ready;
                            clicked => { root.print-production-job-pack(); }
                        }
                        HorizontalLayout {
                            height: 50px;
                            spacing: 9px;
                            CompactActionButton { horizontal-stretch: 1; text: "ЗАВЕРШИТЬ"; enabled: !root.production-jobs-busy && root.selected-production-job-id > 0 && root.selected-production-job-status != "completed"; clicked => { root.complete-production-job(); } }
                            CompactActionButton { horizontal-stretch: 1; text: "УДАЛИТЬ"; danger: true; enabled: !root.production-jobs-busy && root.selected-production-job-id > 0; clicked => { root.delete-production-job(); } }
                        }
                    }
                }
            }
        }
    }

    if root.active-page == 7: Rectangle {
        x: (parent.width - root.shell-width) / 2 + root.sidebar-width;
        width: root.work-area-width;
        height: parent.height;
        background: Palette.n50;

        VerticalLayout {
            padding: root.content-padding;
            spacing: root.narrow ? 12px : 16px;
            HorizontalLayout {
                height: 58px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: "Каталог товаров"; color: Palette.n900; font-size: 26px; font-weight: 750; }
                    Text { text: root.catalog-status; color: Palette.n500; font-size: 12px; overflow: elide; }
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 132px;
                    height: 38px;
                    border-radius: 19px;
                    border-width: 1px;
                    border-color: root.catalog-truncated ? Palette.a300 : Palette.e200;
                    background: root.catalog-truncated ? Palette.a50 : Palette.e50;
                    Text { text: root.catalog-total + " товаров"; color: root.catalog-truncated ? Palette.a700 : Palette.e700; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
                CompactActionButton { width: 142px; text: root.catalog-busy ? "ЗАГРУЗКА…" : "ОБНОВИТЬ"; primary: true; enabled: !root.catalog-busy; clicked => { root.reload-catalog(); } }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: root.narrow ? 12px : 18px;
                Rectangle {
                    horizontal-stretch: 5;
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: Palette.n200;
                    background: white;
                    clip: true;
                    VerticalLayout {
                        padding: root.narrow ? 12px : 16px;
                        spacing: 11px;
                        HorizontalLayout {
                            height: 50px;
                            spacing: 9px;
                            LineEdit { horizontal-stretch: 1; text <=> root.catalog-search; placeholder-text: "Название или артикул"; accepted => { root.search-catalog(self.text); } }
                            CompactActionButton { width: 116px; text: "НАЙТИ"; enabled: !root.catalog-busy; clicked => { root.search-catalog(root.catalog-search); } }
                        }
                        Text { text: root.catalog-truncated ? "ПОКАЗАНЫ ПЕРВЫЕ 50 — УТОЧНИТЕ ПОИСК" : "ЛОКАЛЬНЫЙ КАТАЛОГ"; color: root.catalog-truncated ? Palette.a700 : Palette.n500; font-size: 10px; font-weight: 750; letter-spacing: 0.8px; }
                        ScrollView {
                            vertical-stretch: 1;
                            viewport-width: self.width;
                            VerticalLayout {
                                spacing: 8px;
                                if root.catalog-products.length == 0: Rectangle {
                                    height: 160px;
                                    border-radius: 16px;
                                    background: Palette.n50;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 8px;
                                        VerticalIcon { icon-size: 38px; icon: @image-url("../assets/icons/package.png"); icon-color: Palette.n400; }
                                        Text { text: root.catalog-busy ? "Загрузка товаров…" : "Товары не найдены"; color: Palette.n600; font-size: 16px; font-weight: 650; horizontal-alignment: center; }
                                    }
                                }
                                for product[index] in root.catalog-products: Rectangle {
                                    height: root.short ? 62px : 70px;
                                    border-radius: 14px;
                                    border-width: product.id == root.catalog-selected-product-id ? 2px : 1px;
                                    border-color: product.id == root.catalog-selected-product-id ? Palette.e400 : Palette.n200;
                                    background: catalog-row-touch.pressed ? Palette.e100 : catalog-row-touch.has-hover ? Palette.e50 : product.id == root.catalog-selected-product-id ? #ecfdf580 : Palette.n50;
                                    HorizontalLayout {
                                        padding-left: 13px;
                                        padding-right: 13px;
                                        spacing: 11px;
                                        Rectangle {
                                            width: 40px;
                                            height: 40px;
                                            border-radius: 11px;
                                            background: product.id == root.catalog-selected-product-id ? Palette.e100 : Palette.n200;
                                            AppIcon { width: 20px; height: 20px; x: 10px; y: 10px; icon: @image-url("../assets/icons/package.png"); }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 3px;
                                            Text { text: product.name; color: Palette.n900; font-size: 14px; font-weight: 700; overflow: elide; }
                                            Text { text: product.details; color: Palette.n500; font-size: 10px; overflow: elide; }
                                        }
                                        Text { width: 74px; text: "#" + product.id; color: Palette.n400; font-family: "Consolas"; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                                    }
                                    catalog-row-touch := TouchArea { enabled: !root.catalog-busy; clicked => { root.select-catalog-product(index); } }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 6;
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: Palette.n200;
                    background: white;
                    clip: true;
                    ScrollView {
                        width: parent.width;
                        height: parent.height;
                        viewport-width: self.width;
                        VerticalLayout {
                            padding: root.narrow ? 14px : 18px;
                            spacing: 11px;
                            Text { text: "КАРТОЧКА ТОВАРА"; color: Palette.n500; font-size: 10px; font-weight: 750; letter-spacing: 0.9px; }
                            Text { text: root.catalog-name; color: Palette.n900; font-size: root.narrow ? 19px : 22px; font-weight: 800; wrap: word-wrap; }
                            HorizontalLayout {
                                height: 34px;
                                spacing: 8px;
                                Rectangle { horizontal-stretch: 1; border-radius: 10px; background: Palette.n100; Text { text: "АРТ. " + root.catalog-article; color: Palette.n700; font-family: "Consolas"; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; overflow: elide; } }
                                Rectangle { width: 136px; border-radius: 10px; background: root.catalog-mode == "Фиксированный" ? Palette.e100 : Palette.a50; Text { text: root.catalog-mode; color: root.catalog-mode == "Фиксированный" ? Palette.e700 : Palette.a700; font-size: 11px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; } }
                            }
                            ThinStatRow { compact: root.short; label: "Срок годности"; value: root.catalog-expiration; }
                            ThinStatRow { compact: root.short; label: "Фиксированный вес"; value: root.catalog-fixed-weight; value-color: Palette.e700; }
                            Text { text: "ТАРА И КОРОБ"; color: Palette.n500; font-size: 10px; font-weight: 750; letter-spacing: 0.8px; }
                            ThinStatRow { compact: root.short; label: "Тара упаковки"; value: root.catalog-portion-container; }
                            ThinStatRow { compact: root.short; label: "Вес тары упаковки"; value: root.catalog-portion-tare; }
                            ThinStatRow { compact: root.short; label: "Тара короба"; value: root.catalog-box-container; }
                            ThinStatRow { compact: root.short; label: "Вес тары короба"; value: root.catalog-box-tare; }
                            ThinStatRow { compact: root.short; label: "Упаковок в коробе"; value: root.catalog-box-limit; }
                            Text { text: "ШАБЛОНЫ ПЕЧАТИ"; color: Palette.n500; font-size: 10px; font-weight: 750; letter-spacing: 0.8px; }
                            ThinStatRow { compact: root.short; label: "Упаковка"; value: root.catalog-pack-label; }
                            ThinStatRow { compact: root.short; label: "Короб"; value: root.catalog-box-label; }
                            ThinStatRow { compact: root.short; label: "Паллета"; value: root.catalog-pallet-label; }
                            Rectangle {
                                min-height: 74px;
                                border-radius: 14px;
                                border-width: 1px;
                                border-color: Palette.n200;
                                background: Palette.n50;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 5px;
                                    Text { text: "ДОПОЛНИТЕЛЬНЫЕ ДАННЫЕ"; color: Palette.n500; font-size: 9px; font-weight: 750; letter-spacing: 0.7px; }
                                    Text { text: root.catalog-extra; color: Palette.n700; font-size: 11px; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.active-page == 8: Rectangle {
        x: (parent.width - root.shell-width) / 2 + root.sidebar-width;
        width: root.work-area-width;
        height: parent.height;
        background: Palette.n50;
        VerticalLayout {
            padding: root.content-padding;
            spacing: root.narrow ? 12px : 16px;
            HorizontalLayout {
                height: 58px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: "Станция и лицензия"; color: Palette.n900; font-size: 26px; font-weight: 750; }
                    Text { text: root.license-status; color: root.license-server-online ? Palette.e700 : Palette.n500; font-size: 12px; overflow: elide; }
                }
                Rectangle { horizontal-stretch: 1; }
                StatusPill { text: root.license-server-online ? "Сервер доступен" : "Сервер недоступен"; good: root.license-server-online; }
                CompactActionButton { width: 152px; text: root.license-busy ? "ПРОВЕРКА…" : "ОБНОВИТЬ"; primary: true; enabled: !root.license-busy; clicked => { root.reload-license(); } }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: root.narrow ? 12px : 18px;
                Rectangle {
                    width: root.narrow ? 440px : 520px;
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: Palette.n200;
                    background: white;
                    VerticalLayout {
                        padding: root.narrow ? 14px : 18px;
                        spacing: root.narrow ? 10px : 13px;
                        Text { text: "РАБОЧАЯ СТАНЦИЯ"; color: Palette.n500; font-size: 10px; font-weight: 750; letter-spacing: 0.9px; }
                        Text { text: root.license-station-name; color: Palette.n900; font-size: 21px; font-weight: 800; wrap: word-wrap; }
                        ThinStatRow { compact: root.short; label: "Номер"; value: root.license-station-number; }
                        ThinStatRow { compact: root.short; label: "UUID"; value: root.license-station-uuid; }
                        ThinStatRow { compact: root.short; label: "Последняя синхронизация"; value: root.license-last-sync; }
                        Rectangle { height: 1px; background: Palette.n200; }
                        Text { text: "СЕРВЕР"; color: Palette.n500; font-size: 10px; font-weight: 750; letter-spacing: 0.9px; }
                        Text { text: "IP, host:port или URL"; color: Palette.n500; font-size: 11px; }
                        LineEdit { height: 50px; text <=> root.license-server-address; placeholder-text: "192.168.1.10 или http://server:8000"; accepted => { root.save-server-address(self.text); } }
                        HorizontalLayout {
                            height: 48px;
                            spacing: 9px;
                            CompactActionButton { horizontal-stretch: 1; text: "ПРОВЕРИТЬ"; enabled: !root.license-busy; clicked => { root.reload-license(); } }
                            CompactActionButton { horizontal-stretch: 1; text: "СОХРАНИТЬ"; primary: true; enabled: !root.license-busy; clicked => { root.save-server-address(root.license-server-address); } }
                        }
                        Rectangle {
                            min-height: 82px;
                            border-radius: 14px;
                            border-width: 1px;
                            border-color: !root.license-server-configured ? Palette.n300 : !root.license-server-online ? Palette.r300 : !root.license-server-compatible ? Palette.a300 : Palette.e300;
                            background: !root.license-server-configured ? Palette.n50 : !root.license-server-online ? Palette.r50 : !root.license-server-compatible ? Palette.a50 : Palette.e50;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;
                                Text { text: !root.license-server-configured ? "СЕРВЕР НЕ НАСТРОЕН" : !root.license-server-online ? "НЕТ СОЕДИНЕНИЯ" : !root.license-server-compatible ? "ТРЕБУЕТСЯ ОБНОВЛЕНИЕ КЛИЕНТА" : "СЕРВЕР ГОТОВ"; color: !root.license-server-configured ? Palette.n600 : !root.license-server-online ? Palette.r600 : !root.license-server-compatible ? Palette.a700 : Palette.e700; font-size: 11px; font-weight: 800; }
                                Text { text: root.license-compatibility == "" ? "Версия сервера " + root.license-server-version + " · минимум клиента " + root.license-min-client-version : root.license-compatibility; color: Palette.n600; font-size: 11px; wrap: word-wrap; }
                            }
                        }
                        Text { text: "Синхронизацию данных инициирует сервер; эта кнопка проверяет связь и лицензию без блокировки рабочего экрана."; color: Palette.n500; font-size: 11px; wrap: word-wrap; }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: root.license-active && !root.license-expired ? Palette.e300 : root.license-expired ? Palette.r300 : Palette.a300;
                    background: white;
                    clip: true;
                    ScrollView {
                        width: parent.width;
                        height: parent.height;
                        viewport-width: self.width;
                        VerticalLayout {
                            padding: root.narrow ? 14px : 18px;
                            spacing: 11px;
                            HorizontalLayout {
                                height: 48px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: root.license-edition; color: Palette.n900; font-size: 22px; font-weight: 800; overflow: elide; }
                                    Text { text: root.license-customer; color: Palette.n500; font-size: 12px; overflow: elide; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Rectangle { width: 116px; height: 34px; border-radius: 17px; background: root.license-active && !root.license-expired ? Palette.e100 : root.license-expired ? Palette.r100 : Palette.a50; Text { text: root.license-expired ? "ИСТЕКЛА" : root.license-mode; color: root.license-active && !root.license-expired ? Palette.e700 : root.license-expired ? Palette.r700 : Palette.a700; font-size: 11px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; overflow: elide; } }
                            }
                            ThinStatRow { compact: root.short; label: "Статус API"; value: root.license-online ? "Получен" : "Офлайн"; value-color: root.license-online ? Palette.e700 : Palette.a700; }
                            ThinStatRow { compact: root.short; label: "Действует до"; value: root.license-expires; }
                            ThinStatRow { compact: root.short; label: "Станции"; value: root.license-stations; }
                            ThinStatRow { compact: root.short; label: "License ID"; value: root.license-id; }
                            ThinStatRow { compact: root.short; label: "Подпись"; value: root.license-signature; value-color: root.license-active ? Palette.e700 : Palette.n700; }
                            ThinStatRow { compact: root.short; label: "Machine ID"; value: root.license-machine; }
                            Text { text: "ДОСТУПНЫЕ ФУНКЦИИ"; color: Palette.n500; font-size: 10px; font-weight: 750; letter-spacing: 0.9px; }
                            Rectangle {
                                min-height: 110px;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: Palette.n200;
                                background: Palette.n50;
                                Text { x: 14px; y: 14px; width: parent.width - 28px; text: root.license-features; color: Palette.n700; font-size: 12px; wrap: word-wrap; }
                            }
                            Rectangle {
                                min-height: 82px;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: root.license-active && !root.license-expired ? Palette.e300 : Palette.a300;
                                background: root.license-active && !root.license-expired ? Palette.e50 : Palette.a50;
                                VerticalLayout {
                                    padding: 13px;
                                    spacing: 4px;
                                    Text { text: root.license-active && !root.license-expired ? "ЛИЦЕНЗИЯ АКТИВНА" : root.license-expired ? "СРОК ЛИЦЕНЗИИ ИСТЁК" : "ДЕМОНСТРАЦИОННЫЙ РЕЖИМ"; color: root.license-active && !root.license-expired ? Palette.e700 : Palette.a700; font-size: 12px; font-weight: 800; }
                                    Text { text: root.license-online ? "Статус получен с настроенного сервера." : "Показан последний доступный локальный статус интерфейса."; color: Palette.n600; font-size: 11px; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.active-page == 9: Rectangle {
        background: Palette.n50;
        VerticalLayout {
            padding: root.content-padding;
            spacing: root.narrow ? 12px : 18px;

            HorizontalLayout {
                height: 58px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: "Обновление и обслуживание"; color: Palette.n900; font-size: 26px; font-weight: 750; }
                    Text { text: root.update-status; color: root.update-error == "" ? Palette.n500 : Palette.r600; font-size: 12px; overflow: elide; }
                }
                Rectangle { horizontal-stretch: 1; }
                StatusPill {
                    text: root.update-ready ? "Готово к установке" : root.update-available ? "Доступно обновление" : "Версия " + root.update-current-version;
                    good: root.update-ready || !root.update-available;
                }
                CompactActionButton {
                    width: 154px;
                    text: root.update-busy ? "ПРОВЕРКА…" : "ПРОВЕРИТЬ";
                    primary: true;
                    enabled: !root.update-busy;
                    clicked => { root.check-update(); }
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: root.narrow ? 12px : 18px;
                Rectangle {
                    horizontal-stretch: 3;
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: root.update-ready ? Palette.e300 : root.update-error == "" ? Palette.n200 : Palette.r300;
                    background: white;
                    VerticalLayout {
                        padding: root.narrow ? 16px : 22px;
                        spacing: root.narrow ? 11px : 15px;
                        Text { text: "ОНЛАЙН-КАНАЛ"; color: Palette.n500; font-size: 10px; font-weight: 750; letter-spacing: 0.9px; }
                        HorizontalLayout {
                            height: 64px;
                            VerticalLayout {
                                spacing: 3px;
                                Text { text: root.update-available ? "Версия " + root.update-available-version : "LabelPilot " + root.update-current-version; color: Palette.n900; font-size: root.narrow ? 23px : 28px; font-weight: 800; }
                                Text { text: root.update-available ? "Подписанный portable-пакет для Windows x64" : "Установленная версия"; color: Palette.n500; font-size: 12px; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Rectangle {
                                width: 118px; height: 38px; border-radius: 19px;
                                background: root.update-available ? Palette.a50 : Palette.e100;
                                Text { text: root.update-available ? "ДОСТУПНО" : "АКТУАЛЬНО"; color: root.update-available ? Palette.a700 : Palette.e700; font-size: 11px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        Rectangle { height: 1px; background: Palette.n200; }
                        Text { text: "ИЗМЕНЕНИЯ"; color: Palette.n500; font-size: 10px; font-weight: 750; letter-spacing: 0.9px; }
                        Rectangle {
                            min-height: root.short ? 92px : 130px;
                            border-radius: 15px;
                            background: Palette.n50;
                            border-width: 1px;
                            border-color: Palette.n200;
                            Text { x: 14px; y: 13px; width: parent.width - 28px; height: parent.height - 26px; text: root.update-notes; color: Palette.n700; font-size: 12px; wrap: word-wrap; overflow: elide; }
                        }
                        ThinStatRow { compact: root.short; label: "Размер пакета"; value: root.update-size; }
                        ThinStatRow { compact: root.short; label: "Проверка"; value: "Minisign + SHA-256"; value-color: Palette.e700; }
                        if root.update-state == "downloading" || root.update-ready: VerticalLayout {
                            height: 58px;
                            spacing: 7px;
                            HorizontalLayout {
                                Text { text: root.update-ready ? "ПАКЕТ ПРОВЕРЕН" : "ЗАГРУЗКА"; color: root.update-ready ? Palette.e700 : Palette.n600; font-size: 10px; font-weight: 800; }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: root.update-progress + "%"; color: Palette.n700; font-size: 11px; font-weight: 750; }
                            }
                            Rectangle {
                                height: 12px; border-radius: 6px; background: Palette.n200; clip: true;
                                Rectangle { width: parent.width * root.update-progress / 100; height: parent.height; border-radius: 6px; background: Palette.e500; }
                            }
                        }
                        if root.update-error != "": Rectangle {
                            min-height: 66px; border-radius: 14px; border-width: 1px; border-color: Palette.r300; background: Palette.r50;
                            Text { x: 13px; y: 10px; width: parent.width - 26px; text: root.update-error; color: Palette.r700; font-size: 11px; wrap: word-wrap; }
                        }
                        Rectangle { vertical-stretch: 1; }
                        HorizontalLayout {
                            height: 52px;
                            spacing: 10px;
                            CompactActionButton { horizontal-stretch: 1; text: "СКАЧАТЬ"; enabled: root.update-available && !root.update-busy && !root.update-ready; clicked => { root.download-update(); } }
                            CompactActionButton { horizontal-stretch: 1; text: root.update-ready ? "УСТАНОВИТЬ И ПЕРЕЗАПУСТИТЬ" : "УСТАНОВИТЬ"; primary: true; enabled: root.update-ready && !root.update-busy; clicked => { root.install-update(); } }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 2;
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: Palette.n200;
                    background: white;
                    VerticalLayout {
                        padding: root.narrow ? 16px : 22px;
                        spacing: root.narrow ? 11px : 15px;
                        Text { text: "ОФЛАЙН-ОБСЛУЖИВАНИЕ"; color: Palette.n500; font-size: 10px; font-weight: 750; letter-spacing: 0.9px; }
                        Text { text: "Установка с USB-носителя"; color: Palette.n900; font-size: 21px; font-weight: 800; }
                        Text { text: "Укажите путь к native-latest.json. Пакет .lpupdate должен лежать рядом; подпись и SHA-256 проверяются до установки."; color: Palette.n600; font-size: 12px; wrap: word-wrap; }
                        LineEdit { height: 52px; text <=> root.update-offline-path; placeholder-text: "D:\\LabelPilot\\native-latest.json"; accepted => { root.stage-offline-update(self.text); } }
                        CompactActionButton { height: 52px; text: "ПРОВЕРИТЬ ОФЛАЙН-ПАКЕТ"; enabled: !root.update-busy && root.update-offline-path != ""; clicked => { root.stage-offline-update(root.update-offline-path); } }
                        Rectangle { height: 1px; background: Palette.n200; }
                        Text { text: "ВОССТАНОВЛЕНИЕ"; color: Palette.n500; font-size: 10px; font-weight: 750; letter-spacing: 0.9px; }
                        Rectangle {
                            min-height: 116px;
                            border-radius: 15px;
                            border-width: 1px;
                            border-color: root.update-rollback-available ? Palette.e300 : Palette.n200;
                            background: root.update-rollback-available ? Palette.e50 : Palette.n50;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 6px;
                                Text { text: root.update-rollback-available ? "ТОЧКА ВОССТАНОВЛЕНИЯ ЕСТЬ" : "ОТКАТ СОЗДАЁТСЯ АВТОМАТИЧЕСКИ"; color: root.update-rollback-available ? Palette.e700 : Palette.n700; font-size: 11px; font-weight: 800; }
                                Text { text: "Перед заменой сохраняются бинарные файлы, база, настройки и очередь. Если новая версия не подтвердит запуск за 30 секунд, helper вернёт предыдущую версию."; color: Palette.n600; font-size: 11px; wrap: word-wrap; }
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                        Text { text: "Updater не работает в фоне постоянно: сеть и память используются только во время проверки или загрузки."; color: Palette.n500; font-size: 11px; wrap: word-wrap; }
                    }
                }
            }
        }
    }
    if root.confirm-print-action-visible: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000cc;
        Rectangle {
            width: min(parent.width - 32px, 620px);
            height: 410px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 30px;
            border-width: 1px;
            border-color: root.confirm-print-action == "cancel" ? Palette.r300 : root.confirm-print-uncertain ? Palette.a300 : Palette.e300;
            background: white;
            VerticalLayout {
                padding: 34px;
                spacing: 16px;
                VerticalIcon {
                    icon-size: 54px;
                    icon: root.confirm-print-action == "cancel" ? @image-url("../assets/icons/trash2-red.png") : @image-url("../assets/icons/list-restart.png");
                    icon-color: root.confirm-print-action == "cancel" ? Palette.r600 : root.confirm-print-uncertain ? Palette.a600 : Palette.e600;
                }
                Text {
                    text: root.confirm-print-action == "cancel" ? "Отменить задание?" : "Повторить печать?";
                    color: Palette.n900;
                    font-size: 27px;
                    font-weight: 750;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.confirm-print-action == "cancel"
                        ? "Задание #" + root.confirm-print-job-title + " будет удалено из активной очереди."
                        : root.confirm-print-uncertain
                            ? "Принтер мог уже принять задание #" + root.confirm-print-job-title + ". Повтор может создать дубликат этикетки."
                            : "Задание #" + root.confirm-print-job-title + " будет поставлено в очередь повторно.";
                    color: root.confirm-print-uncertain ? Palette.a700 : Palette.n600;
                    font-size: 17px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 12px;
                    MainButton {
                        horizontal-stretch: 1;
                        text: "НАЗАД";
                        icon: @image-url("../assets/icons/x.png");
                        normal-color: Palette.n600;
                        hover-color: Palette.n500;
                        pressed-color: Palette.n700;
                        border-radius: 16px;
                        clicked => { root.confirm-print-action-visible = false; }
                    }
                    MainButton {
                        horizontal-stretch: 1;
                        text: root.confirm-print-action == "cancel" ? "ОТМЕНИТЬ" : "ПОВТОРИТЬ";
                        icon: root.confirm-print-action == "cancel" ? @image-url("../assets/icons/trash2-red.png") : @image-url("../assets/icons/list-restart.png");
                        normal-color: root.confirm-print-action == "cancel" ? Palette.r600 : root.confirm-print-uncertain ? Palette.a600 : Palette.e600;
                        hover-color: root.confirm-print-action == "cancel" ? Palette.r500 : root.confirm-print-uncertain ? Palette.a500 : Palette.e500;
                        pressed-color: root.confirm-print-action == "cancel" ? Palette.r700 : root.confirm-print-uncertain ? Palette.a700 : Palette.e700;
                        border-radius: 16px;
                        clicked => {
                            if root.confirm-print-action == "retry" {
                                root.retry-print-job(root.confirm-print-job-id);
                            } else {
                                root.cancel-print-job(root.confirm-print-job-id);
                            }
                            root.confirm-print-action-visible = false;
                        }
                    }
                }
            }
        }
    }

    if root.toast-visible: Rectangle {
        width: 460px;
        height: 52px;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 32px;
        border-radius: 16px;
        background: Palette.e600;
        drop-shadow-color: #10b98199;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            HorizontalIcon {
                icon-size: 20px;
                icon: @image-url("../assets/icons/printer-white.png");
                icon-color: white;
            }
            Text {
                text: root.toast-text;
                color: white;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }


    if root.fixed-product-modal-visible: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000cc;

        Rectangle {
            width: min(parent.width - 32px, 720px);
            height: min(parent.height - 32px, 560px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 32px;
            border-width: 1px;
            border-color: Palette.n200;
            background: white;
            drop-shadow-color: #00000080;
            drop-shadow-blur: 30px;

            VerticalLayout {
                padding: 30px;
                spacing: 13px;
                Text { text: "Товар фиксированного веса"; color: Palette.n900; font-size: 27px; font-weight: 750; }
                Text { text: "Доступны только товары с заданным фиксированным весом"; color: Palette.n500; font-size: 14px; }
                HorizontalLayout {
                    height: 52px;
                    spacing: 10px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.fixed-product-search;
                        placeholder-text: "Название или артикул";
                        accepted => { root.search-fixed-products(self.text); }
                    }
                    MainButton {
                        width: 150px;
                        height: 52px;
                        text: "НАЙТИ";
                        icon: @image-url("../assets/icons/search.png");
                        border-radius: 14px;
                        clicked => { root.search-fixed-products(root.fixed-product-search); }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    VerticalLayout {
                        spacing: 8px;
                        if root.fixed-products.length == 0: Text {
                            height: 80px;
                            text: root.fixed-busy ? "Поиск…" : "Товары фиксированного веса не найдены";
                            color: Palette.n500;
                            font-size: 15px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        for product[index] in root.fixed-products: Rectangle {
                            height: 70px;
                            border-radius: 14px;
                            border-width: product.id == root.fixed-selected-product-id ? 2px : 1px;
                            border-color: product.id == root.fixed-selected-product-id ? Palette.e400 : Palette.n300;
                            background: fixed-row-touch.pressed ? Palette.e100 : fixed-row-touch.has-hover ? Palette.e50 : Palette.n50;
                            HorizontalLayout {
                                padding-left: 15px;
                                padding-right: 15px;
                                spacing: 12px;
                                Rectangle {
                                    width: 42px;
                                    height: 42px;
                                    border-radius: 12px;
                                    background: Palette.e100;
                                    AppIcon { width: 22px; height: 22px; x: 10px; y: 10px; icon: @image-url("../assets/icons/weight.png"); }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;
                                    Text { text: product.name; color: Palette.n900; font-size: 15px; font-weight: 700; overflow: elide; }
                                    Text { text: product.details; color: Palette.n500; font-size: 11px; overflow: elide; }
                                }
                            }
                            fixed-row-touch := TouchArea { enabled: !root.fixed-busy; clicked => { root.select-fixed-product(index); } }
                        }
                    }
                }
                MainButton {
                    text: "ЗАКРЫТЬ";
                    icon: @image-url("../assets/icons/x.png");
                    border-radius: 16px;
                    normal-color: Palette.n800;
                    hover-color: Palette.n700;
                    pressed-color: Palette.n900;
                    clicked => { root.fixed-product-modal-visible = false; }
                }
            }
        }
    }

    if root.product-modal-visible: Rectangle {
        height: parent.height;
        background: #000000cc;

        Rectangle {
            width: min(parent.width - 32px, 680px);
            height: min(parent.height - 32px, 520px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 32px;
            border-width: 1px;
            border-color: Palette.n200;
            background: white;
            drop-shadow-color: #00000080;
            drop-shadow-blur: 30px;

            VerticalLayout {
                padding: 32px;
                spacing: 14px;
                Text {
                    text: "Выбор товара";
                    color: Palette.n900;
                    font-size: 28px;
                    font-weight: 700;
                }
                Text {
                    text: "Коснитесь строки для выбора";
                    color: Palette.n500;
                    font-size: 15px;
                }
                HorizontalLayout {
                    height: 52px;
                    spacing: 10px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.product-search;
                        placeholder-text: "Название или артикул";
                        accepted => { root.search-products(self.text); }
                    }
                    MainButton {
                        width: 150px;
                        height: 52px;
                        text: "НАЙТИ";
                        icon: @image-url("../assets/icons/search.png");
                        border-radius: 14px;
                        clicked => { root.search-products(root.product-search); }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    VerticalLayout {
                        spacing: 8px;
                        if root.products.length == 0: Text {
                            height: 72px;
                            text: "Товары не найдены";
                            color: Palette.n500;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        for product[index] in root.products: Rectangle {
                            height: 64px;
                            border-radius: 14px;
                            border-width: 1px;
                            border-color: product.id == root.selected-product-id ? Palette.e400 : Palette.n300;
                            background: product-row-touch.pressed ? Palette.e100 : product-row-touch.has-hover ? Palette.e50 : Palette.n50;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;
                                    Text {
                                        text: product.name;
                                        color: Palette.n900;
                                        font-size: 16px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: product.details;
                                        color: Palette.n500;
                                        font-size: 12px;
                                        overflow: elide;
                                    }
                                }
                                HorizontalIcon {
                                    icon-size: 20px;
                                    icon: @image-url("../assets/icons/package.png");
                                    icon-color: product.id == root.selected-product-id ? Palette.e600 : Palette.n400;
                                }
                            }
                            product-row-touch := TouchArea {
                                clicked => {
                                    root.select-product(index);
                                    root.product-modal-visible = false;
                                }
                            }
                        }
                    }
                }
                MainButton {
                    text: "ЗАКРЫТЬ";
                    icon: @image-url("../assets/icons/x.png");
                    border-radius: 16px;
                    normal-color: Palette.n800;
                    hover-color: Palette.n700;
                    pressed-color: Palette.n900;
                    clicked => { root.product-modal-visible = false; }
                }
            }
        }
    }

    if root.keypad-visible: Rectangle {
        height: parent.height;
        background: #000000cc;

        Rectangle {
            width: 470px;
            height: 590px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 32px;
            background: white;

            VerticalLayout {
                padding: 24px;
                spacing: 11px;
                Text {
                    text: "Номер партии";
                    color: Palette.n900;
                    font-size: 25px;
                    font-weight: 700;
                }
                Rectangle {
                    height: 58px;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Palette.e300;
                    background: Palette.e50;
                    Text {
                        text: root.batch-number;
                        color: Palette.e700;
                        font-family: "Consolas";
                        font-size: 24px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 9px;
                    KeyButton { horizontal-stretch: 1; text: "1"; clicked => { root.batch-number += "1"; } }
                    KeyButton { horizontal-stretch: 1; text: "2"; clicked => { root.batch-number += "2"; } }
                    KeyButton { horizontal-stretch: 1; text: "3"; clicked => { root.batch-number += "3"; } }
                }
                HorizontalLayout {
                    spacing: 9px;
                    KeyButton { horizontal-stretch: 1; text: "4"; clicked => { root.batch-number += "4"; } }
                    KeyButton { horizontal-stretch: 1; text: "5"; clicked => { root.batch-number += "5"; } }
                    KeyButton { horizontal-stretch: 1; text: "6"; clicked => { root.batch-number += "6"; } }
                }
                HorizontalLayout {
                    spacing: 9px;
                    KeyButton { horizontal-stretch: 1; text: "7"; clicked => { root.batch-number += "7"; } }
                    KeyButton { horizontal-stretch: 1; text: "8"; clicked => { root.batch-number += "8"; } }
                    KeyButton { horizontal-stretch: 1; text: "9"; clicked => { root.batch-number += "9"; } }
                }
                HorizontalLayout {
                    spacing: 9px;
                    KeyButton { horizontal-stretch: 1; text: "-"; clicked => { root.batch-number += "-"; } }
                    KeyButton { horizontal-stretch: 1; text: "0"; clicked => { root.batch-number += "0"; } }
                    KeyButton { horizontal-stretch: 1; text: "⌫"; clicked => { root.batch-number = ""; } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    MainButton {
                        horizontal-stretch: 1;
                        text: "ОЧИСТИТЬ";
                        icon: @image-url("../assets/icons/x.png");
                        border-radius: 16px;
                        normal-color: Palette.n600;
                        hover-color: Palette.n500;
                        pressed-color: Palette.n700;
                        clicked => { root.batch-number = ""; }
                    }
                    MainButton {
                        horizontal-stretch: 1;
                        text: "ГОТОВО";
                        icon: @image-url("../assets/icons/check-circle2.png");
                        border-radius: 16px;
                        clicked => { root.keypad-visible = false; }
                    }
                }
            }
        }
    }

    if root.date-modal-visible: Rectangle {
