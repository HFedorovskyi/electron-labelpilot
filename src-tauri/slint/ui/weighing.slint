    if root.alert-visible: Rectangle {
        height: parent.height;
        background: #000000cc;

        Rectangle {
            width: min(parent.width - 32px, 672px);
            height: 430px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 32px;
            border-width: 1px;
            border-color: Palette.n200;
            background: white;

            VerticalLayout {
                padding: 40px;
                spacing: 16px;
                HorizontalLayout {
                    height: 96px;
                    alignment: center;
                    Rectangle {
                        width: 96px;
                        height: 96px;
                        border-radius: 48px;
                        background: Palette.r100;
                        AppIcon {
                            width: 48px;
                            height: 48px;
                            x: 24px;
                            y: 24px;
                            icon: @image-url("../assets/icons/alert-red.png");
