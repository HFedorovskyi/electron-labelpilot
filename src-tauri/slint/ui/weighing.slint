    short-code: string,
    has-pin: bool,
    is-last: bool,
}

export struct CalendarDayRow {
    label: string,
    date: string,
    in-current-month: bool,
    selected: bool,
    today: bool,
}

component CalendarDayButton inherits Rectangle {
    in property <CalendarDayRow> day;
    in property <bool> compact: false;
    callback clicked;

    min-width: 44px;
    min-height: root.compact ? 40px : 44px;
    border-radius: root.compact ? 10px : 12px;
    border-width: root.day.today && !root.day.selected ? 2px : root.day.selected ? 0px : 1px;
    border-color: root.day.today ? Palette.e500 : Palette.n200;
    background: root.day.selected ? Palette.e600 : touch.pressed ? Palette.e200 : touch.has-hover ? Palette.e50 : white;

    Text {
        text: root.day.label;
        color: root.day.selected ? white : root.day.in-current-month ? Palette.n900 : Palette.n400;
        font-size: root.compact ? 14px : 16px;
        font-weight: root.day.selected || root.day.today ? 750 : 550;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component CalendarNavButton inherits Rectangle {
