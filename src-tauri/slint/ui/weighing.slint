                        root.date-modal-visible = false;
                    }
                }
                MainButton {
                    text: "ЗАКРЫТЬ";
                    icon: @image-url("../assets/icons/x.png");
                    border-radius: 16px;
                    normal-color: Palette.n800;
                    hover-color: Palette.n700;
                    pressed-color: Palette.n900;
                    clicked => { root.date-modal-visible = false; }
                }
            }
