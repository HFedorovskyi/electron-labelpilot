                    pressed-color: Palette.n900;
                    border-radius: 16px;
                    clicked => { root.alert-visible = false; }
                }
            }
        }
    }

    if root.operator-login-visible: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #f5f5f5fa;
        Rectangle {
            width: min(parent.width - 40px, 760px);
            height: min(parent.height - 40px, 700px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 32px;
            border-width: 1px;
            border-color: Palette.n200;
            background: white;
            drop-shadow-color: #00000035;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 10px;
            VerticalLayout {
                padding: root.short ? 22px : 32px;
                spacing: root.short ? 10px : 16px;
                HorizontalLayout {
                    height: 64px;
                    alignment: center;
                    spacing: 16px;
                    Rectangle {
                        width: 58px;
                        vertical-stretch: 1;
                        Rectangle {
                            width: 58px;
                            height: 58px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 18px;
                            border-width: 1px;
                            border-color: Palette.e200;
                            background: Palette.e50;
                            AppIcon { width: 30px; height: 30px; x: 14px; y: 14px; icon: @image-url("../assets/icons/user.png"); icon-color: Palette.e600; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text { text: "Выберите оператора"; color: Palette.n900; font-size: 28px; font-weight: 700; }
                        Text { text: "Коснитесь имени для входа"; color: Palette.n500; font-size: 15px; }
                    }
                }
                if root.operator-login-error != "": Rectangle {
                    height: 52px;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Palette.r300;
                    background: Palette.r50;
                    Text { text: root.operator-login-error; color: Palette.r700; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
                }
                ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    VerticalLayout {
                        spacing: 10px;
                        if root.operators.length == 0: Rectangle {
                            height: 170px;
                            border-radius: 22px;
                            border-width: 1px;
                            border-color: Palette.n200;
                            background: Palette.n50;
                            VerticalLayout {
                                alignment: center;
                                spacing: 12px;
                                VerticalIcon { icon-size: 44px; icon: @image-url("../assets/icons/user.png"); icon-color: Palette.n400; }
                                Text { text: "Операторы ещё не загружены"; color: Palette.n700; font-size: 18px; font-weight: 600; horizontal-alignment: center; }
                                Text { text: "Рабочий экран доступен без блокировки"; color: Palette.n500; font-size: 14px; horizontal-alignment: center; }
                            }
                        }
                        for operator[index] in root.operators: Rectangle {
                            height: root.short ? 64px : 76px;
                            border-radius: 18px;
                            border-width: operator.is-last ? 2px : 1px;
                            border-color: operator.is-last ? Palette.e400 : Palette.n300;
                            background: operator-row-touch.pressed ? Palette.e100 : operator-row-touch.has-hover ? Palette.e50 : operator.is-last ? #ecfdf580 : Palette.n50;
                            HorizontalLayout {
                                padding-left: 18px;
                                padding-right: 18px;
                                spacing: 14px;
                                Rectangle {
                                    width: 46px;
                                    vertical-stretch: 1;
                                    Rectangle {
                                        width: 46px;
                                        height: 46px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 23px;
                                        background: operator.is-last ? Palette.e100 : Palette.n100;
                                        AppIcon { width: 24px; height: 24px; x: 11px; y: 11px; icon: @image-url("../assets/icons/user.png"); icon-color: operator.is-last ? Palette.e600 : Palette.n500; }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;
                                    Text { text: operator.full-name; color: Palette.n900; font-size: 17px; font-weight: 700; overflow: elide; }
                                    Text { text: operator.short-code == "" ? "Без кода" : "Код " + operator.short-code; color: Palette.n500; font-family: "Consolas"; font-size: 12px; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: operator.has-pin ? "PIN" : "ВХОД"; color: Palette.e600; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                            }
                            operator-row-touch := TouchArea {
                                enabled: !root.operator-login-busy;
                                clicked => { root.operator-login-error = ""; root.select-operator(index); }
                            }
                        }
                    }
                }
                if root.operators.length == 0: MainButton {
                    text: "ПРОДОЛЖИТЬ БЕЗ ОПЕРАТОРА";
                    icon: @image-url("../assets/icons/check-circle2.png");
                    border-radius: 16px;
                    normal-color: Palette.n700;
                    hover-color: Palette.n600;
                    pressed-color: Palette.n800;
                    clicked => { root.continue-without-operator(); }
                }
            }
        }
    }

    if root.operator-pin-visible: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000cc;
        Rectangle {
            width: 460px;
            height: min(parent.height - 32px, 620px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 32px;
            border-width: 1px;
            border-color: Palette.n200;
            background: white;
            VerticalLayout {
                padding: 24px;
                spacing: 10px;
                Text { text: "Введите PIN"; color: Palette.n900; font-size: 26px; font-weight: 700; horizontal-alignment: center; }
                Text { text: root.selected-operator-name; color: Palette.n500; font-size: 16px; horizontal-alignment: center; overflow: elide; }
                Rectangle {
                    height: 58px;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: root.operator-login-error == "" ? Palette.e300 : Palette.r300;
                    background: root.operator-login-error == "" ? Palette.e50 : Palette.r50;
                    Text { text: root.operator-pin == "" ? "—" : "••••••"; color: Palette.e700; font-size: 25px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
                if root.operator-login-error != "": Text { height: 30px; text: root.operator-login-error; color: Palette.r700; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 9px;
                    KeyButton { horizontal-stretch: 1; text: "1"; clicked => { root.operator-pin += "1"; root.operator-login-error = ""; } }
                    KeyButton { horizontal-stretch: 1; text: "2"; clicked => { root.operator-pin += "2"; root.operator-login-error = ""; } }
                    KeyButton { horizontal-stretch: 1; text: "3"; clicked => { root.operator-pin += "3"; root.operator-login-error = ""; } }
                }
                HorizontalLayout {
                    spacing: 9px;
                    KeyButton { horizontal-stretch: 1; text: "4"; clicked => { root.operator-pin += "4"; root.operator-login-error = ""; } }
                    KeyButton { horizontal-stretch: 1; text: "5"; clicked => { root.operator-pin += "5"; root.operator-login-error = ""; } }
                    KeyButton { horizontal-stretch: 1; text: "6"; clicked => { root.operator-pin += "6"; root.operator-login-error = ""; } }
                }
                HorizontalLayout {
                    spacing: 9px;
                    KeyButton { horizontal-stretch: 1; text: "7"; clicked => { root.operator-pin += "7"; root.operator-login-error = ""; } }
                    KeyButton { horizontal-stretch: 1; text: "8"; clicked => { root.operator-pin += "8"; root.operator-login-error = ""; } }
                    KeyButton { horizontal-stretch: 1; text: "9"; clicked => { root.operator-pin += "9"; root.operator-login-error = ""; } }
                }
                HorizontalLayout {
                    spacing: 9px;
                    KeyButton { horizontal-stretch: 1; text: "ОЧИСТИТЬ"; clicked => { root.operator-pin = ""; root.operator-login-error = ""; } }
                    KeyButton { horizontal-stretch: 1; text: "0"; clicked => { root.operator-pin += "0"; root.operator-login-error = ""; } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    MainButton {
                        horizontal-stretch: 1;
                        text: "ОТМЕНА";
                        icon: @image-url("../assets/icons/x.png");
                        border-radius: 16px;
                        normal-color: Palette.n600;
                        hover-color: Palette.n500;
                        pressed-color: Palette.n700;
                        clicked => { root.operator-pin = ""; root.operator-pin-visible = false; root.operator-login-error = ""; }
                    }
                    MainButton {
                        horizontal-stretch: 1;
                        text: "ВОЙТИ";
                        icon: @image-url("../assets/icons/check-circle2.png");
                        border-radius: 16px;
                        enabled: root.operator-pin != "" && !root.operator-login-busy;
                        clicked => { root.submit-operator-pin(root.selected-operator-index, root.operator-pin); }
                    }
                }
            }
        }
    }
}
