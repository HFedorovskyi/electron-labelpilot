                        icon: @image-url("../assets/icons/trash2-red.png");
                        border-radius: 16px;
                        normal-color: Palette.r600;
                        hover-color: Palette.r500;
                        pressed-color: Palette.r700;
                        clicked => {
                            root.delete-modal-visible = false;
                            root.delete-last();
                        }
