import { LineEdit, ScrollView } from "std-widgets.slint";
import "../assets/fonts/Inter-Regular.ttf";
import "../assets/fonts/Inter-Bold.ttf";

global Palette {
    out property <color> n50: #fafafa;
    out property <color> n100: #f5f5f5;
    out property <color> n200: #e5e5e5;
    out property <color> n300: #d4d4d4;
    out property <color> n400: #a3a3a3;
    out property <color> n500: #737373;
    out property <color> n600: #525252;
    out property <color> n700: #404040;
    out property <color> n800: #262626;
    out property <color> n900: #171717;
    out property <color> e50: #ecfdf5;
    out property <color> e100: #d1fae5;
    out property <color> e200: #a7f3d0;
    out property <color> e300: #6ee7b7;
    out property <color> e400: #34d399;
    out property <color> e500: #10b981;
    out property <color> e600: #059669;
    out property <color> e700: #047857;
    out property <color> a50: #fffbeb;
    out property <color> a300: #fcd34d;
    out property <color> a500: #f59e0b;
    out property <color> a600: #d97706;
    out property <color> a700: #b45309;
    out property <color> r50: #fef2f2;
    out property <color> r100: #fee2e2;
    out property <color> r300: #fca5a5;
    out property <color> r400: #f87171;
    out property <color> r500: #ef4444;
    out property <color> r600: #dc2626;
    out property <color> r700: #b91c1c;
}

component AppIcon inherits Rectangle {
    in property <image> icon;
    in property <color> icon-color: Palette.n500;
    background: transparent;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.icon;
        image-fit: contain;
        colorize: root.icon-color;
    }
}

// Slint layouts align fixed-size children to the cross-axis origin. These
// slots occupy that cross-axis and keep the bitmap centered at any DPI.
component HorizontalIcon inherits Rectangle {
    in property <image> icon;
    in property <color> icon-color: Palette.n500;
    in property <length> icon-size: 20px;
    width: root.icon-size;
    vertical-stretch: 1;
    background: transparent;
    AppIcon {
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.icon;
        icon-color: root.icon-color;
    }
}

component VerticalIcon inherits Rectangle {
    in property <image> icon;
    in property <color> icon-color: Palette.n500;
    in property <length> icon-size: 20px;
    height: root.icon-size;
    horizontal-stretch: 1;
    background: transparent;
    AppIcon {
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.icon;
        icon-color: root.icon-color;
    }
}

component StatusDot inherits Rectangle {
    in property <color> dot-color: Palette.e500;
    in property <length> dot-size: 8px;
    width: root.dot-size;
    vertical-stretch: 1;
    background: transparent;
    Rectangle {
        width: root.dot-size;
        height: root.dot-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: root.dot-size / 2;
        background: root.dot-color;
    }
}

component SidebarItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active: false;
    in property <bool> collapsed: false;
    in property <bool> danger: false;
    callback clicked;

    height: root.danger ? 48px : 44px;
    border-radius: 12px;
    border-width: root.danger || root.active ? 1px : 0px;
    border-color: root.danger ? Palette.r300 : #10b98133;
    background: root.danger
        ? touch.pressed ? Palette.r300 : touch.has-hover ? Palette.r100 : Palette.r50
        : root.active ? #d1fae580 : touch.has-hover ? Palette.n100 : transparent;
    drop-shadow-color: root.danger ? #dc262622 : transparent;
    drop-shadow-blur: root.danger ? 10px : 0px;
    drop-shadow-offset-y: root.danger ? 2px : 0px;

    if root.collapsed: AppIcon {
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.icon;
        icon-color: root.danger ? Palette.r600 : root.active ? Palette.e600 : touch.has-hover ? Palette.n900 : Palette.n500;
    }
    if !root.collapsed: HorizontalLayout {
        alignment: start;
        spacing: 12px;
        padding-left: 16px;
        padding-right: 16px;
        HorizontalIcon {
            icon-size: 20px;
            icon: root.icon;
            icon-color: root.danger ? Palette.r600 : root.active ? Palette.e600 : touch.has-hover ? Palette.n900 : Palette.n500;
        }
        Text {
            text: root.text;
            color: root.danger ? Palette.r600 : root.active ? Palette.e600 : touch.has-hover ? Palette.n900 : Palette.n500;
            font-size: 14px;
            font-weight: root.danger ? 700 : 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component SidebarToggleButton inherits Rectangle {
    in property <image> icon;
    callback clicked;

    width: 42px;
    height: 42px;
    border-radius: 12px;
    border-width: 1px;
    border-color: touch.has-hover ? Palette.e300 : Palette.n200;
    background: touch.pressed ? Palette.e200 : touch.has-hover ? Palette.e50 : white;

    AppIcon {
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.icon;
        icon-color: touch.has-hover ? Palette.e700 : Palette.n600;
    }

    touch := TouchArea { clicked => { root.clicked(); } }
}
component MainButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <color> normal-color: Palette.e600;
    in property <color> hover-color: Palette.e500;
    in property <color> pressed-color: Palette.e700;
    in property <bool> enabled: true;
    in property <length> label-font-size: 20px;
    callback clicked;

    height: 56px;
    border-radius: 24px;
    background: !root.enabled ? #05966966 : touch.pressed ? root.pressed-color : touch.has-hover ? root.hover-color : root.normal-color;
    drop-shadow-color: root.enabled ? #10b98155 : transparent;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;

    HorizontalLayout {
        alignment: center;
        spacing: 12px;
        HorizontalIcon { icon-size: 24px; icon: root.icon; icon-color: white; }
        Text { text: root.text; color: white; font-size: root.label-font-size; font-weight: 700; vertical-alignment: center; overflow: elide; }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component TileButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <color> normal-color: Palette.n100;
    in property <color> hover-color: Palette.n200;
    in property <color> pressed-color: Palette.n300;
    in property <color> outline: Palette.n300;
    in property <color> foreground: Palette.n500;
    in property <bool> enabled: true;
    in property <bool> short: false;
    callback clicked;

    height: root.short ? 66px : 80px;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.outline;
    background: !root.enabled ? #f5f5f580 : touch.pressed ? root.pressed-color : touch.has-hover ? root.hover-color : root.normal-color;
    drop-shadow-color: #0000000d;
    drop-shadow-blur: 5px;
    drop-shadow-offset-y: 1px;

    VerticalLayout {
        alignment: center;
        spacing: root.short ? 4px : 8px;
        VerticalIcon {
            icon-size: root.short ? 21px : 24px;
            icon: root.icon;
            icon-color: root.enabled ? (touch.has-hover ? Palette.n800 : root.foreground) : Palette.n400;
        }
        Text {
            text: root.text;
            color: root.enabled ? (touch.has-hover ? Palette.n800 : root.foreground) : Palette.n400;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 1.2px;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component StatusPill inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> show-icon: false;
    in property <bool> good: true;
    in property <bool> neutral: false;
    in property <bool> compact: false;

    height: root.compact ? 34px : 38px;
    min-width: root.compact ? 110px : 142px;
    border-radius: root.compact ? 17px : 19px;
    border-width: 1px;
    border-color: root.neutral ? Palette.n300 : root.good ? #10b98133 : #ef444433;
    background: root.neutral ? Palette.n100 : root.good ? #10b9811a : #ef44441a;

    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        padding-left: root.compact ? 10px : 14px;
        padding-right: root.compact ? 10px : 14px;
        if root.show-icon: HorizontalIcon {
            icon-size: 14px;
            icon: root.icon;
            icon-color: root.neutral ? Palette.n500 : root.good ? Palette.e600 : Palette.r500;
        }
        if !root.show-icon: StatusDot {
            dot-size: 8px;
            dot-color: root.neutral ? Palette.n500 : root.good ? Palette.e500 : Palette.r500;
        }
        Text {
            text: root.text;
            color: root.neutral ? Palette.n600 : root.good ? Palette.e600 : Palette.r500;
            font-size: root.compact ? 12px : 14px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component ThinStatRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Palette.n900;
    in property <bool> compact: false;
    height: root.compact ? 24px : 28px;
    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.n200; }
    HorizontalLayout {
        spacing: 8px;
        Text {
            horizontal-stretch: 5;
            text: root.label;
            color: Palette.n600;
            font-size: root.compact ? 13px : 14px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            horizontal-stretch: 6;
            text: root.value;
            color: root.value-color;
            font-size: root.compact ? 13px : 14px;
            font-family: "Consolas";
            font-weight: 650;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component StatEditorRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <image> icon;
    in property <bool> compact: false;
    in property <bool> dense-label: false;
    callback clicked;

    height: root.compact ? 42px : 46px;
    border-radius: 12px;
    border-width: 1px;
    border-color: touch.has-hover ? Palette.e300 : Palette.n300;
    background: touch.pressed ? Palette.e100 : touch.has-hover ? Palette.e50 : Palette.n100;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Text { horizontal-stretch: 1; text: root.label; color: Palette.n500; font-size: root.dense-label ? 11px : 12px; font-weight: 700; letter-spacing: root.dense-label ? 0.35px : 0.8px; vertical-alignment: center; overflow: elide; }
        HorizontalLayout {
            alignment: end;
            spacing: 12px;
            Text { text: root.value; color: touch.has-hover ? Palette.e600 : Palette.n900; font-family: "Consolas"; font-size: 17px; font-weight: 700; vertical-alignment: center; }
            Rectangle {
                width: 34px;
                vertical-stretch: 1;
                Rectangle {
                    width: 34px;
                    height: 34px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: touch.has-hover ? Palette.e400 : Palette.n300;
                    background: touch.has-hover ? Palette.e100 : white;
                    AppIcon { width: 16px; height: 16px; x: 9px; y: 9px; icon: root.icon; icon-color: Palette.e600; }
                }
            }
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component KeyButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    height: 56px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Palette.n300;
    background: !root.enabled ? Palette.n100 : touch.pressed ? Palette.e100 : touch.has-hover ? Palette.e50 : Palette.n50;
    Text { text: root.text; color: root.enabled ? Palette.n900 : Palette.n400; font-size: 22px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component KeyboardKey inherits Rectangle {
    in property <string> text;
    in property <bool> compact: false;
    in property <bool> roomy: false;
    in property <bool> selected: false;
    in property <bool> primary: false;
    callback clicked;
    min-width: root.roomy ? 52px : root.compact ? 34px : 40px;
    height: root.roomy ? (root.compact ? 50px : 56px) : root.compact ? 42px : 46px;
    border-radius: root.roomy ? 14px : root.compact ? 9px : 11px;
    border-width: 1px;
    border-color: root.selected || root.primary ? Palette.e500 : Palette.n300;
    background: touch.pressed ? Palette.e200 : root.primary ? Palette.e600 : root.selected ? Palette.e100 : touch.has-hover ? Palette.e50 : white;
    Text {
        text: root.text;
        color: root.primary ? white : root.selected ? Palette.e700 : Palette.n800;
        font-size: root.roomy ? 19px : root.compact ? 14px : 16px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component TouchKeyboard inherits Rectangle {
    in-out property <int> layout: 0;
    in-out property <bool> uppercase: false;
    in property <bool> compact: false;
    in property <bool> roomy: false;
    in property <string> space-label: "ПРОБЕЛ";
    in property <string> clear-label: "ОЧИСТИТЬ";
    in property <string> done-label: "ГОТОВО";
    callback key-pressed(string, bool);
    callback backspace;
    callback clear;
    callback done;

    height: root.roomy ? (root.compact ? 300px : 330px) : root.compact ? 242px : 266px;
    border-radius: 16px;
    border-width: 1px;
    border-color: Palette.n300;
    background: Palette.n100;

    VerticalLayout {
        padding: root.roomy ? 12px : root.compact ? 8px : 10px;
        spacing: root.roomy ? 6px : 4px;

        HorizontalLayout {
            spacing: root.roomy ? 6px : 4px;
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Ё" : "1"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Ә" : "2"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Ғ" : "3"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Қ" : "4"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Ң" : "5"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Ө" : "6"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Ұ" : "7"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Ү" : "8"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Һ" : "9"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "І" : "0"; clicked => { root.key-pressed(self.text, root.uppercase); } }
        }
        HorizontalLayout {
            spacing: root.roomy ? 6px : 4px;
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Й" : root.layout == 1 ? "Q" : "-"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Ц" : root.layout == 1 ? "W" : "_"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "У" : root.layout == 1 ? "E" : "/"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "К" : root.layout == 1 ? "R" : "*"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Е" : root.layout == 1 ? "T" : "."; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Н" : root.layout == 1 ? "Y" : ","; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Г" : root.layout == 1 ? "U" : ":"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Ш" : root.layout == 1 ? "I" : ";"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Щ" : root.layout == 1 ? "O" : "("; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "З" : root.layout == 1 ? "P" : ")"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Х" : root.layout == 1 ? "-" : "№"; clicked => { root.key-pressed(self.text, root.uppercase); } }
        }
        HorizontalLayout {
            spacing: root.roomy ? 6px : 4px;
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Ф" : root.layout == 1 ? "A" : "+"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Ы" : root.layout == 1 ? "S" : "="; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "В" : root.layout == 1 ? "D" : "×"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "А" : root.layout == 1 ? "F" : "÷"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "П" : root.layout == 1 ? "G" : "%"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Р" : root.layout == 1 ? "H" : "#"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "О" : root.layout == 1 ? "J" : "@"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Л" : root.layout == 1 ? "K" : "!"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Д" : root.layout == 1 ? "L" : "?"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Ж" : root.layout == 1 ? "@" : "&"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Э" : root.layout == 1 ? "#" : "$"; clicked => { root.key-pressed(self.text, root.uppercase); } }
        }
        HorizontalLayout {
            spacing: root.roomy ? 6px : 4px;
            KeyboardKey { roomy: root.roomy; compact: root.compact; selected: root.uppercase; text: "⇧"; clicked => { root.uppercase = !root.uppercase; } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Я" : root.layout == 1 ? "Z" : "["; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Ч" : root.layout == 1 ? "X" : "]"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "С" : root.layout == 1 ? "C" : "{"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "М" : root.layout == 1 ? "V" : "}"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "И" : root.layout == 1 ? "B" : "<"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Т" : root.layout == 1 ? "N" : ">"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Ь" : root.layout == 1 ? "M" : "^"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Б" : root.layout == 1 ? "." : "~"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; text: root.layout == 0 ? "Ю" : root.layout == 1 ? "@" : "|"; clicked => { root.key-pressed(self.text, root.uppercase); } }
            KeyboardKey { roomy: root.roomy; compact: root.compact; text: "⌫"; clicked => { root.backspace(); } }
        }
        HorizontalLayout {
            spacing: root.roomy ? 6px : 4px;
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; selected: root.layout == 0; text: "АБВ"; clicked => { root.layout = 0; root.uppercase = false; } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; selected: root.layout == 1; text: "ABC"; clicked => { root.layout = 1; root.uppercase = false; } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 1; compact: root.compact; selected: root.layout == 2; text: "123"; clicked => { root.layout = 2; root.uppercase = false; } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 3; compact: root.compact; text: root.space-label; clicked => { root.key-pressed(" ", true); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 2; compact: root.compact; text: root.clear-label; clicked => { root.clear(); } }
            KeyboardKey { roomy: root.roomy; horizontal-stretch: 2; compact: root.compact; primary: true; text: root.done-label; clicked => { root.done(); } }
        }
    }
}
component TouchScrollStepButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> enabled: true;
    callback clicked;

    width: 52px;
    height: 52px;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.enabled ? Palette.e300 : Palette.n200;
    background: !root.enabled ? Palette.n100 : touch.pressed ? Palette.e200 : touch.has-hover ? Palette.e100 : white;
    Text {
        text: root.glyph;
        color: root.enabled ? Palette.e700 : Palette.n400;
        font-size: 22px;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component ContextHelpButton inherits Rectangle {
    in property <bool> selected: false;
    callback clicked;

    width: 34px;
    height: 34px;
    border-radius: 17px;
    border-width: 1px;
    border-color: root.selected ? Palette.e500 : Palette.n300;
    background: touch.pressed ? Palette.e200 : root.selected ? Palette.e100 : touch.has-hover ? Palette.e50 : white;
    Text {
        text: "?";
        color: root.selected ? Palette.e700 : Palette.n600;
        font-size: 17px;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component CompactActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <bool> primary: false;
    in property <length> text-size: 13px;
    callback clicked;
    min-width: 112px;
    height: 48px;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.danger ? Palette.r300 : root.primary ? Palette.e500 : Palette.n300;
    background: !root.enabled ? Palette.n100 : touch.pressed ? (root.danger ? Palette.r300 : Palette.e200) : touch.has-hover ? (root.danger ? Palette.r100 : Palette.e50) : root.primary ? Palette.e600 : white;
    Text {
        text: root.text;
        color: !root.enabled ? Palette.n400 : root.primary ? white : root.danger ? Palette.r600 : Palette.e700;
        font-size: root.text-size;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component SettingsChoiceButton inherits Rectangle {
    in property <string> text;
    in property <string> subtext: "";
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 52px;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.selected ? Palette.e500 : Palette.n300;
    background: !root.enabled ? Palette.n100 : touch.pressed ? Palette.e200 : root.selected ? Palette.e50 : touch.has-hover ? Palette.n100 : white;
    VerticalLayout {
        alignment: center;
        spacing: 1px;
        Text { text: root.text; color: !root.enabled ? Palette.n400 : root.selected ? Palette.e700 : Palette.n700; font-size: 13px; font-weight: 700; horizontal-alignment: center; overflow: elide; }
        if root.subtext != "": Text { text: root.subtext; color: root.selected ? Palette.e600 : Palette.n400; font-size: 10px; horizontal-alignment: center; overflow: elide; }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component SettingsSectionNav inherits Rectangle {
    in property <int> active-page;
    in property <bool> compact: false;
    in property <string> printers-label;
    in property <string> queue-label;
    in property <string> scales-label;
    in property <string> diagnostics-label;
    in property <string> print-category;
    in property <string> queue-category;
    in property <string> equipment-category;
    in property <string> system-category;
    callback open-printers;
    callback open-queue;
    callback open-scales;
    callback open-diagnostics;

    height: root.compact ? 58px : 64px;
    border-radius: 16px;
    border-width: 1px;
    border-color: Palette.n200;
    background: white;

    HorizontalLayout {
        padding: 5px;
        spacing: 6px;
        SettingsChoiceButton {
            horizontal-stretch: 1;
            height: root.compact ? 46px : 52px;
            text: root.printers-label;
            subtext: root.print-category;
            selected: root.active-page == 3;
            clicked => { root.open-printers(); }
        }
        SettingsChoiceButton {
            horizontal-stretch: 1;
            height: root.compact ? 46px : 52px;
            text: root.queue-label;
            subtext: root.queue-category;
            selected: root.active-page == 1;
            clicked => { root.open-queue(); }
        }
        SettingsChoiceButton {
            horizontal-stretch: 1;
            height: root.compact ? 46px : 52px;
            text: root.scales-label;
            subtext: root.equipment-category;
            selected: root.active-page == 4;
            clicked => { root.open-scales(); }
        }
        SettingsChoiceButton {
            horizontal-stretch: 1;
            height: root.compact ? 46px : 52px;
            text: root.diagnostics-label;
            subtext: root.system-category;
            selected: root.active-page == 2;
            clicked => { root.open-diagnostics(); }
        }
    }
}
