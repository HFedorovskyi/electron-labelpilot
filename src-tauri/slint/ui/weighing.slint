    property <string> update-available-label: root.ui-language == "en" ? "AVAILABLE" : root.ui-language == "de" ? "VERFÜGBAR" : root.ui-language == "uk" ? "ДОСТУПНО" : "ДОСТУПНО";
    property <string> update-ready-label: root.ui-language == "en" ? "READY" : root.ui-language == "de" ? "BEREIT" : root.ui-language == "uk" ? "ГОТОВО" : "ГОТОВО";
    property <string> update-current-message-label: root.ui-language == "en" ? "The latest version is installed" : root.ui-language == "de" ? "Die neueste Version ist installiert" : root.ui-language == "uk" ? "Встановлено останню версію" : "Установлена последняя версия";
    property <string> update-changes-label: root.ui-language == "en" ? "WHAT'S NEW" : root.ui-language == "de" ? "NEUERUNGEN" : root.ui-language == "uk" ? "ЩО НОВОГО" : "ЧТО НОВОГО";
    property <string> update-check-label: root.ui-language == "en" ? "CHECK FOR UPDATES" : root.ui-language == "de" ? "NACH UPDATES SUCHEN" : root.ui-language == "uk" ? "ПЕРЕВІРИТИ ОНОВЛЕННЯ" : "ПРОВЕРИТЬ ОБНОВЛЕНИЯ";
    property <string> update-checking-label: root.ui-language == "en" ? "CHECKING…" : root.ui-language == "de" ? "PRÜFUNG…" : root.ui-language == "uk" ? "ПЕРЕВІРКА…" : "ПРОВЕРКА…";
    property <string> update-download-label: root.ui-language == "en" ? "DOWNLOAD" : root.ui-language == "de" ? "HERUNTERLADEN" : root.ui-language == "uk" ? "ЗАВАНТАЖИТИ" : "СКАЧАТЬ";
    property <string> update-install-label: root.ui-language == "en" ? "INSTALL AND RESTART" : root.ui-language == "de" ? "INSTALLIEREN UND NEUSTARTEN" : root.ui-language == "uk" ? "ВСТАНОВИТИ Й ПЕРЕЗАПУСТИТИ" : "УСТАНОВИТЬ И ПЕРЕЗАПУСТИТЬ";
    property <string> update-usb-label: root.ui-language == "en" ? "UPDATE FROM USB" : root.ui-language == "de" ? "VON USB AKTUALISIEREN" : root.ui-language == "uk" ? "ОНОВИТИ З USB" : "ОБНОВИТЬ С USB";
    property <string> update-usb-hide-label: root.ui-language == "en" ? "HIDE USB UPDATE" : root.ui-language == "de" ? "USB-AKTUALISIERUNG AUSBLENDEN" : root.ui-language == "uk" ? "СХОВАТИ USB-ОНОВЛЕННЯ" : "СКРЫТЬ USB-ОБНОВЛЕНИЕ";
    property <string> update-usb-path-label: root.ui-language == "en" ? "Path to update file" : root.ui-language == "de" ? "Pfad zur Aktualisierungsdatei" : root.ui-language == "uk" ? "Шлях до файлу оновлення" : "Путь к файлу обновления";
    property <string> update-usb-check-label: root.ui-language == "en" ? "CHECK FILE" : root.ui-language == "de" ? "DATEI PRÜFEN" : root.ui-language == "uk" ? "ПЕРЕВІРИТИ ФАЙЛ" : "ПРОВЕРИТЬ ФАЙЛ";
    property <string> update-protection-title-label: root.ui-language == "en" ? "UPDATE PROTECTION" : root.ui-language == "de" ? "UPDATE-SCHUTZ" : root.ui-language == "uk" ? "ЗАХИСТ ОНОВЛЕННЯ" : "ЗАЩИТА ОБНОВЛЕНИЯ";
    property <string> update-protection-ready-label: root.ui-language == "en" ? "Previous version saved" : root.ui-language == "de" ? "Vorherige Version gespeichert" : root.ui-language == "uk" ? "Попередню версію збережено" : "Предыдущая версия сохранена";
    property <string> update-protection-planned-label: root.ui-language == "en" ? "Backup will be created before installation" : root.ui-language == "de" ? "Sicherung wird vor der Installation erstellt" : root.ui-language == "uk" ? "Резервну копію буде створено перед установленням" : "Резервная копия будет создана перед установкой";
    property <string> update-protection-message-label: root.ui-language == "en" ? "If startup verification fails, the working version is restored automatically." : root.ui-language == "de" ? "Wenn die Startprüfung fehlschlägt, wird die funktionierende Version automatisch wiederhergestellt." : root.ui-language == "uk" ? "Якщо перевірка запуску не пройде, робочу версію буде відновлено автоматично." : "Если проверка запуска не пройдёт, рабочая версия восстановится автоматически.";
    property <string> update-manual-restore-label: root.ui-language == "en" ? "RESTORE PREVIOUS VERSION" : root.ui-language == "de" ? "VORHERIGE VERSION WIEDERHERSTELLEN" : root.ui-language == "uk" ? "ВІДНОВИТИ ПОПЕРЕДНЮ ВЕРСІЮ" : "ВОССТАНОВИТЬ ПРЕДЫДУЩУЮ ВЕРСИЮ";
    property <string> update-restore-title-label: root.ui-language == "en" ? "Restore previous version?" : root.ui-language == "de" ? "Vorherige Version wiederherstellen?" : root.ui-language == "uk" ? "Відновити попередню версію?" : "Восстановить предыдущую версию?";
    property <string> update-restore-message-label: root.ui-language == "en" ? "The application, database, settings and print queue will return to their state before the last update. The current state will be saved as an emergency backup." : root.ui-language == "de" ? "Anwendung, Datenbank, Einstellungen und Druckwarteschlange werden auf den Stand vor dem letzten Update zurückgesetzt. Der aktuelle Stand wird als Notfallkopie gespeichert." : root.ui-language == "uk" ? "Програма, база даних, налаштування та черга друку повернуться до стану перед останнім оновленням. Поточний стан буде збережено як аварійну копію." : "Программа, база данных, настройки и очередь печати вернутся к состоянию перед последним обновлением. Текущее состояние будет сохранено как аварийная копия.";
    property <string> update-restore-restart-label: root.ui-language == "en" ? "The application will restart automatically." : root.ui-language == "de" ? "Die Anwendung wird automatisch neu gestartet." : root.ui-language == "uk" ? "Програма перезапуститься автоматично." : "Приложение перезапустится автоматически.";
    property <string> update-restore-back-label: root.ui-language == "en" ? "BACK" : root.ui-language == "de" ? "ZURÜCK" : root.ui-language == "uk" ? "НАЗАД" : "НАЗАД";
    property <string> update-restore-confirm-label: root.ui-language == "en" ? "RESTORE" : root.ui-language == "de" ? "WIEDERHERSTELLEN" : root.ui-language == "uk" ? "ВІДНОВИТИ" : "ВОССТАНОВИТЬ";


    in-out property <bool> confirm-print-action-visible: false;
    in-out property <string> confirm-print-action: "";
    in-out property <string> confirm-print-job-id: "";
    in-out property <string> confirm-print-job-title: "";
    in-out property <bool> confirm-print-uncertain: false;
    in-out property <bool> product-modal-visible: false;
    in-out property <bool> touch-keyboard-visible: false;
    in-out property <int> touch-keyboard-layout: 0;
    in-out property <bool> touch-keyboard-uppercase: false;
    property <bool> keypad-visible: false;
    in-out property <bool> date-modal-visible: false;
    property <bool> delete-modal-visible: false;
    property <bool> sidebar-collapsed: false;
    in-out property <bool> compact: false;
    in-out property <bool> narrow: false;
    in-out property <bool> short: false;
    in-out property <bool> wide: false;
    in-out property <bool> tall: false;
    property <bool> effective-collapsed: root.sidebar-collapsed || root.compact;
    property <length> sidebar-width: root.effective-collapsed ? (root.narrow ? 64px : 72px) : root.wide ? 280px : 256px;
    property <length> content-padding: root.narrow ? (root.short ? 12px : 16px) : root.compact ? 24px : root.wide ? 48px : 36px;
    property <length> shell-width: root.width;
    property <length> work-area-width: root.shell-width - root.sidebar-width;
    property <length> page-width: root.wide ? min(root.work-area-width, 1920px) : root.work-area-width;
    property <length> page-offset: (root.work-area-width - root.page-width) / 2;
    property <length> page-gap: root.narrow ? 16px : root.wide ? 28px : 24px;
    property <length> right-panel-width: (root.page-width - root.content-padding * 2 - root.page-gap) / 3;
    property <length> dialog-margin: root.short ? 12px : root.narrow ? 16px : 32px;
    property <length> dialog-max-height: root.height - root.dialog-margin * 2;
    property <length> small-dialog-width: min(root.width - root.dialog-margin * 2, root.wide ? 560px : 470px);
    property <length> medium-dialog-width: min(root.width - root.dialog-margin * 2, root.wide ? 760px : 620px);
    property <length> large-dialog-width: min(root.width - root.dialog-margin * 2, root.wide ? 900px : 720px);
    property <length> operator-dialog-width: min(root.width - root.dialog-margin * 2, root.wide ? 1040px : 760px);
    property <length> operator-dialog-height: min(root.dialog-max-height, root.tall ? 840px : 700px);

    callback print-label;
    callback repeat-print;
    callback close-box;
    callback print-pallet;
    callback delete-last;
    callback quit-app;
    callback open-date-calendar;
    callback shift-calendar-month(int);
    callback select-product(int);
    callback search-products(string);
    callback edit-touch-text(string, string, bool) -> string;
    callback select-operator(int);
    callback submit-operator-pin(int, string);
    callback continue-without-operator;
    callback switch-operator;
    callback refresh-print-queue;
    callback retry-print-job(string);
    callback cancel-print-job(string);
    callback probe-printers;
    callback reload-printer-settings;
    callback select-printer-role(string);
    callback save-printer-settings;
    callback detect-printer-settings;
    callback test-printer-settings;
    callback reload-scale-settings;
    callback save-scale-settings;
    callback test-scale-settings;
    callback reload-fixed-weight;
    callback search-fixed-products(string);
    callback select-fixed-product(int);
    callback edit-fixed-copies(string, string) -> string;
    callback step-fixed-copies(string, int) -> string;
    callback print-fixed-weight;
    callback start-fixed-batch;
    callback cancel-fixed-batch;
    callback reload-production-jobs;
    callback select-production-job(int);
    callback print-production-job-pack;
    callback complete-production-job;
    callback delete-production-job;
    callback reload-catalog;
    callback search-catalog(string);
    callback load-more-catalog;
    callback select-catalog-product(int);
    callback reload-license;
    callback save-server-address(string);
    callback check-update;
    callback download-update;
    callback install-update;
    callback rollback-update;
    callback stage-offline-update(string);


    HorizontalLayout {
        width: root.shell-width;
        height: parent.height;
        x: (parent.width - self.width) / 2;
        spacing: 0px;

        Rectangle {
            width: root.sidebar-width;
            background: #ffffffee;
            border-width: 1px;
            border-color: Palette.n200;

            VerticalLayout {
                padding-left: root.short ? 8px : root.effective-collapsed ? 12px : 16px;
                padding-right: root.short ? 8px : root.effective-collapsed ? 12px : 16px;
                padding-top: root.short ? 8px : root.effective-collapsed ? 12px : 16px;
                padding-bottom: root.short ? 8px : root.effective-collapsed ? 12px : 16px;
                spacing: 0px;

                header := Rectangle {
                    height: root.short ? 66px : root.effective-collapsed ? 72px : 92px;
                    background: transparent;
                    border-radius: 14px;

                    if root.effective-collapsed: SidebarToggleButton {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("../assets/icons/sidebar-expand.svg");
                        clicked => { root.sidebar-collapsed = !root.sidebar-collapsed; }
                    }

                    if !root.effective-collapsed: HorizontalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 10px;

                        Rectangle {
                            width: 46px;
                            vertical-stretch: 1;
                            background: transparent;
                            Image {
                                width: 44px;
                                height: 44px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("../assets/sidebar-logo.svg");
                                image-fit: contain;
                            }
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: "LabelPilot";
                            color: Palette.n900;
                            font-size: 20px;
                            font-weight: 800;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Rectangle {
                            width: 42px;
                            vertical-stretch: 1;
                            background: transparent;
                            SidebarToggleButton {
                                y: (parent.height - self.height) / 2;
                                icon: @image-url("../assets/icons/sidebar-collapse.svg");
                                clicked => { root.sidebar-collapsed = !root.sidebar-collapsed; }
                            }
                        }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    VerticalLayout {
                        spacing: root.short ? 4px : 8px;
                        SidebarItem {
                            text: "Весовая станция";
                            icon: @image-url("../assets/icons/scale-green.png");
                            active: root.active-page == 0;
                            collapsed: root.effective-collapsed;
                            clicked => { root.active-page = 0; }
                        }
                        SidebarItem {
                            text: "Фиксированный вес";
                            icon: @image-url("../assets/icons/weight.png");
                            active: root.active-page == 5;
                            collapsed: root.effective-collapsed;
                            clicked => { root.active-page = 5; root.reload-fixed-weight(); }
                        }
                        SidebarItem {
                            text: "Задания на печать";
                            icon: @image-url("../assets/icons/clipboard-list.png");
                            active: root.active-page == 6;
                            collapsed: root.effective-collapsed;
                            clicked => { root.active-page = 6; root.production-job-marking-visible = false; root.production-jobs-scroll-y = 0px; root.reload-production-jobs(); }
                        }
                        SidebarItem {
                            text: "Товары";
                            icon: @image-url("../assets/icons/package.png");
                            active: root.active-page == 7;
                            collapsed: root.effective-collapsed;
                            clicked => {
                                root.active-page = 7;
                                root.catalog-detail-visible = false;
                                root.catalog-detail-scroll-y = 0px;
                                root.reload-catalog();
                            }
                        }
                        SidebarItem {
                            text: "Лицензия";
                            icon: @image-url("../assets/icons/key-round.png");
                            active: root.active-page == 8;
                            collapsed: root.effective-collapsed;
                            clicked => { root.active-page = 8; root.reload-license(); }
                        }
                        SidebarItem {
                            text: "Обновление";
                            icon: @image-url("../assets/icons/refresh-cw.png");
                            active: root.active-page == 9;
                            collapsed: root.effective-collapsed;
                            clicked => { root.active-page = 9; root.check-update(); }
                        }
                        SidebarItem {
                            text: "Настройки";
                            icon: @image-url("../assets/icons/settings.png");
                            active: root.active-page == 1 || root.active-page == 2 || root.active-page == 3 || root.active-page == 4;
                            collapsed: root.effective-collapsed;
                            clicked => { root.active-page = 3; root.reload-printer-settings(); root.reload-scale-settings(); }
                        }
                    }
                }

                Rectangle { height: root.short ? 5px : 8px; }
                SidebarItem {
                    text: root.exit-label;
                    icon: @image-url("../assets/icons/log-out-red.png");
                    collapsed: root.effective-collapsed;
                    danger: true;
                    clicked => { root.quit-app(); }
                }


                Rectangle { height: root.short ? 5px : 8px; }
                Rectangle {
                    height: root.short ? (root.effective-collapsed ? 100px : 128px) : root.effective-collapsed ? 116px : 156px;
                    Rectangle { y: 0px; height: 1px; background: Palette.n200; }

                    VerticalLayout {
                        alignment: center;
                        padding-top: root.short ? 5px : 8px;
                        padding-bottom: root.short ? 5px : 7px;
                        spacing: root.short ? 4px : 6px;

                        if root.effective-collapsed: Rectangle {
                            width: root.short ? 30px : 34px;
                            height: root.short ? 30px : 34px;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: root.server-online ? Palette.e300 : Palette.r300;
                            background: root.server-online ? Palette.e50 : Palette.r50;
                            StatusDot {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                dot-size: 10px;
                                dot-color: root.server-online ? Palette.e500 : Palette.r500;
                            }
                        }

                        if root.effective-collapsed: Rectangle {
                            width: 40px;
                            height: root.short ? 22px : 24px;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Palette.n200;
                            background: Palette.n100;
                            Text {
                                text: root.station-number;
                                color: Palette.n700;
                                font-family: "Consolas";
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        if root.effective-collapsed: Rectangle {
                            width: 44px;
                            height: root.short ? 30px : 34px;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: collapsed-operator-touch.has-hover ? Palette.e300 : Palette.n200;
                            background: collapsed-operator-touch.pressed ? Palette.e100 : collapsed-operator-touch.has-hover ? Palette.e50 : white;
                            HorizontalIcon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                icon-size: 16px;
                                icon: @image-url("../assets/icons/user.png");
                            }
                            collapsed-operator-touch := TouchArea { clicked => { root.switch-operator(); } }
                        }

                        sidebar-info-card := Rectangle {
                            visible: !root.effective-collapsed;
                            width: root.sidebar-width - (root.short ? 16px : 32px) - 8px;
                            height: root.short ? 112px : 132px;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Palette.n200;
                            background: white;
                            clip: true;

                            VerticalLayout {
                                alignment: center;
                                padding-top: 2px;
                                padding-bottom: 2px;
                                spacing: 0px;

                                Rectangle {
                                    height: root.short ? 27px : 31px;
                                    horizontal-stretch: 1;
                                    background: root.server-online ? Palette.e50 : Palette.r50;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 6px;
                                        Text {
                                            text: root.sidebar-server-label;
                                            color: Palette.n600;
                                            font-size: 9px;
                                            font-weight: 750;
                                            letter-spacing: 0.6px;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        StatusDot {
                                            dot-size: 8px;
                                            dot-color: root.server-online ? Palette.e500 : Palette.r500;
                                        }
                                        Text {
                                            text: root.server-online ? root.sidebar-online-label : root.sidebar-offline-label;
                                            color: root.server-online ? Palette.e700 : Palette.r600;
                                            font-size: 11px;
                                            font-weight: 750;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Rectangle { height: 1px; horizontal-stretch: 1; background: Palette.n200; }
                                Rectangle {
                                    height: root.short ? 23px : 27px;
                                    horizontal-stretch: 1;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        Text {
                                            text: root.sidebar-station-label;
                                            color: Palette.n500;
                                            font-size: 9px;
                                            font-weight: 750;
                                            letter-spacing: 0.55px;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text {
                                            text: root.station-number;
                                            color: Palette.n800;
                                            font-family: "Consolas";
                                            font-size: 12px;
                                            font-weight: 700;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Rectangle { height: 1px; horizontal-stretch: 1; background: Palette.n200; }
                                Rectangle {
                                    height: root.short ? 23px : 27px;
                                    horizontal-stretch: 1;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        Text {
                                            text: root.sidebar-version-label;
                                            color: Palette.n500;
                                            font-size: 9px;
                                            font-weight: 750;
                                            letter-spacing: 0.4px;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text {
                                            text: root.update-current-version;
                                            color: Palette.n800;
                                            font-family: "Consolas";
                                            font-size: 11px;
                                            font-weight: 700;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Rectangle { height: 1px; horizontal-stretch: 1; background: Palette.n200; }
                                expanded-operator-row := Rectangle {
                                    height: root.short ? 30px : 36px;
                                    horizontal-stretch: 1;
                                    background: expanded-operator-touch.pressed ? Palette.e100 : expanded-operator-touch.has-hover ? Palette.e50 : white;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 6px;
                                        Text {
                                            text: root.sidebar-operator-label;
                                            color: Palette.n500;
                                            font-size: 9px;
                                            font-weight: 750;
                                            letter-spacing: 0.45px;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        HorizontalIcon {
                                            icon-size: 14px;
                                            icon: @image-url("../assets/icons/user.png");
                                        }
                                        Text {
                                            width: root.wide ? 108px : 88px;
                                            text: root.operator-name;
                                            color: expanded-operator-touch.has-hover ? Palette.e700 : Palette.n700;
                                            font-size: 11px;
                                            font-weight: 550;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    expanded-operator-touch := TouchArea { clicked => { root.switch-operator(); } }
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: Palette.n50;

            HorizontalLayout {
                width: root.page-width;
                x: (parent.width - self.width) / 2;
                padding: root.content-padding;
                spacing: root.page-gap;

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: Palette.n200;
                    background: white;
                    drop-shadow-color: #00000012;
                    drop-shadow-blur: 8px;
                    drop-shadow-offset-y: 2px;

                    VerticalLayout {
                        padding: root.narrow ? 16px : 20px;
                        spacing: root.short ? 10px : 16px;

                        VerticalLayout {
                            height: root.short ? 76px : 82px;
                            spacing: 6px;
                            HorizontalLayout {
                                height: root.short ? 32px : 36px;
                                Text {
                                    text: "Весовая станция";
                                    color: Palette.n900;
                                    font-size: root.compact ? 22px : 24px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            main-device-status-row := HorizontalLayout {
                                height: root.compact ? 34px : 38px;
                                spacing: root.short ? 6px : 8px;

                                StatusPill {
                                    horizontal-stretch: 1;
                                    height: parent.height;
                                    compact: root.compact;
                                    text: root.scale-status;
                                    good: root.scale-online;
                                    icon: @image-url("../assets/icons/scale.png");
                                    show-icon: true;
                                }
                                StatusPill {
                                    horizontal-stretch: 1;
                                    height: parent.height;
                                    compact: root.compact;
                                    text: root.printer-status;
                                    good: root.printer-ready;
                                    icon: @image-url("../assets/icons/printer.png");
                                    show-icon: true;
                                }
                                StatusPill {
                                    horizontal-stretch: 1;
                                    height: parent.height;
                                    compact: root.compact;
                                    text: root.auto-print-enabled && root.auto-print-status != "" ? root.auto-print-status : root.auto-print-enabled ? root.jobs-auto-print-on-label : root.jobs-auto-print-off-label;
                                    good: root.auto-print-enabled;
                                    neutral: !root.auto-print-enabled;
                                    icon: @image-url("../assets/icons/refresh-cw.png");
                                    show-icon: true;
                                }
                            }
                        }

                        VerticalLayout {
                            height: 84px;
                            spacing: 8px;
                            Text {
                                text: "Поиск товара";
                                color: Palette.n400;
                                font-size: 14px;
                                font-weight: 500;
                            }
                            product-picker := Rectangle {
                                height: 58px;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: Palette.n300;
                                background: product-touch.pressed ? Palette.n200 : product-touch.has-hover ? Palette.n100 : Palette.n50;

                                HorizontalLayout {
                                    padding-left: 20px;
                                    padding-right: 20px;
                                    Text {
                                        text: root.product-name;
                                        color: Palette.n900;
                                        font-size: root.narrow ? 15px : 18px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    HorizontalIcon {
                                        icon-size: 24px;
                                        icon: @image-url("../assets/icons/search.png");
                                        icon-color: Palette.n400;
                                    }
                                }
                                product-touch := TouchArea {
                                    clicked => { root.product-modal-visible = true; root.product-search = ""; root.product-scroll-y = 0px; root.touch-keyboard-visible = true; root.touch-keyboard-layout = root.ui-language == "en" || root.ui-language == "de" ? 1 : 0; root.touch-keyboard-uppercase = false; root.search-products(""); }
                                }
                            }
                        }

                        Rectangle {
                            height: root.narrow ? 130px : 140px;
                            border-radius: 16px;
                            border-width: 1px;
                            border-color: Palette.e200;
                            background: Palette.e50;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 6px;
                                Text {
                                    text: "НАИМЕНОВАНИЕ";
                                    color: Palette.e600;
                                    font-size: 14px;
                                    font-weight: 700;
                                    letter-spacing: 0.8px;
                                }
                                Text {
                                    text: root.product-name;
                                    color: Palette.e700;
                                    font-size: root.narrow ? 22px : 28px;
                                    font-weight: 700;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "АРТИКУЛ: " + (root.product-article == "" ? "—" : root.product-article) + "     СРОК ГОДНОСТИ: " + root.expiration-days;
                                    color: #34d39999;
                                    font-family: "Consolas";
                                    font-size: 14px;
                                }
                            }
                        }

                        HorizontalLayout {
                            height: root.short ? 140px : 158px;
                            spacing: 16px;

                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: Palette.n200;
                                background: Palette.n50;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Text {
                                        text: "ВЕС БРУТТО";
                                        color: Palette.n500;
                                        font-size: 12px;
                                        font-weight: 700;
                                        letter-spacing: 1.5px;
                                        horizontal-alignment: center;
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 5px;
                                        Text {
                                            text: root.gross-weight;
                                            color: Palette.e600;
                                            font-family: "Consolas";
                                            font-size: root.narrow ? 44px : 58px;
                                            font-weight: 300;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "кг";
                                            color: #10b98180;
                                            font-size: 24px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if root.stable: HorizontalLayout {
                                        alignment: center;
                                        spacing: 8px;
                                        StatusDot {
                                            dot-size: 4px;
                                            dot-color: Palette.e500;
                                        }
                                        Text {
                                            text: root.auto-print-enabled && root.auto-print-status != "" ? root.auto-print-status : "СТАБИЛЬНО";
                                            color: Palette.e600;
                                            font-size: 12px;
                                            font-weight: 700;
                                            letter-spacing: 1.4px;
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: Palette.n200;
                                background: Palette.n50;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Text {
                                        text: "ВЕС НЕТТО";
                                        color: Palette.n500;
                                        font-size: 12px;
                                        font-weight: 700;
                                        letter-spacing: 1.5px;
                                        horizontal-alignment: center;
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 5px;
                                        Text {
                                            text: root.net-weight;
                                            color: Palette.n700;
                                            font-family: "Consolas";
                                            font-size: root.narrow ? 44px : 58px;
                                            font-weight: 300;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "кг";
                                            color: Palette.n500;
                                            font-size: 24px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }
                }

                Rectangle {
                    width: root.right-panel-width;
                    background: transparent;

                    VerticalLayout {
                        width: root.right-panel-width;
                        height: parent.height;
                        spacing: 16px;

                            MainButton {
                                border-radius: 16px;
                                text: "ПЕЧАТЬ ЭТИКЕТКИ";
                                icon: @image-url("../assets/icons/printer-white.png");
                                clicked => { root.print-label(); }
                            }

                            HorizontalLayout {
                                width: root.right-panel-width;
                                spacing: 16px;
                                TileButton {
                                    width: (root.right-panel-width - 16px) / 2;
                                    text: "ПОВТОР";
                                    icon: @image-url("../assets/icons/refresh-cw.png");
                                    short: root.short;
                                    clicked => { root.repeat-print(); }
                                }
                                TileButton {
                                    horizontal-stretch: 1;
                                    text: "КОРОБ";
                                    icon: @image-url("../assets/icons/box.png");
                                    short: root.short;
                                    enabled: root.units-in-box > 0;
                                    clicked => { root.close-box(); }
                                }
                            }

                            HorizontalLayout {
                                width: root.right-panel-width;
                                spacing: 16px;
                                TileButton {
                                    width: (root.right-panel-width - 16px) / 2;
                                    text: "УДАЛИТЬ";
                                    icon: @image-url("../assets/icons/trash2-red.png");
                                    short: root.short;
                                    normal-color: Palette.r50;
                                    hover-color: Palette.r100;
                                    pressed-color: #fecaca;
                                    outline: Palette.r300;
                                    foreground: Palette.r600;
                                    clicked => { root.delete-modal-visible = true; }
                                }
                                Rectangle { width: (root.right-panel-width - 16px) / 2; background: transparent; }
                            }

                            MainButton {
                                height: 52px;
                                border-radius: 16px;
                                text: "ПАЛЛЕТНЫЙ ЛИСТ";
                                icon: @image-url("../assets/icons/layers-white.png");
                                normal-color: Palette.a600;
                                hover-color: Palette.a500;
                                pressed-color: Palette.a700;
                                clicked => { root.print-pallet(); }
                            }

                            Rectangle {
                                min-height: root.short ? 282px : 338px;
                                vertical-stretch: 1;
                                border-radius: 24px;
                                border-width: 1px;
                                border-color: Palette.n200;
                                background: white;
                                drop-shadow-color: #0000000d;
                                drop-shadow-blur: 5px;
                                drop-shadow-offset-y: 1px;

                                VerticalLayout {
                                    padding: root.short ? 12px : 16px;
                                    spacing: root.short ? 2px : 3px;
                                    Text {
                                        text: "СТАТИСТИКА СЕССИИ";
                                        color: Palette.n500;
                                        font-size: 14px;
                                        font-weight: 600;
                                        letter-spacing: 1.4px;
                                    }
                                    StatEditorRow {
                                        compact: root.short;
                                        label: "ПАРТИЯ";
                                        value: root.batch-number;
                                        icon: @image-url("../assets/icons/hash-green.png");
                                        clicked => { root.keypad-visible = true; }
                                    }
                                    StatEditorRow {
                                        compact: root.short;
                                        label: root.narrow ? "ДАТА ПРОИЗВ." : "ДАТА ПРОИЗВОДСТВА";
                                        dense-label: true;
                                        value: root.labeling-date;
                                        icon: @image-url("../assets/icons/calendar-green.png");
                                        clicked => {
                                            root.open-date-calendar();
                                            root.date-modal-visible = true;
                                        }
                                    }
                                    ThinStatRow {
                                        compact: root.short;
                                        label: "Упаковка №";
                                        value: root.pack-number;
                                        value-color: Palette.e600;
                                    }
                                    ThinStatRow {
                                        compact: root.short;
                                        label: "Короб №";
                                        value: root.box-number;
                                        value-color: Palette.e600;
                                    }
                                    VerticalLayout {
                                        height: root.short ? 34px : 42px;
                                        spacing: root.short ? 3px : 5px;
                                        HorizontalLayout {
                                            Text {
                                                text: "В коробе";
                                                color: Palette.n500;
                                                font-size: 14px;
                                            }
                                            Text {
                                                text: root.box-limit > 0 ? root.units-in-box + " / " + root.box-limit : root.units-in-box + " / —";
                                                color: Palette.n900;
                                                font-family: "Consolas";
                                                font-size: 14px;
                                                horizontal-alignment: right;
                                            }
                                        }
                                        Rectangle {
                                            height: 8px;
                                            border-radius: 4px;
                                            background: Palette.n200;
                                            clip: true;
                                            Rectangle {
                                                x: 0px;
                                                width: root.box-limit > 0 ? min(parent.width, parent.width * max(0, root.units-in-box) / root.box-limit) : 0px;
                                                height: parent.height;
                                                border-radius: 4px;
                                                background: root.units-in-box > root.box-limit && root.box-limit > 0 ? Palette.r500 : Palette.e500;
                                            }
                                        }
                                    }
                                    ThinStatRow {
                                        compact: root.short;
                                        label: "Коробов на паллете";
                                        value: root.boxes-on-pallet;
                                        value-color: Palette.a600;
                                    }
                                    ThinStatRow {
                                        compact: root.short;
                                        label: "Всего упаковок";
                                        value: root.total-units;
                                    }
                                }
                            }
                        }
                }
            }
        }
    }

    if root.active-page == 1: Rectangle {
        x: (parent.width - root.shell-width) / 2 + root.sidebar-width + root.page-offset;
        width: root.page-width;
        height: parent.height;
        background: Palette.n50;

        VerticalLayout {
            padding: root.content-padding;
            spacing: root.narrow ? 12px : 16px;
            SettingsSectionNav {
                active-page: root.active-page;
                compact: root.narrow || root.short;
                printers-label: root.settings-nav-printers-label;
                queue-label: root.settings-nav-queue-label;
                scales-label: root.settings-nav-scales-label;
                diagnostics-label: root.settings-nav-diagnostics-label;
                print-category: root.settings-nav-print-category;
                queue-category: root.settings-nav-queue-category;
                equipment-category: root.settings-nav-equipment-category;
                system-category: root.settings-nav-system-category;
                open-printers => { root.active-page = 3; root.reload-printer-settings(); }
                open-queue => { root.active-page = 1; root.refresh-print-queue(); }
                open-scales => { root.active-page = 4; root.reload-scale-settings(); }
                open-diagnostics => { root.active-page = 2; root.probe-printers(); }
            }

            Rectangle {
                height: 56px;
                background: transparent;
                VerticalLayout {
                    width: parent.width - 380px;
                    height: parent.height;
                    x: (parent.width - self.width) / 2;
                    alignment: center;
                    spacing: 2px;
                    Text { horizontal-stretch: 1; text: "Очередь печати"; color: Palette.n900; font-size: 26px; font-weight: 750; horizontal-alignment: center; overflow: elide; }
                    Text { horizontal-stretch: 1; text: root.queue-status; color: Palette.n500; font-size: 13px; horizontal-alignment: center; overflow: elide; }
                }
                CompactActionButton {
                    width: root.narrow ? 148px : 180px;
                    x: parent.width - self.width;
                    y: (parent.height - self.height) / 2;
                    text: root.queue-busy ? "ОБНОВЛЕНИЕ…" : "ОБНОВИТЬ";
                    primary: true;
                    enabled: !root.queue-busy;
                    clicked => { root.refresh-print-queue(); }
                }
            }

            HorizontalLayout {
                height: 78px;
                spacing: root.narrow ? 8px : 12px;
                QueueSummaryCard { label: "В РАБОТЕ"; value: root.queue-waiting; accent: Palette.a500; }
                QueueSummaryCard { label: "ПРИНЯТО"; value: root.queue-accepted; accent: Palette.e500; }
                QueueSummaryCard { label: "ТРЕБУЕТ РЕШЕНИЯ"; value: root.queue-problems; accent: Palette.r500; }
                QueueSummaryCard { label: "ВСЕГО"; value: root.queue-total; accent: Palette.n500; }
            }

            Rectangle {
                vertical-stretch: 1;
                border-radius: 20px;
                border-width: 1px;
                border-color: Palette.n200;
                background: white;
                clip: true;

                VerticalLayout {
                    padding: root.narrow ? 12px : 16px;
                    spacing: 10px;
                    Rectangle {
                        height: 28px;
                        background: transparent;
                        Text { width: parent.width; height: parent.height; text: "ПОСЛЕДНИЕ ЗАДАНИЯ"; color: Palette.n500; font-size: 12px; font-weight: 700; letter-spacing: 1px; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 130px; height: parent.height; x: parent.width - self.width; text: root.durable-jobs.length + " записей"; color: Palette.n400; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                    }
                    if root.durable-jobs.length == 0: Rectangle {
                        vertical-stretch: 1;
                        border-radius: 18px;
                        background: Palette.n50;
                        VerticalLayout {
                            alignment: center;
                            spacing: 12px;
                            VerticalIcon { icon-size: 46px; icon: @image-url("../assets/icons/list-restart.png"); icon-color: Palette.n400; }
                            Text { text: root.queue-busy ? "Загрузка очереди…" : "Очередь пуста"; color: Palette.n700; font-size: 19px; font-weight: 650; horizontal-alignment: center; }
                            Text { text: "Новые задания появятся здесь автоматически"; color: Palette.n500; font-size: 14px; horizontal-alignment: center; }
                        }
                    }
                    if root.durable-jobs.length > 0: ScrollView {
                        vertical-stretch: 1;
                        viewport-width: self.width;
                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                        mouse-drag-pan-enabled: true;
                        VerticalLayout {
                            spacing: 9px;
                            for job in root.durable-jobs: Rectangle {
                                height: root.narrow ? 118px : 108px;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: job.warning ? Palette.a300 : job.good ? Palette.e200 : job.state == "failed" ? Palette.r300 : Palette.n200;
                                background: job.warning ? Palette.a50 : job.good ? Palette.e50 : job.state == "failed" ? Palette.r50 : Palette.n50;
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 12px;
                                    spacing: 14px;
                                    StatusDot {
                                        dot-size: 12px;
                                        dot-color: job.warning ? Palette.a500 : job.good ? Palette.e500 : job.state == "failed" ? Palette.r500 : Palette.n400;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            spacing: 9px;
                                            Text { text: job.printer-name; color: Palette.n900; font-size: 16px; font-weight: 700; overflow: elide; }
                                            Rectangle {
                                                width: 116px;
                                                height: 28px;
                                                border-radius: 14px;
                                                background: job.warning ? #f59e0b22 : job.good ? #10b98122 : job.state == "failed" ? #ef444422 : Palette.n200;
                                                Text { text: job.state-label; color: job.warning ? Palette.a700 : job.good ? Palette.e700 : job.state == "failed" ? Palette.r700 : Palette.n600; font-size: 11px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                            }
                                        }
                                        Text { text: job.action + " · " + job.route + " · " + job.payload; color: Palette.n600; font-size: 13px; overflow: elide; }
                                        Text { text: "#" + job.short-id + " · попытка " + job.attempts + " · " + job.updated; color: Palette.n400; font-family: "Consolas"; font-size: 11px; overflow: elide; }
                                        if job.error != "": Text { text: job.error; color: job.warning ? Palette.a700 : Palette.r600; font-size: 11px; overflow: elide; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Rectangle {
                                        width: root.narrow ? 230px : 252px;
                                        vertical-stretch: 1;
                                        background: transparent;
                                        HorizontalLayout {
                                            width: parent.width;
                                            height: 48px;
                                            y: (parent.height - self.height) / 2;
                                            alignment: center;
                                            spacing: 8px;
                                            if job.can-retry: CompactActionButton {
                                                text: "ПОВТОРИТЬ";
                                                primary: !job.uncertain;
                                                clicked => {
                                                    root.confirm-print-action = "retry";
                                                    root.confirm-print-job-id = job.job-id;
                                                    root.confirm-print-job-title = job.short-id;
                                                    root.confirm-print-uncertain = job.uncertain;
                                                    root.confirm-print-action-visible = true;
                                                }
                                            }
                                            if job.can-cancel: CompactActionButton {
                                                text: "ОТМЕНИТЬ";
                                                danger: true;
                                                clicked => {
                                                    root.confirm-print-action = "cancel";
                                                    root.confirm-print-job-id = job.job-id;
                                                    root.confirm-print-job-title = job.short-id;
                                                    root.confirm-print-uncertain = false;
                                                    root.confirm-print-action-visible = true;
                                                }
                                            }
                                            if !job.can-retry && !job.can-cancel: Text {
                                                width: 116px;
                                                text: "ЗАВЕРШЕНО";
                                                color: Palette.n400;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.active-page == 2: Rectangle {
        x: (parent.width - root.shell-width) / 2 + root.sidebar-width + root.page-offset;
        width: root.page-width;
        height: parent.height;
        background: Palette.n50;

        VerticalLayout {
            padding: root.content-padding;
            spacing: root.narrow ? 12px : 16px;
            SettingsSectionNav {
                active-page: root.active-page;
                compact: root.narrow || root.short;
                printers-label: root.settings-nav-printers-label;
                queue-label: root.settings-nav-queue-label;
                scales-label: root.settings-nav-scales-label;
                diagnostics-label: root.settings-nav-diagnostics-label;
                print-category: root.settings-nav-print-category;
                queue-category: root.settings-nav-queue-category;
                equipment-category: root.settings-nav-equipment-category;
                system-category: root.settings-nav-system-category;
                open-printers => { root.active-page = 3; root.reload-printer-settings(); }
                open-queue => { root.active-page = 1; root.refresh-print-queue(); }
                open-scales => { root.active-page = 4; root.reload-scale-settings(); }
                open-diagnostics => { root.active-page = 2; root.probe-printers(); }
            }
            HorizontalLayout {
                height: 62px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    Text { text: "Диагностика принтеров"; color: Palette.n900; font-size: 26px; font-weight: 750; }
                    Text { text: root.diagnostics-status; color: Palette.n500; font-size: 13px; overflow: elide; }
                }
                Rectangle { horizontal-stretch: 1; }
                CompactActionButton {
                    width: root.narrow ? 168px : 210px;
                    text: root.diagnostics-busy ? "ПРОВЕРКА…" : "ПРОВЕРИТЬ ВСЕ";
                    primary: true;
                    enabled: !root.diagnostics-busy;
                    clicked => { root.probe-printers(); }
                }
            }

            Rectangle {
                height: 64px;
                border-radius: 16px;
                border-width: 1px;
                border-color: Palette.e200;
                background: Palette.e50;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 12px;
                    HorizontalIcon { icon-size: 26px; icon: @image-url("../assets/icons/stethoscope.png"); icon-color: Palette.e600; }
                    Text { text: "Проверка выполняется напрямую через TCP, Serial или очередь Windows. Рабочий экран остаётся отзывчивым."; color: Palette.e700; font-size: 13px; wrap: word-wrap; vertical-alignment: center; }
                }
            }

            ScrollView {
                vertical-stretch: 1;
                viewport-width: self.width;
                VerticalLayout {
                    spacing: 12px;
                    if root.printer-diagnostics.length == 0: Rectangle {
                        height: 260px;
                        border-radius: 22px;
                        border-width: 1px;
                        border-color: Palette.n200;
                        background: white;
                        VerticalLayout {
                            alignment: center;
                            spacing: 12px;
                            VerticalIcon { icon-size: 50px; icon: @image-url("../assets/icons/printer.png"); icon-color: Palette.n400; }
                            Text { text: root.diagnostics-busy ? "Опрашиваем оборудование…" : "Нажмите «Проверить все»"; color: Palette.n700; font-size: 19px; font-weight: 650; horizontal-alignment: center; }
                        }
                    }
                    for device in root.printer-diagnostics: Rectangle {
                        height: root.narrow ? 138px : 128px;
                        border-radius: 20px;
                        border-width: 1px;
                        border-color: !device.configured ? Palette.n300 : device.reachable ? Palette.e300 : Palette.r300;
                        background: !device.configured ? Palette.n100 : device.reachable ? Palette.e50 : Palette.r50;
                        HorizontalLayout {
                            padding: 18px;
                            spacing: 16px;
                            Rectangle {
                                width: 58px;
                                vertical-stretch: 1;
                                Rectangle {
                                    width: 58px;
                                    height: 58px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 18px;
                                    background: !device.configured ? Palette.n200 : device.reachable ? Palette.e100 : Palette.r100;
                                    AppIcon { width: 30px; height: 30px; x: 14px; y: 14px; icon: @image-url("../assets/icons/printer.png"); icon-color: !device.configured ? Palette.n500 : device.reachable ? Palette.e600 : Palette.r600; }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                Text { text: device.role-label; color: Palette.n500; font-size: 11px; font-weight: 750; letter-spacing: 0.8px; }
                                Text { text: device.printer-name; color: Palette.n900; font-size: 17px; font-weight: 700; overflow: elide; }
                                Text { text: device.transport + " · " + device.endpoint; color: Palette.n500; font-family: "Consolas"; font-size: 12px; overflow: elide; }
                                Text { text: device.details; color: device.reachable ? Palette.e700 : device.configured ? Palette.r700 : Palette.n500; font-size: 12px; overflow: elide; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout {
                                width: 170px;
                                alignment: center;
                                spacing: 6px;
                                Rectangle {
                                    height: 38px;
                                    border-radius: 19px;
                                    background: !device.configured ? Palette.n200 : device.reachable ? #10b98122 : #ef444422;
                                    Text { text: device.status-label; color: !device.configured ? Palette.n600 : device.reachable ? Palette.e700 : Palette.r700; font-size: 12px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                }
                                Text { text: device.queried; color: Palette.n400; font-size: 11px; horizontal-alignment: center; }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.active-page == 3: Rectangle {
        x: (parent.width - root.shell-width) / 2 + root.sidebar-width + root.page-offset;
        width: root.page-width;
        height: parent.height;
        background: Palette.n50;

        VerticalLayout {
            padding: root.content-padding;
            spacing: root.narrow ? 9px : 12px;

            SettingsSectionNav {
                active-page: root.active-page;
                compact: root.narrow || root.short;
                printers-label: root.settings-nav-printers-label;
                queue-label: root.settings-nav-queue-label;
                scales-label: root.settings-nav-scales-label;
                diagnostics-label: root.settings-nav-diagnostics-label;
                print-category: root.settings-nav-print-category;
                queue-category: root.settings-nav-queue-category;
                equipment-category: root.settings-nav-equipment-category;
                system-category: root.settings-nav-system-category;
                open-printers => { root.active-page = 3; root.reload-printer-settings(); }
                open-queue => { root.active-page = 1; root.refresh-print-queue(); }
                open-scales => { root.active-page = 4; root.reload-scale-settings(); }
                open-diagnostics => { root.active-page = 2; root.probe-printers(); }
            }

            HorizontalLayout {
                height: root.short ? 50px : 58px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.settings-page-title;
                        color: Palette.n900;
                        font-size: root.narrow ? 23px : 26px;
                        font-weight: 750;
                    }
                    Text {
                        text: root.settings-page-hint;
                        color: Palette.n500;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.settings-dirty: Rectangle {
                    width: root.narrow ? 132px : 150px;
                    height: 34px;
                    border-radius: 17px;
                    background: Palette.a50;
                    border-width: 1px;
                    border-color: Palette.a300;
                    Text {
                        text: root.settings-unsaved-label;
                        color: Palette.a700;
                        font-size: 10px;
                        font-weight: 750;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                CompactActionButton {
                    width: root.narrow ? 132px : 154px;
                    text: root.settings-refresh-label;
                    enabled: !root.settings-busy;
                    clicked => { root.reload-printer-settings(); }
                }
            }

            HorizontalLayout {
                height: root.short ? 82px : 96px;
                spacing: root.narrow ? 8px : 10px;
                for role in root.printer-settings-roles: Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 18px;
                    border-width: role.role == root.settings-selected-role ? 2px : 1px;
                    border-color: role.role == root.settings-selected-role ? Palette.e500 : Palette.n300;
                    background: role.role == root.settings-selected-role ? Palette.e50 : role-touch.has-hover ? Palette.n100 : white;
                    HorizontalLayout {
                        padding: root.short ? 10px : 13px;
                        spacing: 11px;
                        Rectangle {
                            width: root.short ? 40px : 46px;
                            vertical-stretch: 1;
                            Rectangle {
                                width: root.short ? 40px : 46px;
                                height: root.short ? 40px : 46px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 14px;
                                background: role.active ? Palette.e100 : Palette.n200;
                                AppIcon {
                                    width: 22px;
                                    height: 22px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    icon: @image-url("../assets/icons/printer.png");
                                    icon-color: role.active ? Palette.e600 : Palette.n500;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            Text {
                                text: role.role == "packPrinter" ? root.settings-pack-role-label : role.role == "boxPrinter" ? root.settings-box-role-label : root.settings-pallet-role-label;
                                color: Palette.n900;
                                font-size: 14px;
                                font-weight: 700;
                                overflow: elide;
                            }
                            Text {
                                text: role.role == "packPrinter" ? root.settings-pack-role-hint : role.role == "boxPrinter" ? root.settings-box-role-hint : root.settings-pallet-role-hint;
                                color: Palette.n500;
                                font-size: 11px;
                                overflow: elide;
                            }
                            Text {
                                text: role.active
                                    ? root.settings-enabled-label + " · " + (role.connection == "Ethernet" ? root.settings-network-label : role.connection == "Serial" ? root.settings-serial-label : root.settings-windows-label)
                                    : root.settings-disabled-label;
                                color: role.active ? Palette.e700 : Palette.n500;
                                font-size: 10px;
                                font-weight: 700;
                                overflow: elide;
                            }
                        }
                    }
                    role-touch := TouchArea {
                        enabled: !root.settings-busy;
                        clicked => { root.settings-system-printer-scroll-y = 0px; root.settings-serial-port-scroll-y = 0px; root.select-printer-role(role.role); }
                    }
                }
            }

            Rectangle {
                height: 50px;
                border-radius: 14px;
                border-width: 1px;
                border-color: Palette.n200;
                background: white;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 10px;
                    StatusDot { dot-size: 9px; dot-color: root.settings-active ? Palette.e500 : Palette.n400; }
                    Text {
                        text: root.settings-configuring-label + ":";
                        color: Palette.n500;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.settings-selected-role-display;
                        color: Palette.n900;
                        font-size: 14px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.settings-selected-role-hint;
                        color: Palette.n500;
                        font-size: 12px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            ScrollView {
                vertical-stretch: 1;
                viewport-width: self.width;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                mouse-drag-pan-enabled: true;

                VerticalLayout {
                    spacing: 12px;

                    if root.settings-selected-role == "packPrinter": Rectangle {
                        height: 96px;
                        border-radius: 18px;
                        border-width: 1px;
                        border-color: Palette.n200;
                        background: white;
                        VerticalLayout {
                            padding: 14px;
                            SettingsChoiceButton {
                                height: 68px;
                                text: root.settings-auto-print-label + ": " + (root.settings-auto-print ? root.settings-on-label : root.settings-off-label);
                                subtext: root.settings-auto-print-hint;
                                selected: root.settings-auto-print;
                                enabled: !root.settings-busy;
                                clicked => { root.settings-auto-print = !root.settings-auto-print; root.settings-dirty = true; }
                            }
                        }
                    }

                    Rectangle {
                        height: root.settings-connection == "tcp" ? 288px : 362px;
                        border-radius: 18px;
                        border-width: 1px;
                        border-color: Palette.n200;
                        background: white;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            VerticalLayout {
                                height: 40px;
                                spacing: 2px;
                                Text { text: root.settings-connection-title; color: Palette.n700; font-size: 13px; font-weight: 750; horizontal-alignment: center; }
                                Text { text: root.settings-connection-hint; color: Palette.n500; font-size: 11px; horizontal-alignment: center; overflow: elide; }
                            }
                            HorizontalLayout {
                                height: 64px;
                                spacing: 8px;
                                SettingsChoiceButton {
                                    horizontal-stretch: 1;
                                    height: 64px;
                                    text: root.settings-windows-label;
                                    subtext: root.settings-windows-hint;
                                    selected: root.settings-connection == "windows_driver";
                                    enabled: !root.settings-busy;
                                    clicked => { root.settings-connection = "windows_driver"; root.settings-system-printer-scroll-y = 0px; root.settings-dirty = true; }
                                }
                                SettingsChoiceButton {
                                    horizontal-stretch: 1;
                                    height: 64px;
                                    text: root.settings-network-label;
                                    subtext: root.settings-network-hint;
                                    selected: root.settings-connection == "tcp";
                                    enabled: !root.settings-busy;
                                    clicked => { root.settings-connection = "tcp"; root.settings-dirty = true; }
                                }
                                SettingsChoiceButton {
                                    horizontal-stretch: 1;
                                    height: 64px;
                                    text: root.settings-serial-label;
                                    subtext: root.settings-serial-hint;
                                    selected: root.settings-connection == "serial";
                                    enabled: !root.settings-busy;
                                    clicked => { root.settings-connection = "serial"; root.settings-serial-port-scroll-y = 0px; root.settings-dirty = true; }
                                }
                            }

                            if root.settings-connection == "tcp": HorizontalLayout {
                                height: 52px;
                                spacing: 8px;
                                LineEdit { horizontal-stretch: 1; text <=> root.settings-ip; placeholder-text: root.settings-address-placeholder; enabled: !root.settings-busy; edited => { root.settings-dirty = true; } }
                                CompactActionButton {
                                    width: 136px;
                                    text: root.keyboard-label;
                                    enabled: !root.settings-busy;
                                    clicked => {
                                        root.settings-input-target = "printer-ip";
                                        root.settings-input-caption = root.settings-printer-address-label;
                                        root.settings-input-draft = root.settings-ip;
                                        root.touch-keyboard-layout = 2;
                                        root.touch-keyboard-uppercase = false;
                                        root.settings-input-keyboard-visible = true;
                                    }
                                }
                                LineEdit { width: 118px; text <=> root.settings-port; placeholder-text: root.settings-port-placeholder; enabled: !root.settings-busy; edited => { root.settings-dirty = true; } }
                                CompactActionButton {
                                    width: 136px;
                                    text: root.keyboard-label;
                                    enabled: !root.settings-busy;
                                    clicked => {
                                        root.settings-input-target = "printer-port";
                                        root.settings-input-caption = root.settings-printer-port-label;
                                        root.settings-input-draft = root.settings-port;
                                        root.touch-keyboard-layout = 2;
                                        root.touch-keyboard-uppercase = false;
                                        root.settings-input-keyboard-visible = true;
                                    }
                                }
                            }
                            if root.settings-connection == "tcp": Rectangle {
                                height: 60px;
                                border-radius: 13px;
                                border-width: 1px;
                                border-color: Palette.e200;
                                background: Palette.e50;
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 12px;
                                    Text { width: 30px; text: "↔"; color: Palette.e700; font-size: 20px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text { text: root.settings-connection-auto-label; color: Palette.e700; font-size: 12px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        Text { text: root.settings-connection-auto-hint; color: Palette.n600; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                    }
                                }
                            }

                            if root.settings-connection == "windows_driver": Rectangle {
                                height: 52px;
                                border-radius: 13px;
                                border-width: 1px;
                                border-color: Palette.n200;
                                background: Palette.n50;
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 12px;
                                    Text { text: root.settings-selected-device-label; color: Palette.n500; font-size: 10px; font-weight: 750; vertical-alignment: center; }
                                    Text { horizontal-stretch: 1; text: root.settings-driver-name == "" ? root.settings-not-selected-label : root.settings-driver-name; color: root.settings-driver-name == "" ? Palette.n500 : Palette.n900; font-size: 13px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                }
                            }
                            if root.settings-connection == "windows_driver": HorizontalLayout {
                                height: 120px;
                                spacing: 8px;
                                printer-system-scroll := ScrollView {
                                    horizontal-stretch: 1;
                                    viewport-width: self.width;
                                    viewport-y <=> root.settings-system-printer-scroll-y;
                                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                    mouse-drag-pan-enabled: true;
                                    VerticalLayout {
                                        spacing: 6px;
                                        if root.settings-system-printers.length == 0: Text { height: 50px; text: root.settings-windows-empty-label; color: Palette.n500; font-size: 12px; vertical-alignment: center; horizontal-alignment: center; }
                                        for choice in root.settings-system-printers: Rectangle {
                                            height: 50px;
                                            border-radius: 12px;
                                            border-width: 1px;
                                            border-color: choice.value == root.settings-driver-name ? Palette.e400 : Palette.n200;
                                            background: choice.value == root.settings-driver-name ? Palette.e50 : Palette.n50;
                                            HorizontalLayout {
                                                padding-left: 14px;
                                                padding-right: 14px;
                                                spacing: 10px;
                                                Text { horizontal-stretch: 1; text: choice.label; color: Palette.n800; font-size: 12px; font-weight: 650; vertical-alignment: center; overflow: elide; }
                                                Text { width: 180px; text: choice.details; color: Palette.n400; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                                            }
                                            TouchArea { enabled: !root.settings-busy; clicked => { root.settings-driver-name = choice.value; root.settings-dirty = true; } }
                                        }
                                    }
                                }
                                if root.settings-system-printers.length > 2: VerticalLayout {
                                    width: 52px;
                                    TouchScrollStepButton { glyph: "▲"; enabled: root.settings-system-printer-scroll-y < 0px; clicked => { root.settings-system-printer-scroll-y = min(0px, root.settings-system-printer-scroll-y + 106px); } }
                                    Rectangle { vertical-stretch: 1; background: transparent; }
                                    TouchScrollStepButton { glyph: "▼"; enabled: printer-system-scroll.viewport-height > printer-system-scroll.visible-height && root.settings-system-printer-scroll-y > printer-system-scroll.visible-height - printer-system-scroll.viewport-height; clicked => { root.settings-system-printer-scroll-y = max(printer-system-scroll.visible-height - printer-system-scroll.viewport-height, root.settings-system-printer-scroll-y - 106px); } }
                                }
                            }

                            if root.settings-connection == "serial": HorizontalLayout {
                                height: 52px;
                                spacing: 8px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 13px;
                                    border-width: 1px;
                                    border-color: Palette.n200;
                                    background: Palette.n50;
                                    Text { text: root.settings-serial-port == "" ? root.settings-not-selected-label : root.settings-serial-port; color: root.settings-serial-port == "" ? Palette.n500 : Palette.n900; font-size: 13px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                }
                                LineEdit { width: 150px; text <=> root.settings-baud-rate; placeholder-text: root.settings-baud-placeholder; enabled: !root.settings-busy; edited => { root.settings-dirty = true; } }
                                CompactActionButton {
                                    width: 136px;
                                    text: root.keyboard-label;
                                    enabled: !root.settings-busy;
                                    clicked => {
                                        root.settings-input-target = "printer-baud";
                                        root.settings-input-caption = root.settings-serial-speed-label;
                                        root.settings-input-draft = root.settings-baud-rate;
                                        root.touch-keyboard-layout = 2;
                                        root.touch-keyboard-uppercase = false;
                                        root.settings-input-keyboard-visible = true;
                                    }
                                }
                            }
                            if root.settings-connection == "serial": HorizontalLayout {
                                height: 120px;
                                spacing: 8px;
                                printer-serial-scroll := ScrollView {
                                    horizontal-stretch: 1;
                                    viewport-width: self.width;
                                    viewport-y <=> root.settings-serial-port-scroll-y;
                                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                    mouse-drag-pan-enabled: true;
                                    VerticalLayout {
                                        spacing: 6px;
                                        if root.settings-serial-ports.length == 0: Text { height: 50px; text: root.settings-serial-empty-label; color: Palette.n500; font-size: 12px; vertical-alignment: center; horizontal-alignment: center; }
                                        for choice in root.settings-serial-ports: Rectangle {
                                            height: 50px;
                                            border-radius: 12px;
                                            border-width: 1px;
                                            border-color: choice.value == root.settings-serial-port ? Palette.e400 : Palette.n200;
                                            background: choice.value == root.settings-serial-port ? Palette.e50 : Palette.n50;
                                            HorizontalLayout {
                                                padding-left: 14px;
                                                padding-right: 14px;
                                                spacing: 10px;
                                                Text { horizontal-stretch: 1; text: choice.label; color: Palette.n800; font-size: 12px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                                Text { width: 180px; text: choice.details; color: Palette.n400; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                                            }
                                            TouchArea { enabled: !root.settings-busy; clicked => { root.settings-serial-port = choice.value; root.settings-dirty = true; } }
                                        }
                                    }
                                }
                                if root.settings-serial-ports.length > 2: VerticalLayout {
                                    width: 52px;
                                    TouchScrollStepButton { glyph: "▲"; enabled: root.settings-serial-port-scroll-y < 0px; clicked => { root.settings-serial-port-scroll-y = min(0px, root.settings-serial-port-scroll-y + 106px); } }
                                    Rectangle { vertical-stretch: 1; background: transparent; }
                                    TouchScrollStepButton { glyph: "▼"; enabled: printer-serial-scroll.viewport-height > printer-serial-scroll.visible-height && root.settings-serial-port-scroll-y > printer-serial-scroll.visible-height - printer-serial-scroll.viewport-height; clicked => { root.settings-serial-port-scroll-y = max(printer-serial-scroll.visible-height - printer-serial-scroll.viewport-height, root.settings-serial-port-scroll-y - 106px); } }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: root.settings-advanced-visible
                            ? 570px + (root.settings-language-help-visible ? 76px : 0px) + (root.settings-compatibility-help-visible ? 76px : 0px)
                            : 84px;
                        border-radius: 18px;
                        border-width: 1px;
                        border-color: Palette.n200;
                        background: white;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            HorizontalLayout {
                                height: 50px;
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: root.settings-advanced-title; color: Palette.n700; font-size: 13px; font-weight: 750; }
                                    Text { text: root.settings-advanced-hint; color: Palette.n500; font-size: 11px; overflow: elide; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                CompactActionButton {
                                    width: root.narrow ? 132px : 154px;
                                    text: root.settings-advanced-visible ? root.settings-hide-label : root.settings-show-label;
                                    enabled: !root.settings-busy;
                                    clicked => { root.settings-advanced-visible = !root.settings-advanced-visible; }
                                }
                            }

                            if root.settings-advanced-visible: HorizontalLayout {
                                height: 34px;
                                alignment: center;
                                spacing: 8px;
                                Text { text: root.settings-language-label; color: Palette.n500; font-size: 10px; font-weight: 750; letter-spacing: 0.7px; vertical-alignment: center; }
                                ContextHelpButton {
                                    selected: root.settings-language-help-visible;
                                    clicked => {
                                        root.settings-language-help-visible = !root.settings-language-help-visible;
                                        if root.settings-language-help-visible { root.settings-compatibility-help-visible = false; }
                                    }
                                }
                            }
                            if root.settings-advanced-visible && root.settings-language-help-visible: Rectangle {
                                height: 68px;
                                border-radius: 13px;
                                border-width: 1px;
                                border-color: Palette.e200;
                                background: Palette.e50;
                                Text { x: 16px; width: parent.width - 32px; text: root.settings-language-help-text; color: Palette.e700; font-size: 11px; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            if root.settings-advanced-visible: HorizontalLayout {
                                height: 52px;
                                spacing: 7px;
                                SettingsChoiceButton { horizontal-stretch: 1; text: "ZPL"; selected: root.settings-protocol == "zpl"; enabled: !root.settings-busy; clicked => { root.settings-protocol = "zpl"; root.settings-dirty = true; } }
                                SettingsChoiceButton { horizontal-stretch: 1; text: "TSPL"; selected: root.settings-protocol == "tspl"; enabled: !root.settings-busy; clicked => { root.settings-protocol = "tspl"; root.settings-dirty = true; } }
                                SettingsChoiceButton { horizontal-stretch: 1; text: "EPL"; selected: root.settings-protocol == "epl"; enabled: !root.settings-busy; clicked => { root.settings-protocol = "epl"; root.settings-dirty = true; } }
                                SettingsChoiceButton { horizontal-stretch: 1; text: "CPCL"; selected: root.settings-protocol == "cpcl"; enabled: !root.settings-busy; clicked => { root.settings-protocol = "cpcl"; root.settings-dirty = true; } }
                            }
                            if root.settings-advanced-visible: HorizontalLayout {
                                height: 52px;
                                spacing: 7px;
                                SettingsChoiceButton { horizontal-stretch: 1; text: "DPL"; selected: root.settings-protocol == "dpl"; enabled: !root.settings-busy; clicked => { root.settings-protocol = "dpl"; root.settings-dirty = true; } }
                                SettingsChoiceButton { horizontal-stretch: 1; text: "SBPL"; selected: root.settings-protocol == "sbpl"; enabled: !root.settings-busy; clicked => { root.settings-protocol = "sbpl"; root.settings-dirty = true; } }
                                SettingsChoiceButton { horizontal-stretch: 1; text: "ZPL BITMAP"; selected: root.settings-protocol == "image"; enabled: !root.settings-busy; clicked => { root.settings-protocol = "image"; root.settings-dirty = true; } }
                                SettingsChoiceButton { horizontal-stretch: 1; text: "WINDOWS"; selected: root.settings-protocol == "browser"; enabled: !root.settings-busy; clicked => { root.settings-protocol = "browser"; root.settings-dirty = true; } }
                            }

                            if root.settings-advanced-visible: HorizontalLayout {
                                height: 34px;
                                alignment: center;
                                spacing: 8px;
                                Text { text: root.settings-compatibility-label; color: Palette.n500; font-size: 10px; font-weight: 750; letter-spacing: 0.7px; vertical-alignment: center; }
                                ContextHelpButton {
                                    selected: root.settings-compatibility-help-visible;
                                    clicked => {
                                        root.settings-compatibility-help-visible = !root.settings-compatibility-help-visible;
                                        if root.settings-compatibility-help-visible { root.settings-language-help-visible = false; }
                                    }
                                }
                            }
                            if root.settings-advanced-visible && root.settings-compatibility-help-visible: Rectangle {
                                height: 68px;
                                border-radius: 13px;
                                border-width: 1px;
                                border-color: Palette.e200;
                                background: Palette.e50;
                                Text { x: 16px; width: parent.width - 32px; text: root.settings-compatibility-help-text; color: Palette.e700; font-size: 11px; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            if root.settings-advanced-visible: HorizontalLayout {
                                height: 52px;
                                spacing: 7px;
                                SettingsChoiceButton { horizontal-stretch: 1; text: root.settings-auto-label; subtext: root.settings-preview-profile; selected: root.settings-compatibility == "auto"; enabled: !root.settings-busy; clicked => { root.settings-compatibility = "auto"; root.settings-dirty = true; } }
                                SettingsChoiceButton { horizontal-stretch: 1; text: root.settings-compatible-label; selected: root.settings-compatibility == "compatible"; enabled: !root.settings-busy; clicked => { root.settings-compatibility = "compatible"; root.settings-dirty = true; } }
                                SettingsChoiceButton { horizontal-stretch: 1; text: root.settings-full-label; selected: root.settings-compatibility == "advanced"; enabled: !root.settings-busy; clicked => { root.settings-compatibility = "advanced"; root.settings-dirty = true; } }
                            }

                            if root.settings-advanced-visible: Text { height: 18px; text: root.settings-quality-label; color: Palette.n500; font-size: 10px; font-weight: 750; letter-spacing: 0.7px; horizontal-alignment: center; vertical-alignment: bottom; }
                            if root.settings-advanced-visible: HorizontalLayout {
                                height: 52px;
                                spacing: 7px;
                                SettingsChoiceButton { horizontal-stretch: 1; text: "203 DPI"; selected: root.settings-dpi == "203"; enabled: !root.settings-busy; clicked => { root.settings-dpi = "203"; root.settings-dirty = true; } }
                                SettingsChoiceButton { horizontal-stretch: 1; text: "300 DPI"; selected: root.settings-dpi == "300"; enabled: !root.settings-busy; clicked => { root.settings-dpi = "300"; root.settings-dirty = true; } }
                                SettingsChoiceButton { horizontal-stretch: 1; text: "600 DPI"; selected: root.settings-dpi == "600"; enabled: !root.settings-busy; clicked => { root.settings-dpi = "600"; root.settings-dirty = true; } }
                            }

                            if root.settings-advanced-visible: Text { height: 18px; text: root.settings-cache-label; color: Palette.n500; font-size: 10px; font-weight: 750; letter-spacing: 0.7px; horizontal-alignment: center; vertical-alignment: bottom; }
                            if root.settings-advanced-visible: HorizontalLayout {
                                height: 52px;
                                spacing: 7px;
                                SettingsChoiceButton { horizontal-stretch: 1; text: root.settings-auto-label; selected: root.settings-ram-cache == "auto"; enabled: !root.settings-busy; clicked => { root.settings-ram-cache = "auto"; root.settings-dirty = true; } }
                                SettingsChoiceButton { horizontal-stretch: 1; text: root.settings-on-label; selected: root.settings-ram-cache == "on"; enabled: !root.settings-busy; clicked => { root.settings-ram-cache = "on"; root.settings-dirty = true; } }
                                SettingsChoiceButton { horizontal-stretch: 1; text: root.settings-off-label; selected: root.settings-ram-cache == "off"; enabled: !root.settings-busy; clicked => { root.settings-ram-cache = "off"; root.settings-dirty = true; } }
                                SettingsChoiceButton { horizontal-stretch: 1; text: root.settings-z64 ? "Z64" : "RLE"; selected: root.settings-z64; enabled: !root.settings-busy; clicked => { root.settings-z64 = !root.settings-z64; root.settings-dirty = true; } }
                            }

                            if root.settings-advanced-visible: Rectangle {
                                height: 48px;
                                border-radius: 12px;
                                background: Palette.a50;
                                border-width: 1px;
                                border-color: Palette.a300;
                                Text { x: 14px; width: parent.width - 28px; text: root.settings-advanced-note; color: Palette.a700; font-size: 11px; wrap: word-wrap; vertical-alignment: center; horizontal-alignment: center; }
                            }
                        }
                    }

                    if root.settings-detection != "": Rectangle {
                        height: 58px;
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: Palette.e300;
                        background: Palette.e50;
                        Text {
                            text: root.settings-detection;
                            color: Palette.e700;
                            font-size: 12px;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }

                    Rectangle { height: 4px; background: transparent; }
                }
            }

            Rectangle {
                height: root.short ? 58px : 66px;
                border-radius: 16px;
                border-width: 1px;
                border-color: Palette.n200;
                background: white;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 9px;
                    if !root.narrow: Text {
                        horizontal-stretch: 1;
                        text: root.settings-busy ? root.settings-busy-label : root.settings-save-hint;
                        color: Palette.n500;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if root.narrow: Rectangle { horizontal-stretch: 1; }
                    CompactActionButton {
                        width: root.narrow ? 154px : 170px;
                        text: root.settings-test-label;
                        enabled: !root.settings-busy;
                        clicked => { root.test-printer-settings(); }
                    }
                    CompactActionButton {
                        width: root.narrow ? 194px : 218px;
                        text: root.settings-detect-label;
                        enabled: !root.settings-busy;
                        clicked => { root.detect-printer-settings(); }
                    }
                    CompactActionButton {
                        width: root.narrow ? 158px : 180px;
                        text: root.settings-busy ? root.settings-saving-label : root.settings-save-label;
                        primary: true;
                        enabled: !root.settings-busy;
                        clicked => { root.save-printer-settings(); }
                    }
                }
            }
        }
    }

    if root.active-page == 4: Rectangle {
        x: (parent.width - root.shell-width) / 2 + root.sidebar-width + root.page-offset;
        width: root.page-width;
        height: parent.height;
        background: Palette.n50;

        VerticalLayout {
            padding: root.content-padding;
            spacing: root.narrow ? 10px : 12px;

            SettingsSectionNav {
                active-page: root.active-page;
                compact: root.narrow || root.short;
                printers-label: root.settings-nav-printers-label;
                queue-label: root.settings-nav-queue-label;
                scales-label: root.settings-nav-scales-label;
                diagnostics-label: root.settings-nav-diagnostics-label;
                print-category: root.settings-nav-print-category;
                queue-category: root.settings-nav-queue-category;
                equipment-category: root.settings-nav-equipment-category;
                system-category: root.settings-nav-system-category;
                open-printers => { root.active-page = 3; root.reload-printer-settings(); }
                open-queue => { root.active-page = 1; root.refresh-print-queue(); }
                open-scales => { root.active-page = 4; root.reload-scale-settings(); }
                open-diagnostics => { root.active-page = 2; root.probe-printers(); }
            }

            Rectangle {
                height: 58px;
                background: transparent;
                if root.scale-settings-dirty: Rectangle {
                    width: 176px;
                    height: 34px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 17px;
                    background: Palette.a50;
                    border-width: 1px;
                    border-color: Palette.a300;
                    Text { text: root.scale-changes-label; color: Palette.a700; font-size: 10px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                }
                VerticalLayout {
                    width: parent.width - 380px;
                    height: parent.height;
                    x: (parent.width - self.width) / 2;
                    alignment: center;
                    spacing: 2px;
                    Text { horizontal-stretch: 1; text: root.scale-page-title-label; color: Palette.n900; font-size: 25px; font-weight: 750; horizontal-alignment: center; overflow: elide; }
                    Text { horizontal-stretch: 1; text: root.scale-settings-status; color: root.scale-settings-dirty ? Palette.a700 : Palette.n500; font-size: 12px; horizontal-alignment: center; overflow: elide; }
                }
                CompactActionButton {
                    width: 148px;
                    x: parent.width - self.width;
                    y: (parent.height - self.height) / 2;
                    text: root.scale-refresh-label;
                    enabled: !root.scale-settings-busy;
                    clicked => { root.reload-scale-settings(); }
                }
            }

            Rectangle {
                height: 76px;
                border-radius: 18px;
                border-width: 1px;
                border-color: root.scale-settings-runtime-status == "connected" ? Palette.e300 : root.scale-settings-runtime-status == "connecting" || root.scale-settings-runtime-status == "reconnecting" ? Palette.a300 : Palette.n300;
                background: root.scale-settings-runtime-status == "connected" ? Palette.e50 : root.scale-settings-runtime-status == "connecting" || root.scale-settings-runtime-status == "reconnecting" ? Palette.a50 : white;
                HorizontalLayout {
                    alignment: center;
                    spacing: 14px;
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: 14px;
                        background: root.scale-settings-runtime-status == "connected" ? Palette.e100 : Palette.n200;
                        AppIcon { width: 24px; height: 24px; x: 12px; y: 12px; icon: @image-url("../assets/icons/scale-green.png"); }
                    }
                    VerticalLayout {
                        width: root.narrow ? 360px : 440px;
                        alignment: center;
                        spacing: 3px;
                        Text { horizontal-stretch: 1; text: root.scale-settings-protocol-name; color: Palette.n900; font-size: 15px; font-weight: 750; horizontal-alignment: center; overflow: elide; }
                        Text { horizontal-stretch: 1; text: root.scale-settings-endpoint + " · " + root.scale-settings-protocol; color: Palette.n500; font-family: "Consolas"; font-size: 11px; horizontal-alignment: center; overflow: elide; }
                    }
                    Rectangle {
                        width: 154px;
                        height: 34px;
                        border-radius: 17px;
                        background: root.scale-settings-runtime-status == "connected" ? Palette.e100 : Palette.n200;
                        Text {
                            text: root.scale-settings-runtime-status == "connected" ? root.scale-connected-label : root.scale-settings-runtime-status == "connecting" || root.scale-settings-runtime-status == "reconnecting" ? root.scale-connecting-label : root.scale-disconnected-label;
                            color: root.scale-settings-runtime-status == "connected" ? Palette.e700 : Palette.n600;
                            font-size: 11px;
                            font-weight: 750;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }

            scale-page-scroll := ScrollView {
                vertical-stretch: 1;
                viewport-width: self.width;
                viewport-y <=> root.scale-settings-page-scroll-y;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                mouse-drag-pan-enabled: true;

                VerticalLayout {
                    spacing: 12px;

                    Rectangle {
                        height: root.scale-settings-connection == "serial" ? 330px : root.scale-settings-connection == "tcp" ? 210px : 218px;
                        border-radius: 18px;
                        border-width: 1px;
                        border-color: Palette.n200;
                        background: white;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Text {
                                height: 20px;
                                text: root.scale-connection-label;
                                color: Palette.n500;
                                font-size: 11px;
                                font-weight: 750;
                                letter-spacing: 0.8px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                height: 58px;
                                spacing: 9px;
                                SettingsChoiceButton {
                                    horizontal-stretch: 1;
                                    height: 58px;
                                    text: root.scale-com-label;
                                    subtext: root.settings-serial-hint;
                                    selected: root.scale-settings-connection == "serial";
                                    enabled: !root.scale-settings-busy;
                                    clicked => {
                                        root.scale-settings-connection = "serial";
                                        root.scale-settings-serial-scroll-y = 0px;
                                        if root.scale-settings-protocol == "simulator" {
                                            root.scale-settings-protocol = "generic";
                                            root.scale-settings-protocol-name = "Generic Text";
                                            root.scale-settings-protocol-description = "Универсальный текстовый протокол";
                                        }
                                        root.scale-settings-dirty = true;
                                    }
                                }
                                SettingsChoiceButton {
                                    horizontal-stretch: 1;
                                    height: 58px;
                                    text: root.scale-network-label;
                                    subtext: root.settings-network-hint;
                                    selected: root.scale-settings-connection == "tcp";
                                    enabled: !root.scale-settings-busy;
                                    clicked => {
                                        root.scale-settings-connection = "tcp";
                                        if root.scale-settings-protocol == "simulator" {
                                            root.scale-settings-protocol = "generic";
                                            root.scale-settings-protocol-name = "Generic Text";
                                            root.scale-settings-protocol-description = "Универсальный текстовый протокол";
                                        }
                                        root.scale-settings-dirty = true;
                                    }
                                }
                                SettingsChoiceButton {
                                    horizontal-stretch: 1;
                                    height: 58px;
                                    text: root.scale-simulator-label;
                                    subtext: root.ui-language == "de" ? "Testbetrieb" : root.ui-language == "en" ? "For testing" : root.ui-language == "uk" ? "Для перевірки" : "Для проверки";
                                    selected: root.scale-settings-connection == "simulator";
                                    enabled: !root.scale-settings-busy;
                                    clicked => {
                                        root.scale-settings-connection = "simulator";
                                        root.scale-settings-protocol = "simulator";
                                        root.scale-settings-protocol-name = "Simulator";
                                        root.scale-settings-protocol-description = root.scale-simulator-hint-label;
                                        root.scale-settings-dirty = true;
                                    }
                                }
                            }

                            if root.scale-settings-connection == "tcp": HorizontalLayout {
                                height: 54px;
                                spacing: 8px;
                                LineEdit { horizontal-stretch: 1; text <=> root.scale-settings-host; placeholder-text: root.settings-scale-address-label; enabled: !root.scale-settings-busy; edited => { root.scale-settings-dirty = true; } }
                                CompactActionButton {
                                    width: 140px;
                                    text: root.keyboard-label;
                                    enabled: !root.scale-settings-busy;
                                    clicked => {
                                        root.settings-input-target = "scale-host";
                                        root.settings-input-caption = root.settings-scale-address-label;
                                        root.settings-input-draft = root.scale-settings-host;
                                        root.touch-keyboard-layout = 2;
                                        root.touch-keyboard-uppercase = false;
                                        root.settings-input-keyboard-visible = true;
                                    }
                                }
                                LineEdit { width: 126px; text <=> root.scale-settings-port; placeholder-text: root.settings-scale-port-label; enabled: !root.scale-settings-busy; edited => { root.scale-settings-dirty = true; } }
                                CompactActionButton {
                                    width: 140px;
                                    text: root.keyboard-label;
                                    enabled: !root.scale-settings-busy;
                                    clicked => {
                                        root.settings-input-target = "scale-port";
                                        root.settings-input-caption = root.settings-scale-port-label;
                                        root.settings-input-draft = root.scale-settings-port;
                                        root.touch-keyboard-layout = 2;
                                        root.touch-keyboard-uppercase = false;
                                        root.settings-input-keyboard-visible = true;
                                    }
                                }
                            }

                            if root.scale-settings-connection == "serial": HorizontalLayout {
                                height: 54px;
                                spacing: 8px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 13px;
                                    border-width: 1px;
                                    border-color: Palette.n200;
                                    background: Palette.n50;
                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        spacing: 10px;
                                        Text { text: root.scale-selected-port-label; color: Palette.n500; font-size: 10px; font-weight: 750; vertical-alignment: center; }
                                        Text { horizontal-stretch: 1; text: root.scale-settings-serial-path == "" ? root.settings-not-selected-label : root.scale-settings-serial-path; color: root.scale-settings-serial-path == "" ? Palette.n500 : Palette.n900; font-size: 13px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                    }
                                }
                                LineEdit { width: 150px; text <=> root.scale-settings-baud-rate; placeholder-text: root.settings-baud-placeholder; enabled: !root.scale-settings-busy; edited => { root.scale-settings-dirty = true; } }
                                CompactActionButton {
                                    width: 140px;
                                    text: root.keyboard-label;
                                    enabled: !root.scale-settings-busy;
                                    clicked => {
                                        root.settings-input-target = "scale-baud";
                                        root.settings-input-caption = root.settings-serial-speed-label;
                                        root.settings-input-draft = root.scale-settings-baud-rate;
                                        root.touch-keyboard-layout = 2;
                                        root.touch-keyboard-uppercase = false;
                                        root.settings-input-keyboard-visible = true;
                                    }
                                }
                            }
                            if root.scale-settings-connection == "serial": HorizontalLayout {
                                height: 122px;
                                spacing: 8px;
                                scale-serial-scroll := ScrollView {
                                    horizontal-stretch: 1;
                                    viewport-width: self.width;
                                    viewport-y <=> root.scale-settings-serial-scroll-y;
                                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                    mouse-drag-pan-enabled: true;
                                    VerticalLayout {
                                        spacing: 6px;
                                        if root.scale-settings-serial-ports.length == 0: Text { height: 52px; text: root.settings-serial-empty-label; color: Palette.n500; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                        for choice in root.scale-settings-serial-ports: Rectangle {
                                            height: 52px;
                                            border-radius: 12px;
                                            border-width: 1px;
                                            border-color: choice.value == root.scale-settings-serial-path ? Palette.e400 : Palette.n200;
                                            background: choice.value == root.scale-settings-serial-path ? Palette.e50 : Palette.n50;
                                            HorizontalLayout {
                                                alignment: center;
                                                padding-left: 14px;
                                                padding-right: 14px;
                                                spacing: 10px;
                                                Text { text: choice.label; color: Palette.n800; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                                Text { text: choice.details; color: Palette.n400; font-size: 10px; vertical-alignment: center; overflow: elide; }
                                            }
                                            TouchArea { enabled: !root.scale-settings-busy; clicked => { root.scale-settings-serial-path = choice.value; root.scale-settings-dirty = true; } }
                                        }
                                    }
                                }
                                if root.scale-settings-serial-ports.length > 2: VerticalLayout {
                                    width: 52px;
                                    TouchScrollStepButton { glyph: "▲"; enabled: root.scale-settings-serial-scroll-y < 0px; clicked => { root.scale-settings-serial-scroll-y = min(0px, root.scale-settings-serial-scroll-y + 110px); } }
                                    Rectangle { vertical-stretch: 1; background: transparent; }
                                    TouchScrollStepButton { glyph: "▼"; enabled: scale-serial-scroll.viewport-height > scale-serial-scroll.visible-height && root.scale-settings-serial-scroll-y > scale-serial-scroll.visible-height - scale-serial-scroll.viewport-height; clicked => { root.scale-settings-serial-scroll-y = max(scale-serial-scroll.visible-height - scale-serial-scroll.viewport-height, root.scale-settings-serial-scroll-y - 110px); } }
                                }
                            }

                            if root.scale-settings-connection == "simulator": Rectangle {
                                height: 82px;
                                border-radius: 14px;
                                background: Palette.e50;
                                border-width: 1px;
                                border-color: Palette.e300;
                                Text { x: 18px; width: parent.width - 36px; text: root.scale-simulator-hint-label; color: Palette.e700; font-size: 12px; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }

                    Rectangle {
                        height: 144px;
                        border-radius: 18px;
                        border-width: 1px;
                        border-color: Palette.n200;
                        background: white;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Text { height: 20px; text: root.scale-stability-label; color: Palette.n500; font-size: 11px; font-weight: 750; letter-spacing: 0.8px; horizontal-alignment: center; vertical-alignment: center; }
                            HorizontalLayout {
                                height: 66px;
                                spacing: 10px;
                                SettingsChoiceButton { horizontal-stretch: 1; height: 66px; text: root.scale-fast-label; subtext: "~450 ms"; selected: root.scale-settings-polling == "150" && root.scale-settings-stability-count == "3"; enabled: !root.scale-settings-busy; clicked => { root.scale-settings-polling = "150"; root.scale-settings-stability-count = "3"; root.scale-settings-dirty = true; } }
                                SettingsChoiceButton { horizontal-stretch: 1; height: 66px; text: root.scale-balanced-label; subtext: "~1 s"; selected: root.scale-settings-polling == "250" && root.scale-settings-stability-count == "4"; enabled: !root.scale-settings-busy; clicked => { root.scale-settings-polling = "250"; root.scale-settings-stability-count = "4"; root.scale-settings-dirty = true; } }
                                SettingsChoiceButton { horizontal-stretch: 1; height: 66px; text: root.scale-precise-label; subtext: "~2.5 s"; selected: root.scale-settings-polling == "500" && root.scale-settings-stability-count == "5"; enabled: !root.scale-settings-busy; clicked => { root.scale-settings-polling = "500"; root.scale-settings-stability-count = "5"; root.scale-settings-dirty = true; } }
                            }
                        }
                    }

                    Rectangle {
                        height: 326px;
                        border-radius: 18px;
                        border-width: 1px;
                        border-color: Palette.n200;
                        background: white;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 10px;
                            HorizontalLayout {
                                height: 48px;
                                alignment: center;
                                spacing: 14px;
                                VerticalLayout {
                                    width: root.narrow ? 440px : 540px;
                                    alignment: center;
                                    spacing: 2px;
                                    Text { horizontal-stretch: 1; text: root.scale-protocols-label + " · " + root.scale-settings-protocols.length; color: Palette.n500; font-size: 11px; font-weight: 750; letter-spacing: 0.8px; horizontal-alignment: center; overflow: elide; }
                                    Text { horizontal-stretch: 1; text: root.scale-settings-protocol-description; color: Palette.n600; font-size: 11px; horizontal-alignment: center; overflow: elide; }
                                }
                                Rectangle {
                                    width: 116px;
                                    height: 34px;
                                    border-radius: 17px;
                                    background: Palette.e100;
                                    Text { text: root.scale-settings-protocol; color: Palette.e700; font-family: "Consolas"; font-size: 10px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                }
                            }
                            HorizontalLayout {
                                vertical-stretch: 1;
                                spacing: 8px;
                                scale-protocol-scroll := ScrollView {
                                    horizontal-stretch: 1;
                                    viewport-width: self.width;
                                    viewport-y <=> root.scale-settings-protocol-scroll-y;
                                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                    mouse-drag-pan-enabled: true;
                                    VerticalLayout {
                                        spacing: 7px;
                                        for protocol in root.scale-settings-protocols: Rectangle {
                                            height: 62px;
                                            border-radius: 13px;
                                            border-width: protocol.id == root.scale-settings-protocol ? 2px : 1px;
                                            border-color: protocol.id == root.scale-settings-protocol ? Palette.e500 : Palette.n200;
                                            background: protocol.id == root.scale-settings-protocol ? Palette.e50 : protocol-touch.has-hover ? Palette.n100 : Palette.n50;
                                            HorizontalLayout {
                                                padding-left: 14px;
                                                padding-right: 14px;
                                                spacing: 10px;
                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    alignment: center;
                                                    spacing: 2px;
                                                    Text { horizontal-stretch: 1; text: protocol.name; color: Palette.n900; font-size: 13px; font-weight: 700; horizontal-alignment: center; overflow: elide; }
                                                    Text { horizontal-stretch: 1; text: protocol.description; color: Palette.n500; font-size: 10px; horizontal-alignment: center; overflow: elide; }
                                                }
                                                Text { width: 128px; text: protocol.default-baud-rate + " · " + protocol.serial-format; color: Palette.n500; font-family: "Consolas"; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                            protocol-touch := TouchArea {
                                                enabled: !root.scale-settings-busy && root.scale-settings-connection != "simulator" && protocol.id != "simulator";
                                                clicked => {
                                                    root.scale-settings-protocol = protocol.id;
                                                    root.scale-settings-protocol-name = protocol.name;
                                                    root.scale-settings-protocol-description = protocol.description;
                                                    root.scale-settings-baud-rate = protocol.default-baud-rate;
                                                    root.scale-settings-dirty = true;
                                                }
                                            }
                                        }
                                    }
                                }
                                if root.scale-settings-protocols.length > 3: VerticalLayout {
                                    width: 52px;
                                    TouchScrollStepButton { glyph: "▲"; enabled: root.scale-settings-protocol-scroll-y < 0px; clicked => { root.scale-settings-protocol-scroll-y = min(0px, root.scale-settings-protocol-scroll-y + 138px); } }
                                    Rectangle { vertical-stretch: 1; background: transparent; }
                                    TouchScrollStepButton { glyph: "▼"; enabled: scale-protocol-scroll.viewport-height > scale-protocol-scroll.visible-height && root.scale-settings-protocol-scroll-y > scale-protocol-scroll.visible-height - scale-protocol-scroll.viewport-height; clicked => { root.scale-settings-protocol-scroll-y = max(scale-protocol-scroll.visible-height - scale-protocol-scroll.viewport-height, root.scale-settings-protocol-scroll-y - 138px); } }
                                }
                            }
                        }
                    }

                    if root.scale-settings-probe != "": Rectangle {
                        height: 56px;
                        border-radius: 13px;
                        border-width: 1px;
                        border-color: Palette.e300;
                        background: Palette.e50;
                        Text { x: 16px; width: parent.width - 32px; text: root.scale-settings-probe; color: Palette.e700; font-size: 12px; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle { height: 4px; background: transparent; }
                }
            }

            Rectangle {
                height: root.short ? 58px : 66px;
                border-radius: 16px;
                border-width: 1px;
                border-color: Palette.n200;
                background: white;
                HorizontalLayout {
                    alignment: center;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    if !root.narrow: Text { width: 300px; text: root.scale-settings-busy ? root.settings-busy-label : root.scale-save-hint-label; color: Palette.n500; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
                    CompactActionButton { width: root.narrow ? 180px : 200px; text: root.scale-test-label; enabled: !root.scale-settings-busy; clicked => { root.test-scale-settings(); } }
                    CompactActionButton { width: root.narrow ? 224px : 252px; text: root.scale-settings-busy ? root.scale-saving-label : root.scale-save-label; primary: true; enabled: !root.scale-settings-busy; clicked => { root.save-scale-settings(); } }
                }
            }
        }
    }


    if root.active-page == 5: Rectangle {
        x: (parent.width - root.shell-width) / 2 + root.sidebar-width + root.page-offset;
        width: root.page-width;
        height: parent.height;
        background: Palette.n50;

        VerticalLayout {
            padding: root.content-padding;
            spacing: root.narrow ? 10px : 14px;

            VerticalLayout {
                height: root.short ? 84px : 104px;
                spacing: root.short ? 6px : 8px;

                HorizontalLayout {
                    height: root.short ? 44px : 58px;
                    spacing: 10px;

                    Rectangle {
                        width: root.narrow ? 128px : 138px;
                        background: transparent;
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 1px;
                        Text { text: root.fixed-page-title; color: Palette.n900; font-size: root.short ? 22px : 26px; font-weight: 750; horizontal-alignment: center; overflow: elide; }
                        Text { text: root.fixed-status; color: root.fixed-control-in-range ? Palette.e700 : Palette.n500; font-size: 11px; horizontal-alignment: center; overflow: elide; }
                    }

                    Rectangle {
                        width: root.narrow ? 128px : 138px;
                        background: transparent;
                        CompactActionButton { width: parent.width; height: root.short ? 44px : 48px; y: (parent.height - self.height) / 2; text: root.fixed-refresh-label; enabled: !root.fixed-busy; clicked => { root.reload-fixed-weight(); } }
                    }
                }

                fixed-device-status-row := HorizontalLayout {
                    height: root.short ? 34px : 38px;
                    spacing: root.short ? 6px : 8px;

                    StatusPill {
                        width: (fixed-device-status-row.width - (root.short ? 12px : 16px)) / 3;
                        horizontal-stretch: 0;
                        height: parent.height;
                        compact: root.narrow;
                        text: root.scale-online ? root.jobs-scale-online-label : root.jobs-scale-offline-label;
                        good: root.scale-online;
                        show-icon: true;
                        icon: @image-url("../assets/icons/scale.png");
                    }
                    StatusPill {
                        width: (fixed-device-status-row.width - (root.short ? 12px : 16px)) / 3;
                        horizontal-stretch: 0;
                        height: parent.height;
                        compact: root.narrow;
                        text: root.printer-ready ? root.jobs-printer-online-label : root.jobs-printer-offline-state-label;
                        good: root.printer-ready;
                        show-icon: true;
                        icon: @image-url("../assets/icons/printer.png");
                    }
                    StatusPill {
                        width: (fixed-device-status-row.width - (root.short ? 12px : 16px)) / 3;
                        horizontal-stretch: 0;
                        height: parent.height;
                        compact: root.narrow;
                        text: root.auto-print-enabled ? root.jobs-auto-print-on-label : root.jobs-auto-print-off-label;
                        good: root.auto-print-enabled;
                        neutral: !root.auto-print-enabled;
                        show-icon: true;
                        icon: @image-url("../assets/icons/refresh-cw.png");
                    }
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                alignment: center;

                Rectangle {
                    width: min(root.page-width - root.content-padding * 2, root.wide ? 1120px : 980px);
                    border-radius: 22px;
                    border-width: 1px;
                    border-color: Palette.n200;
                    background: white;
                    drop-shadow-color: #0000000b;
                    drop-shadow-blur: 10px;
                    drop-shadow-offset-y: 2px;

                    VerticalLayout {
                        padding: root.short ? 12px : 16px;
                        spacing: root.short ? 8px : 12px;

                        Text { text: root.fixed-section-title; color: Palette.n500; font-size: 11px; font-weight: 750; letter-spacing: 0.9px; horizontal-alignment: center; }

                        product-card := Rectangle {
                            height: root.short ? 68px : 76px;
                            border-radius: 16px;
                            border-width: 1px;
                            border-color: fixed-product-touch.has-hover ? Palette.e400 : Palette.n300;
                            background: fixed-product-touch.pressed ? Palette.e100 : fixed-product-touch.has-hover ? Palette.e50 : Palette.n50;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 12px;

                                Rectangle {
                                    width: 48px;
                                    vertical-stretch: 1;
                                    background: transparent;
                                    Rectangle {
                                        width: 48px;
                                        height: 48px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 14px;
                                        background: Palette.e100;
                                        AppIcon { width: 24px; height: 24px; x: 12px; y: 12px; icon: @image-url("../assets/icons/package.png"); icon-color: Palette.e600; }
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 3px;
                                    Text { text: root.fixed-product-name; color: Palette.n900; font-size: root.short ? 14px : 16px; font-weight: 750; horizontal-alignment: center; overflow: elide; }
                                    Text { text: root.fixed-product-article == "" ? root.fixed-select-hint : root.fixed-article-label + " " + root.fixed-product-article; color: Palette.n500; font-size: 11px; horizontal-alignment: center; overflow: elide; }
                                }

                                Rectangle {
                                    width: 48px;
                                    vertical-stretch: 1;
                                    background: transparent;
                                    Text { text: "›"; color: fixed-product-touch.has-hover ? Palette.e700 : Palette.n500; font-size: 32px; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            fixed-product-touch := TouchArea { enabled: !root.fixed-busy; clicked => { root.fixed-product-modal-visible = true; root.fixed-product-search = ""; root.fixed-product-scroll-y = 0px; root.touch-keyboard-visible = true; root.touch-keyboard-layout = root.ui-language == "en" || root.ui-language == "de" ? 1 : 0; root.touch-keyboard-uppercase = false; root.search-fixed-products(""); } }
                        }

                        HorizontalLayout {
                            height: root.short ? 112px : 142px;
                            spacing: root.short ? 8px : 12px;

                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 16px;
                                border-width: 2px;
                                border-color: root.fixed-control-in-range ? Palette.e400 : root.stable ? Palette.a300 : Palette.n300;
                                background: root.fixed-control-in-range ? Palette.e50 : root.stable ? Palette.a50 : Palette.n50;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: root.fixed-control-weight-label; color: Palette.n500; font-size: 10px; font-weight: 750; letter-spacing: 0.7px; horizontal-alignment: center; }
                                    Text { text: root.gross-weight; color: root.fixed-control-in-range ? Palette.e700 : Palette.n900; font-family: "Consolas"; font-size: root.short ? 34px : 46px; font-weight: 800; horizontal-alignment: center; }
                                    Text { text: "кг · " + (root.stable ? root.fixed-control-in-range ? root.fixed-in-range-label : root.fixed-out-range-label : root.fixed-wait-stable-label); color: root.fixed-control-in-range ? Palette.e700 : root.stable ? Palette.a700 : Palette.n500; font-size: 10px; font-weight: 750; horizontal-alignment: center; overflow: elide; }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: Palette.e300;
                                background: Palette.e50;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: root.fixed-label-weight-label; color: Palette.e700; font-size: 10px; font-weight: 750; letter-spacing: 0.7px; horizontal-alignment: center; }
                                    Text { text: root.fixed-nominal-weight; color: Palette.e700; font-family: "Consolas"; font-size: root.short ? 34px : 46px; font-weight: 800; horizontal-alignment: center; }
                                    Text { text: "кг · " + root.fixed-tolerance-label + " " + root.fixed-min-weight + "–" + root.fixed-max-weight + " г"; color: Palette.e700; font-size: 10px; font-weight: 650; horizontal-alignment: center; overflow: elide; }
                                }
                            }
                        }

                        HorizontalLayout {
                            height: root.short ? 48px : 52px;
                            spacing: 10px;
                            SettingsChoiceButton { horizontal-stretch: 1; height: parent.height; text: root.fixed-verify-mode-label; selected: root.fixed-mode == "verify"; enabled: !root.fixed-busy; clicked => { root.fixed-mode = "verify"; } }
                            SettingsChoiceButton { horizontal-stretch: 1; height: parent.height; text: root.fixed-batch-mode-label; selected: root.fixed-mode == "batch"; enabled: !root.fixed-busy; clicked => { root.fixed-mode = "batch"; } }
                        }

                        if root.fixed-mode == "verify": Rectangle {
                            vertical-stretch: 1;
                            border-radius: 16px;
                            border-width: 1px;
                            border-color: root.fixed-control-in-range ? Palette.e300 : Palette.n200;
                            background: root.fixed-control-in-range ? Palette.e50 : Palette.n50;
                            VerticalLayout {
                                padding: root.short ? 10px : 14px;
                                alignment: center;
                                spacing: root.short ? 8px : 12px;
                                HorizontalLayout {
                                    height: root.short ? 38px : 48px;
                                    alignment: center;
                                    Text {
                                        width: min(parent.width - 24px, 700px);
                                        height: parent.height;
                                        text: root.fixed-selected-product-id == 0 ? root.fixed-select-product-label : !root.stable ? root.fixed-wait-action-label : !root.fixed-control-in-range ? root.fixed-out-action-label : root.fixed-ready-action-label;
                                        color: root.fixed-control-in-range ? Palette.e700 : Palette.n600;
                                        font-size: root.short ? 12px : 14px;
                                        font-weight: 650;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                                HorizontalLayout {
                                    height: root.short ? 50px : 56px;
                                    alignment: center;
                                    MainButton {
                                        width: min(parent.width - 24px, 440px);
                                        height: parent.height;
                                        text: root.fixed-busy ? root.fixed-printing-batch-label : root.fixed-print-label;
                                        icon: @image-url("../assets/icons/printer-white.png");
                                        border-radius: 16px;
                                        enabled: !root.fixed-busy && root.fixed-selected-product-id > 0 && root.stable && root.fixed-control-in-range && root.printer-ready;
                                        clicked => { root.print-fixed-weight(); }
                                    }
                                }
                            }
                        }

                        if root.fixed-mode == "batch": Rectangle {
                            vertical-stretch: 1;
                            border-radius: 16px;
                            border-width: 1px;
                            border-color: root.fixed-busy ? Palette.a300 : Palette.n200;
                            background: root.fixed-busy ? Palette.a50 : Palette.n50;

                            VerticalLayout {
                                padding: root.short ? 8px : 12px;
                                spacing: root.short ? 5px : 7px;

                                Text { text: root.fixed-quantity-label; color: Palette.n500; font-size: 10px; font-weight: 750; letter-spacing: 0.8px; horizontal-alignment: center; }

                                HorizontalLayout {
                                    height: root.short ? 46px : 56px;
                                    alignment: center;
                                    spacing: 8px;
                                    KeyButton { width: root.short ? 46px : 56px; height: parent.height; text: "−"; enabled: !root.fixed-busy; clicked => { root.fixed-copies = root.step-fixed-copies(root.fixed-copies, -1); } }
                                    Rectangle {
                                        width: root.short ? 150px : 180px;
                                        height: parent.height;
                                        border-radius: 14px;
                                        border-width: 2px;
                                        border-color: quantity-touch.has-hover ? Palette.e500 : Palette.e300;
                                        background: quantity-touch.pressed ? Palette.e200 : white;
                                        Text { text: root.fixed-copies; color: Palette.e700; font-family: "Consolas"; font-size: root.short ? 24px : 30px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        quantity-touch := TouchArea { enabled: !root.fixed-busy; clicked => { root.fixed-copies-draft = ""; root.fixed-quantity-keypad-visible = true; } }
                                    }
                                    KeyButton { width: root.short ? 46px : 56px; height: parent.height; text: "+"; enabled: !root.fixed-busy; clicked => { root.fixed-copies = root.step-fixed-copies(root.fixed-copies, 1); } }
                                    CompactActionButton { width: root.short ? 126px : 160px; height: parent.height; text: root.fixed-touch-input-label; primary: true; enabled: !root.fixed-busy; clicked => { root.fixed-copies-draft = ""; root.fixed-quantity-keypad-visible = true; } }
                                }

                                if !root.short: Text { text: root.fixed-quick-values-label; color: Palette.n500; font-size: 9px; font-weight: 700; letter-spacing: 0.7px; horizontal-alignment: center; }

                                HorizontalLayout {
                                    height: root.short ? 36px : 44px;
                                    alignment: center;
                                    spacing: 8px;
                                    KeyButton { width: 58px; height: parent.height; text: "1"; enabled: !root.fixed-busy; clicked => { root.fixed-copies = "1"; } }
                                    KeyButton { width: 58px; height: parent.height; text: "5"; enabled: !root.fixed-busy; clicked => { root.fixed-copies = "5"; } }
                                    KeyButton { width: 58px; height: parent.height; text: "10"; enabled: !root.fixed-busy; clicked => { root.fixed-copies = "10"; } }
                                    KeyButton { width: 58px; height: parent.height; text: "25"; enabled: !root.fixed-busy; clicked => { root.fixed-copies = "25"; } }
                                    KeyButton { width: 58px; height: parent.height; text: "50"; enabled: !root.fixed-busy; clicked => { root.fixed-copies = "50"; } }
                                    KeyButton { width: 64px; height: parent.height; text: "100"; enabled: !root.fixed-busy; clicked => { root.fixed-copies = "100"; } }
                                }

                                Rectangle {
                                    height: root.short ? 8px : 12px;
                                    border-radius: self.height / 2;
                                    background: Palette.n200;
                                    Rectangle {
                                        width: root.fixed-progress-total > 0 ? parent.width * root.fixed-progress / root.fixed-progress-total : 0px;
                                        height: parent.height;
                                        border-radius: self.height / 2;
                                        background: root.fixed-busy ? Palette.a500 : Palette.e500;
                                    }
                                }

                                Text {
                                    text: root.fixed-progress-total > 0 ? root.fixed-printed-label + " " + root.fixed-progress + " " + root.fixed-of-label + " " + root.fixed-progress-total : root.fixed-queue-hint;
                                    color: Palette.n600;
                                    font-size: root.short ? 10px : 11px;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }

                                HorizontalLayout {
                                    height: root.short ? 44px : 48px;
                                    alignment: center;
                                    spacing: 10px;
                                    CompactActionButton { width: 160px; height: parent.height; text: root.fixed-cancel-label; danger: true; enabled: root.fixed-busy; clicked => { root.cancel-fixed-batch(); } }
                                    CompactActionButton { width: root.short ? 200px : 230px; height: parent.height; text: root.fixed-busy ? root.fixed-printing-batch-label : root.fixed-start-batch-label; primary: true; enabled: !root.fixed-busy && root.fixed-selected-product-id > 0 && root.printer-ready; clicked => { root.start-fixed-batch(); } }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if root.active-page == 6: Rectangle {
        x: (parent.width - root.shell-width) / 2 + root.sidebar-width + root.page-offset;
        width: root.page-width;
        height: parent.height;
        background: Palette.n50;

        VerticalLayout {
            padding: root.content-padding;
            spacing: root.narrow ? 10px : 14px;

            HorizontalLayout {
                height: root.production-job-marking-visible ? 62px : root.narrow ? 106px : 62px;
                alignment: center;

                jobs-header := Rectangle {
                    width: min(root.page-width - root.content-padding * 2, root.wide ? 1440px : 1180px);
                    background: transparent;

                    if !root.production-job-marking-visible && !root.narrow: HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: root.jobs-page-title;
                                color: Palette.n900;
                                font-size: 26px;
                                font-weight: 750;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: root.production-jobs-busy ? root.jobs-updating-label : root.jobs-loaded-label + ": " + root.production-jobs.length;
                                color: root.production-jobs-busy ? Palette.e700 : Palette.n500;
                                font-size: 12px;
                                font-weight: root.production-jobs-busy ? 700 : 500;
                                overflow: elide;
                            }
                        }
                        SettingsChoiceButton {
                            width: 122px;
                            height: 48px;
                            text: root.jobs-active-label;
                            selected: !root.production-jobs-completed;
                            enabled: !root.production-jobs-busy;
                            clicked => {
                                root.production-jobs-completed = false;
                                root.production-jobs-scroll-y = 0px;
                                root.reload-production-jobs();
                            }
                        }
                        SettingsChoiceButton {
                            width: 148px;
                            height: 48px;
                            text: root.jobs-completed-label;
                            selected: root.production-jobs-completed;
                            enabled: !root.production-jobs-busy;
                            clicked => {
                                root.production-jobs-completed = true;
                                root.production-jobs-scroll-y = 0px;
                                root.reload-production-jobs();
                            }
                        }
                        CompactActionButton {
                            width: 134px;
                            height: 48px;
                            text: root.jobs-refresh-label;
                            enabled: !root.production-jobs-busy;
                            clicked => {
                                root.production-jobs-scroll-y = 0px;
                                root.reload-production-jobs();
                            }
                        }
                    }

                    if !root.production-job-marking-visible && root.narrow: VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            height: 48px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 1px;
                                Text { text: root.jobs-page-title; color: Palette.n900; font-size: 22px; font-weight: 750; overflow: elide; }
                                Text {
                                    text: root.production-jobs-busy ? root.jobs-updating-label : root.jobs-loaded-label + ": " + root.production-jobs.length;
                                    color: root.production-jobs-busy ? Palette.e700 : Palette.n500;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                        }
                        HorizontalLayout {
                            height: 48px;
                            spacing: 7px;
                            SettingsChoiceButton {
                                horizontal-stretch: 1;
                                height: 48px;
                                text: root.jobs-active-label;
                                selected: !root.production-jobs-completed;
                                enabled: !root.production-jobs-busy;
                                clicked => {
                                    root.production-jobs-completed = false;
                                    root.production-jobs-scroll-y = 0px;
                                    root.reload-production-jobs();
                                }
                            }
                            SettingsChoiceButton {
                                horizontal-stretch: 1;
                                height: 48px;
                                text: root.jobs-completed-label;
                                selected: root.production-jobs-completed;
                                enabled: !root.production-jobs-busy;
                                clicked => {
                                    root.production-jobs-completed = true;
                                    root.production-jobs-scroll-y = 0px;
                                    root.reload-production-jobs();
                                }
                            }
                            CompactActionButton {
                                horizontal-stretch: 1;
                                height: 48px;
                                text: root.jobs-refresh-label;
                                enabled: !root.production-jobs-busy;
                                clicked => {
                                    root.production-jobs-scroll-y = 0px;
                                    root.reload-production-jobs();
                                }
                            }
                        }
                    }

                    if root.production-job-marking-visible: HorizontalLayout {
                        spacing: 12px;
                        CompactActionButton {
                            width: root.narrow ? 168px : 200px;
                            height: 48px;
                            text: "‹ " + root.jobs-back-label;
                            enabled: !root.production-jobs-busy;
                            clicked => {
                                root.production-job-marking-visible = false;
                                root.production-jobs-scroll-y = 0px;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: root.jobs-marking-title;
                                color: Palette.n900;
                                font-size: root.narrow ? 21px : 25px;
                                font-weight: 750;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: root.selected-production-job-product;
                                color: Palette.n500;
                                font-size: 11px;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                        }
                        if !root.narrow: CompactActionButton {
                            width: 200px;
                            height: 48px;
                            text: root.jobs-refresh-label;
                            enabled: !root.production-jobs-busy;
                            clicked => { root.reload-production-jobs(); }
                        }
                        if root.narrow: Rectangle {
                            width: 168px;
                            background: transparent;
                        }
                    }
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                alignment: center;

                jobs-workspace := Rectangle {
                    width: min(root.page-width - root.content-padding * 2, root.wide ? 1440px : 1180px);
                    background: transparent;

                    HorizontalLayout {
                        spacing: root.narrow ? 10px : 14px;

                        if !root.production-job-marking-visible: jobs-list-card := Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 20px;
                            border-width: 1px;
                            border-color: Palette.n200;
                            background: white;
                            drop-shadow-color: #0000000b;
                            drop-shadow-blur: 14px;
                            drop-shadow-offset-y: 3px;

                            VerticalLayout {
                                padding: root.short ? 10px : 12px;
                                spacing: 8px;

                                HorizontalLayout {
                                    height: 36px;
                                    Text {
                                        text: root.jobs-list-label + " · " + root.production-jobs.length;
                                        color: Palette.n600;
                                        font-size: 11px;
                                        font-weight: 750;
                                        letter-spacing: 0.7px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    if root.production-jobs-busy: Text {
                                        text: "●";
                                        color: Palette.e500;
                                        font-size: 14px;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    vertical-stretch: 1;
                                    spacing: 7px;

                                    production-jobs-scroll := ScrollView {
                                        horizontal-stretch: 1;
                                        viewport-width: self.width;
                                        viewport-y <=> root.production-jobs-scroll-y;
                                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                        mouse-drag-pan-enabled: true;

                                        VerticalLayout {
                                            spacing: 8px;

                                            if root.production-jobs.length == 0: Rectangle {
                                                height: 180px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    spacing: 10px;
                                                    VerticalIcon {
                                                        icon-size: 44px;
                                                        icon: @image-url("../assets/icons/clipboard-list.png");
                                                    }
                                                    Text {
                                                        text: root.production-jobs-completed ? root.jobs-empty-completed-label : root.jobs-empty-active-label;
                                                        color: Palette.n600;
                                                        font-size: 14px;
                                                        font-weight: 650;
                                                        horizontal-alignment: center;
                                                        wrap: word-wrap;
                                                    }
                                                }
                                            }

                                            for job[index] in root.production-jobs: Rectangle {
                                                height: root.short ? 106px : 122px;
                                                border-radius: 15px;
                                                border-width: job.job-id == root.selected-production-job-id ? 2px : 1px;
                                                border-color: job.job-id == root.selected-production-job-id ? Palette.e500 : Palette.n200;
                                                background: job.job-id == root.selected-production-job-id ? Palette.e50 : job-touch.pressed ? Palette.e100 : job-touch.has-hover ? Palette.n100 : Palette.n50;

                                                VerticalLayout {
                                                    padding: root.short ? 8px : 10px;
                                                    spacing: root.short ? 4px : 6px;

                                                    HorizontalLayout {
                                                        height: root.short ? 54px : 60px;
                                                        spacing: 8px;

                                                        Rectangle {
                                                            width: root.short ? 36px : 40px;
                                                            height: root.short ? 36px : 40px;
                                                            border-radius: 11px;
                                                            background: job.job-id == root.selected-production-job-id ? Palette.e200 : white;
                                                            AppIcon {
                                                                width: 20px;
                                                                height: 20px;
                                                                x: (parent.width - self.width) / 2;
                                                                y: (parent.height - self.height) / 2;
                                                                icon: @image-url("../assets/icons/clipboard-list.png");
                                                                icon-color: job.job-id == root.selected-production-job-id ? Palette.e700 : Palette.n500;
                                                            }
                                                        }

                                                        VerticalLayout {
                                                            horizontal-stretch: 1;
                                                            alignment: center;
                                                            spacing: 2px;
                                                            Text {
                                                                height: root.short ? 30px : 36px;
                                                                text: job.product-name;
                                                                color: Palette.n900;
                                                                font-size: root.short ? 12px : 13px;
                                                                font-weight: 750;
                                                                vertical-alignment: center;
                                                                wrap: word-wrap;
                                                                overflow: elide;
                                                            }
                                                            Text {
                                                                text: "#" + job.job-id + " · " + root.jobs-article-label + " " + (job.article == "" ? "—" : job.article);
                                                                color: Palette.n500;
                                                                font-size: root.short ? 9px : 10px;
                                                                overflow: elide;
                                                            }
                                                        }

                                                        Rectangle {
                                                            width: root.short ? 76px : 86px;
                                                            height: 28px;
                                                            y: (parent.height - self.height) / 2;
                                                            border-radius: 14px;
                                                            background: job.completed ? Palette.e100 : job.status == "in_progress" ? Palette.a50 : Palette.n200;
                                                            Text {
                                                                text: job.completed ? root.jobs-status-completed-label : job.status == "in_progress" ? root.jobs-status-progress-label : root.jobs-status-pending-label;
                                                                color: job.completed ? Palette.e700 : job.status == "in_progress" ? Palette.a700 : Palette.n600;
                                                                font-size: root.short ? 8px : 9px;
                                                                font-weight: 750;
                                                                horizontal-alignment: center;
                                                                vertical-alignment: center;
                                                                overflow: elide;
                                                            }
                                                        }
                                                    }

                                                    HorizontalLayout {
                                                        height: root.short ? 14px : 16px;
                                                        spacing: 8px;
                                                        Text {
                                                            horizontal-stretch: 1;
                                                            text: root.jobs-batch-label + " " + (job.batch == "" ? "—" : job.batch) + " · " + job.marking-date;
                                                            color: Palette.n500;
                                                            font-size: root.short ? 8px : 9px;
                                                            overflow: elide;
                                                        }
                                                        Text {
                                                            text: job.printed + " / " + job.quantity;
                                                            color: Palette.n700;
                                                            font-family: "Consolas";
                                                            font-size: root.short ? 9px : 10px;
                                                            font-weight: 700;
                                                        }
                                                    }

                                                    Rectangle {
                                                        height: 8px;
                                                        border-radius: 4px;
                                                        background: Palette.n200;
                                                        clip: true;
                                                        Rectangle {
                                                            x: 0px;
                                                            width: max(0px, min(parent.width, parent.width * job.progress));
                                                            height: parent.height;
                                                            border-radius: 4px;
                                                            background: job.completed ? Palette.e500 : Palette.a500;
                                                        }
                                                    }
                                                }

                                                job-touch := TouchArea {
                                                    enabled: !root.production-jobs-busy;
                                                    clicked => {
                                                        root.production-job-marking-visible = true;
                                                        root.select-production-job(index);
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    if root.production-jobs.length > 3: HorizontalLayout {
                                        height: 52px;
                                        alignment: center;
                                        spacing: 10px;
                                        TouchScrollStepButton {
                                            glyph: "▲";
                                            enabled: root.production-jobs-scroll-y < 0px;
                                            clicked => {
                                                root.production-jobs-scroll-y = min(0px, root.production-jobs-scroll-y + (root.short ? 180px : 208px));
                                            }
                                        }
                                        TouchScrollStepButton {
                                            glyph: "▼";
                                            enabled: production-jobs-scroll.viewport-height > production-jobs-scroll.visible-height
                                                && root.production-jobs-scroll-y > production-jobs-scroll.visible-height - production-jobs-scroll.viewport-height;
                                            clicked => {
                                                root.production-jobs-scroll-y = max(
                                                    production-jobs-scroll.visible-height - production-jobs-scroll.viewport-height,
                                                    root.production-jobs-scroll-y - (root.short ? 180px : 208px)
                                                );
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if root.production-job-marking-visible: jobs-detail-card := Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 20px;
                            border-width: 1px;
                            border-color: Palette.n200;
                            background: white;
                            drop-shadow-color: #0000000b;
                            drop-shadow-blur: 14px;
                            drop-shadow-offset-y: 3px;

                            if root.selected-production-job-id <= 0: VerticalLayout {
                                alignment: center;
                                spacing: 12px;
                                VerticalIcon {
                                    icon-size: 58px;
                                    icon: @image-url("../assets/icons/clipboard-list.png");
                                }
                                Text {
                                    text: root.jobs-select-label;
                                    color: Palette.n600;
                                    font-size: 18px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            if root.selected-production-job-id > 0: VerticalLayout {
                                padding: root.short ? 12px : 16px;
                                spacing: root.short ? 6px : 8px;

                                Rectangle {
                                    height: root.short ? 70px : 84px;
                                    border-radius: 16px;
                                    border-width: 1px;
                                    border-color: Palette.n200;
                                    background: Palette.n50;

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;

                                        Rectangle {
                                            width: root.short ? 38px : 44px;
                                            height: root.short ? 38px : 44px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 12px;
                                            background: Palette.e100;
                                            AppIcon {
                                                width: 22px;
                                                height: 22px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                icon: @image-url("../assets/icons/package.png");
                                                icon-color: Palette.e700;
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                height: root.short ? 32px : 42px;
                                                text: root.selected-production-job-product;
                                                color: Palette.n900;
                                                font-size: root.short ? 14px : 16px;
                                                font-weight: 800;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                wrap: word-wrap;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: root.selected-production-job-article == "" ? root.jobs-selected-label + " #" + root.selected-production-job-id : root.jobs-article-label + " " + root.selected-production-job-article;
                                                color: Palette.n500;
                                                font-size: root.short ? 9px : 10px;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }
                                        }

                                        Rectangle {
                                            width: root.short ? 82px : 96px;
                                            height: 30px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 15px;
                                            background: root.selected-production-job-status == "completed" ? Palette.e100 : root.selected-production-job-status == "in_progress" ? Palette.a50 : Palette.n200;
                                            Text {
                                                text: root.selected-production-job-status == "completed" ? root.jobs-status-completed-label : root.selected-production-job-status == "in_progress" ? root.jobs-status-progress-label : root.jobs-status-pending-label;
                                                color: root.selected-production-job-status == "completed" ? Palette.e700 : root.selected-production-job-status == "in_progress" ? Palette.a700 : Palette.n600;
                                                font-size: root.short ? 8px : 9px;
                                                font-weight: 750;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }

                                jobs-device-status-row := HorizontalLayout {
                                    width: parent.width - (root.short ? 24px : 32px);
                                    horizontal-stretch: 1;
                                    height: root.short ? 30px : 38px;
                                    spacing: root.short ? 6px : 8px;

                                    StatusPill {
                                        width: (jobs-device-status-row.width - (root.short ? 12px : 16px)) / 3;
                                        horizontal-stretch: 0;
                                        height: parent.height;
                                        compact: root.narrow;
                                        text: root.scale-online ? root.jobs-scale-online-label : root.jobs-scale-offline-label;
                                        good: root.scale-online;
                                        show-icon: true;
                                        icon: @image-url("../assets/icons/scale.png");
                                    }
                                    StatusPill {
                                        width: (jobs-device-status-row.width - (root.short ? 12px : 16px)) / 3;
                                        horizontal-stretch: 0;
                                        height: parent.height;
                                        compact: root.narrow;
                                        text: root.printer-ready ? root.jobs-printer-online-label : root.jobs-printer-offline-state-label;
                                        good: root.printer-ready;
                                        show-icon: true;
                                        icon: @image-url("../assets/icons/printer.png");
                                    }
                                    StatusPill {
                                        width: (jobs-device-status-row.width - (root.short ? 12px : 16px)) / 3;
                                        horizontal-stretch: 0;
                                        height: parent.height;
                                        compact: root.narrow;
                                        text: root.auto-print-enabled ? root.jobs-auto-print-on-label : root.jobs-auto-print-off-label;
                                        good: root.auto-print-enabled;
                                        neutral: !root.auto-print-enabled;
                                        show-icon: true;
                                        icon: @image-url("../assets/icons/refresh-cw.png");
                                    }
                                }

                                jobs-metrics-row := HorizontalLayout {
                                    width: parent.width - (root.short ? 24px : 32px);
                                    horizontal-stretch: 1;
                                    height: root.short ? 92px : 108px;
                                    spacing: root.short ? 6px : 8px;

                                    ProductionJobMetricCard {
                                        width: (jobs-metrics-row.width - (root.short ? 12px : 16px)) / 3;
                                        horizontal-stretch: 0;
                                        height: parent.height;
                                        compact: root.short;
                                        label: root.jobs-plan-label;
                                        value: root.selected-production-job-quantity;
                                        subtext: root.jobs-mode-label;

                                    }
                                    ProductionJobMetricCard {
                                        width: (jobs-metrics-row.width - (root.short ? 12px : 16px)) / 3;
                                        horizontal-stretch: 0;
                                        height: parent.height;
                                        compact: root.short;
                                        label: root.jobs-fact-label;
                                        value: root.selected-production-job-printed;
                                        subtext: root.jobs-remaining-label + " " + root.selected-production-job-remaining;

                                        value-color: Palette.a700;
                                    }
                                    ProductionJobMetricCard {
                                        width: (jobs-metrics-row.width - (root.short ? 12px : 16px)) / 3;
                                        horizontal-stretch: 0;
                                        height: parent.height;
                                        compact: root.short;
                                        label: root.jobs-current-weight-label;
                                        value: root.gross-weight + " kg";
                                        subtext: root.selected-production-job-status == "completed"
                                            ? root.jobs-status-completed-label
                                            : !root.printer-ready
                                                ? root.jobs-printer-offline-label
                                                : root.production-job-weight-valid
                                                    ? root.jobs-ready-label
                                                    : root.stable ? root.jobs-check-weight-label : root.jobs-wait-stable-label;

                                        value-color: root.production-job-weight-valid ? Palette.e700 : root.stable ? Palette.a700 : Palette.n900;
                                    }
                                }

                                jobs-info-row := HorizontalLayout {
                                    width: parent.width - (root.short ? 24px : 32px);
                                    horizontal-stretch: 1;
                                    height: root.short ? 50px : 58px;
                                    spacing: root.short ? 6px : 8px;

                                    ProductionJobInfoCard {
                                        width: (jobs-info-row.width - (root.short ? 12px : 16px)) / 3;
                                        horizontal-stretch: 0;
                                        height: parent.height;
                                        compact: root.short;
                                        label: root.jobs-batch-label;
                                        value: root.selected-production-job-batch == "" ? "—" : root.selected-production-job-batch;
                                    }
                                    ProductionJobInfoCard {
                                        width: (jobs-info-row.width - (root.short ? 12px : 16px)) / 3;
                                        horizontal-stretch: 0;
                                        height: parent.height;
                                        compact: root.short;
                                        label: root.jobs-date-label;
                                        value: root.selected-production-job-date;
                                    }
                                    ProductionJobInfoCard {
                                        width: (jobs-info-row.width - (root.short ? 12px : 16px)) / 3;
                                        horizontal-stretch: 0;
                                        height: parent.height;
                                        compact: root.short;
                                        label: root.jobs-mode-label;
                                        value: root.selected-production-job-unit == "kg" ? root.jobs-by-weight-label : root.jobs-by-piece-label;
                                        value-color: Palette.e700;
                                    }
                                }

                                jobs-flow-row := HorizontalLayout {
                                    width: parent.width - (root.short ? 24px : 32px);
                                    horizontal-stretch: 1;
                                    height: root.short ? 48px : 58px;
                                    spacing: root.short ? 6px : 8px;

                                    ProductionJobFlowCard {
                                        width: (jobs-flow-row.width - (root.short ? 12px : 16px)) / 3;
                                        horizontal-stretch: 0;
                                        height: parent.height;
                                        compact: root.short;
                                        icon: @image-url("../assets/icons/package.png");
                                        label: root.jobs-package-label + " №";
                                        value: root.pack-number == "—" ? "—" : root.pack-number;
                                        detail: root.jobs-session-label;
                                    }
                                    ProductionJobFlowCard {
                                        width: (jobs-flow-row.width - (root.short ? 12px : 16px)) / 3;
                                        horizontal-stretch: 0;
                                        height: parent.height;
                                        compact: root.short;
                                        icon: @image-url("../assets/icons/box.png");
                                        label: root.jobs-box-label + " №";
                                        value: root.box-number == "—" ? "—" : root.box-number;
                                        detail: root.box-limit > 0
                                            ? root.units-in-box + " / " + root.box-limit + " " + root.jobs-packages-count-label
                                            : root.units-in-box + " / — " + root.jobs-packages-count-label;
                                    }
                                    ProductionJobFlowCard {
                                        width: (jobs-flow-row.width - (root.short ? 12px : 16px)) / 3;
                                        horizontal-stretch: 0;
                                        height: parent.height;
                                        compact: root.short;
                                        icon: @image-url("../assets/icons/layers.png");
                                        label: root.jobs-pallet-label;
                                        value: root.boxes-on-pallet + " " + root.jobs-boxes-count-label;
                                        detail: root.jobs-session-label;
                                    }
                                }

                                Rectangle {
                                    height: root.short ? 46px : 54px;
                                    border-radius: 14px;
                                    background: Palette.n50;
                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 5px;
                                        Text {
                                            text: root.jobs-progress-label + " " + root.selected-production-job-printed + " " + root.jobs-of-label + " " + root.selected-production-job-quantity;
                                            color: Palette.n600;
                                            font-size: root.short ? 10px : 11px;
                                            font-weight: 650;
                                            horizontal-alignment: center;
                                            overflow: elide;
                                        }
                                        Rectangle {
                                            height: 10px;
                                            border-radius: 5px;
                                            background: Palette.n200;
                                            clip: true;
                                            Rectangle {
                                                x: 0px;
                                                width: max(0px, min(parent.width, parent.width * root.selected-production-job-progress));
                                                height: parent.height;
                                                border-radius: 5px;
                                                background: root.selected-production-job-status == "completed" ? Palette.e500 : Palette.a500;
                                            }
                                        }
                                    }
                                }

                                Rectangle { vertical-stretch: 1; background: transparent; }

                                HorizontalLayout {
                                    height: root.short ? 50px : 58px;
                                    spacing: 8px;
                                    MainButton {
                                        horizontal-stretch: 2;
                                        height: parent.height;
                                        text: root.production-jobs-busy ? root.jobs-printing-label : root.jobs-print-label;
                                        icon: @image-url("../assets/icons/printer-white.png");
                                        border-radius: 16px;
                                        enabled: !root.production-jobs-busy
                                            && root.selected-production-job-id > 0
                                            && root.selected-production-job-status != "completed"
                                            && root.stable
                                            && root.production-job-weight-valid
                                            && root.printer-ready;
                                        clicked => { root.print-production-job-pack(); }
                                    }
                                    MainButton {
                                        horizontal-stretch: 1;
                                        height: parent.height;
                                        text: root.jobs-print-box-label;
                                        icon: @image-url("../assets/icons/box.png");
                                        label-font-size: root.short ? 12px : 14px;
                                        border-radius: 16px;
                                        normal-color: Palette.e600;
                                        hover-color: Palette.e500;
                                        pressed-color: Palette.e700;
                                        enabled: !root.production-jobs-busy
                                            && root.selected-production-job-id > 0
                                            && root.units-in-box > 0;
                                        clicked => { root.close-box(); }
                                    }
                                    MainButton {
                                        horizontal-stretch: 1;
                                        height: parent.height;
                                        text: root.jobs-print-pallet-label;
                                        icon: @image-url("../assets/icons/layers-white.png");
                                        label-font-size: root.short ? 12px : 14px;
                                        border-radius: 16px;
                                        normal-color: Palette.a600;
                                        hover-color: Palette.a500;
                                        pressed-color: Palette.a700;
                                        enabled: !root.production-jobs-busy
                                            && root.selected-production-job-id > 0
                                            && root.boxes-on-pallet > 0
                                            && root.printer-ready;
                                        clicked => { root.print-pallet(); }
                                    }
                                }

                                HorizontalLayout {
                                    height: root.short ? 44px : 48px;
                                    spacing: 8px;
                                    CompactActionButton {
                                        horizontal-stretch: 1;
                                        height: parent.height;
                                        text: root.jobs-complete-label;
                                        enabled: !root.production-jobs-busy
                                            && root.selected-production-job-id > 0
                                            && root.selected-production-job-status != "completed";
                                        clicked => {
                                            if root.units-in-box > 0 {
                                                root.alert-text = root.jobs-open-box-warning + "\n" + root.jobs-box-label + " " + root.box-number + " · " + root.units-in-box + " " + root.jobs-open-box-units-label;
                                                root.alert-visible = true;
                                            } else {
                                                root.complete-production-job();
                                            }
                                        }
                                    }
                                    CompactActionButton {
                                        horizontal-stretch: 1;
                                        height: parent.height;
                                        text: root.jobs-delete-label;
                                        danger: true;
                                        enabled: !root.production-jobs-busy && root.selected-production-job-id > 0;
                                        clicked => { root.delete-production-job(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if root.active-page == 7: Rectangle {
        x: (parent.width - root.shell-width) / 2 + root.sidebar-width + root.page-offset;
        width: root.page-width;
        height: parent.height;
        background: Palette.n50;

        VerticalLayout {
            padding: root.content-padding;
            spacing: root.narrow ? 10px : 14px;

            HorizontalLayout {
                height: root.short ? 54px : 62px;
                spacing: root.narrow ? 8px : 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.catalog-page-title;
                        color: Palette.n900;
                        font-size: root.narrow ? 23px : 27px;
                        font-weight: 800;
                        overflow: elide;
                    }
                    Text {
                        text: root.catalog-error
                            ? root.catalog-status
                            : root.catalog-busy
                                ? root.catalog-loading-label
                                : root.catalog-shown-label + " " + root.catalog-products.length + " " + root.catalog-of-label + " " + root.catalog-total;
                        color: root.catalog-error ? Palette.r600 : Palette.n500;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
                Rectangle {
                    width: root.narrow ? 110px : 138px;
                    height: 40px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: root.catalog-truncated ? Palette.a300 : Palette.e200;
                    background: root.catalog-truncated ? Palette.a50 : Palette.e50;
                    Text {
                        text: root.catalog-total + " " + root.catalog-products-label;
                        color: root.catalog-truncated ? Palette.a700 : Palette.e700;
                        font-size: root.narrow ? 11px : 12px;
                        font-weight: 750;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                CompactActionButton {
                    width: root.narrow ? 118px : 148px;
                    height: 48px;
                    text: root.catalog-busy ? "…" : root.catalog-refresh-label;
                    primary: true;
                    enabled: !root.catalog-busy;
                    clicked => { root.reload-catalog(); }
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: root.narrow ? 10px : 14px;

                if !root.catalog-detail-visible: Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 18px;
                    border-width: 1px;
                    border-color: Palette.n200;
                    background: white;
                    clip: true;

                    VerticalLayout {
                        padding: root.narrow ? 10px : 14px;
                        spacing: root.narrow ? 8px : 10px;

                        HorizontalLayout {
                            height: root.short ? 54px : 62px;
                            spacing: root.narrow ? 8px : 12px;
                            LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.catalog-search;
                                placeholder-text: root.catalog-search-placeholder;
                                font-size: root.short ? 16px : 18px;
                                edited => {
                                    root.catalog-list-scroll-y = 0px;
                                    root.search-catalog(self.text);
                                }
                                accepted => {
                                    root.catalog-list-scroll-y = 0px;
                                    root.search-catalog(self.text);
                                    root.catalog-keyboard-visible = false;
                                }
                            }
                            CompactActionButton {
                                width: root.narrow ? 142px : 178px;
                                height: parent.height;
                                text-size: root.short ? 14px : 16px;
                                text: root.catalog-keyboard-visible ? root.hide-keyboard-label : root.keyboard-label;
                                primary: root.catalog-keyboard-visible;
                                clicked => {
                                    if root.catalog-keyboard-visible {
                                        root.catalog-keyboard-visible = false;
                                    } else {
                                        root.catalog-keyboard-visible = true;
                                        root.touch-keyboard-layout = root.ui-language == "en" || root.ui-language == "de" ? 1 : 0;
                                        root.touch-keyboard-uppercase = false;
                                    }
                                }
                            }
                            CompactActionButton {
                                width: root.narrow ? 118px : 144px;
                                height: parent.height;
                                text-size: root.short ? 14px : 16px;
                                text: root.catalog-busy ? "…" : root.catalog-search-label;
                                primary: true;
                                enabled: !root.catalog-busy;
                                clicked => {
                                    root.catalog-list-scroll-y = 0px;
                                    root.search-catalog(root.catalog-search);
                                    root.catalog-keyboard-visible = false;
                                }
                            }
                        }

                        if root.catalog-keyboard-visible: TouchKeyboard {
                            layout <=> root.touch-keyboard-layout;
                            uppercase <=> root.touch-keyboard-uppercase;
                            compact: root.short;
                            roomy: true;
                            space-label: root.keyboard-space-label;
                            clear-label: root.keyboard-clear-label;
                            done-label: root.keyboard-done-label;
                            key-pressed(key, uppercase) => {
                                root.catalog-search = root.edit-touch-text(root.catalog-search, key, uppercase);
                                root.catalog-list-scroll-y = 0px;
                                root.search-catalog(root.catalog-search);
                            }
                            backspace => {
                                root.catalog-search = root.edit-touch-text(root.catalog-search, "__BACKSPACE__", false);
                                root.catalog-list-scroll-y = 0px;
                                root.search-catalog(root.catalog-search);
                            }
                            clear => {
                                root.catalog-search = "";
                                root.catalog-list-scroll-y = 0px;
                                root.search-catalog("");
                            }
                            done => {
                                root.catalog-list-scroll-y = 0px;
                                root.search-catalog(root.catalog-search);
                                root.catalog-keyboard-visible = false;
                            }
                        }

                        HorizontalLayout {
                            height: 32px;
                            Text {
                                horizontal-stretch: 1;
                                text: root.catalog-list-label + " · " + root.catalog-products.length + " / " + root.catalog-total;
                                color: Palette.n700;
                                font-size: 12px;
                                font-weight: 700;
                                letter-spacing: 0.45px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if !root.narrow: Text {
                                text: root.catalog-scroll-hint;
                                color: Palette.n500;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        HorizontalLayout {
                            vertical-stretch: 1;
                            spacing: 8px;

                            catalog-list-scroll := ScrollView {
                                horizontal-stretch: 1;
                                viewport-width: self.width;
                                viewport-y <=> root.catalog-list-scroll-y;
                                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                mouse-drag-pan-enabled: true;

                                VerticalLayout {
                                    spacing: 8px;
                                    if root.catalog-products.length == 0: Rectangle {
                                        height: 176px;
                                        border-radius: 14px;
                                        background: Palette.n50;
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 9px;
                                            VerticalIcon {
                                                icon-size: 40px;
                                                icon: @image-url("../assets/icons/package.png");
                                                icon-color: Palette.n400;
                                            }
                                            Text {
                                                text: root.catalog-busy ? root.catalog-loading-label : root.catalog-empty-label;
                                                color: Palette.n600;
                                                font-size: 15px;
                                                font-weight: 650;
                                                horizontal-alignment: center;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    for product[index] in root.catalog-products: Rectangle {
                                        height: root.short ? 72px : 80px;
                                        border-radius: 14px;
                                        border-width: product.id == root.catalog-selected-product-id ? 2px : 1px;
                                        border-color: product.id == root.catalog-selected-product-id ? Palette.e400 : Palette.n300;
                                        background: catalog-row-touch.pressed ? Palette.e100 : catalog-row-touch.has-hover ? Palette.n100 : product.id == root.catalog-selected-product-id ? Palette.e50 : white;
                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            spacing: 10px;
                                            Rectangle {
                                                width: 48px;
                                                vertical-stretch: 1;
                                                background: transparent;
                                                Rectangle {
                                                    width: 48px;
                                                    height: 48px;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 12px;
                                                    background: product.id == root.catalog-selected-product-id ? Palette.e100 : Palette.n200;
                                                    AppIcon {
                                                        width: 22px;
                                                        height: 22px;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        icon: @image-url("../assets/icons/package.png");
                                                        icon-color: product.id == root.catalog-selected-product-id ? Palette.e700 : Palette.n500;
                                                    }
                                                }
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 3px;
                                                Text { text: product.name; color: Palette.n900; font-size: root.narrow ? 15px : 16px; font-weight: 700; overflow: elide; }
                                                Text { text: product.details; color: Palette.n600; font-size: root.narrow ? 11px : 12px; font-weight: 500; overflow: elide; }
                                            }
                                            Rectangle {
                                                width: 72px;
                                                vertical-stretch: 1;
                                                background: transparent;
                                                Rectangle {
                                                    width: 66px;
                                                    height: 32px;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 10px;
                                                    background: white;
                                                    Text {
                                                        text: "#" + product.id;
                                                        color: Palette.n500;
                                                        font-family: "Consolas";
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }
                                                }
                                            }
                                        }
                                        catalog-row-touch := TouchArea {
                                            enabled: !root.catalog-busy;
                                            clicked => {
                                                root.catalog-detail-scroll-y = 0px;
                                                root.catalog-keyboard-visible = false;
                                                root.catalog-detail-visible = true;
                                                root.select-catalog-product(index);
                                            }
                                        }
                                    }

                                    if root.catalog-truncated: CompactActionButton {
                                        height: 52px;
                                        text: root.catalog-busy ? root.catalog-loading-label : root.catalog-load-more-label + " · " + (root.catalog-total - root.catalog-products.length);
                                        primary: true;
                                        enabled: !root.catalog-busy;
                                        clicked => { root.load-more-catalog(); }
                                    }
                                }
                            }

                            if root.catalog-products.length > (root.catalog-keyboard-visible ? 2 : 4): VerticalLayout {
                                width: 52px;
                                TouchScrollStepButton {
                                    glyph: "▲";
                                    enabled: root.catalog-list-scroll-y < 0px;
                                    clicked => { root.catalog-list-scroll-y = min(0px, root.catalog-list-scroll-y + (root.short ? 148px : 164px)); }
                                }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                TouchScrollStepButton {
                                    glyph: "▼";
                                    enabled: catalog-list-scroll.viewport-height > catalog-list-scroll.visible-height
                                        && root.catalog-list-scroll-y > catalog-list-scroll.visible-height - catalog-list-scroll.viewport-height;
                                    clicked => {
                                        root.catalog-list-scroll-y = max(
                                            catalog-list-scroll.visible-height - catalog-list-scroll.viewport-height,
                                            root.catalog-list-scroll-y - (root.short ? 148px : 164px)
                                        );
                                    }
                                }
                            }
                        }
                    }
                }
                if root.catalog-detail-visible: Rectangle {
                    width: parent.width;
                    border-radius: 18px;
                    border-width: 1px;
                    border-color: Palette.n200;
                    background: white;
                    clip: true;

                    VerticalLayout {
                        padding: root.narrow ? 10px : 12px;
                        spacing: 10px;

                        CompactActionButton {
                            horizontal-stretch: 1;
                            height: 56px;
                            text-size: 16px;
                            text: "‹  " + root.catalog-back-to-list-label;
                            clicked => {
                                root.catalog-detail-visible = false;
                                root.catalog-detail-scroll-y = 0px;
                            }
                        }

                        catalog-detail-scroll := ScrollView {
                            vertical-stretch: 1;
                            viewport-width: self.width;
                            viewport-y <=> root.catalog-detail-scroll-y;
                            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            mouse-drag-pan-enabled: true;

                            VerticalLayout {
                                spacing: 12px;
                                Text {
                                    height: 26px;
                                    text: root.catalog-card-title;
                                    color: Palette.n600;
                                    font-size: 12px;
                                    font-weight: 700;
                                    letter-spacing: 0.65px;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    height: root.narrow ? 112px : 126px;
                                    border-radius: 16px;
                                    border-width: 1px;
                                    border-color: Palette.e200;
                                    background: Palette.e50;
                                    HorizontalLayout {
                                        padding: 14px;
                                        spacing: 14px;
                                        Rectangle {
                                            width: 56px;
                                            vertical-stretch: 1;
                                            background: transparent;
                                            Rectangle {
                                                width: 52px;
                                                height: 52px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 14px;
                                                background: Palette.e100;
                                                AppIcon {
                                                    width: 26px;
                                                    height: 26px;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    icon: @image-url("../assets/icons/package.png");
                                                    icon-color: Palette.e700;
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 4px;
                                            Text {
                                                height: root.narrow ? 58px : 70px;
                                                text: root.catalog-name;
                                                color: Palette.n900;
                                                font-size: root.narrow ? 18px : 19px;
                                                font-weight: 800;
                                                vertical-alignment: center;
                                                wrap: word-wrap;
                                                overflow: elide;
                                            }
                                            Text {
                                                height: 18px;
                                                text: root.catalog-article-label + " " + root.catalog-article;
                                                color: Palette.n600;
                                                font-family: "Consolas";
                                                font-size: 12px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    height: 42px;
                                    spacing: 8px;
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        border-radius: 11px;
                                        background: Palette.n100;
                                        Text {
                                            text: root.catalog-expiration-label + " · " + root.catalog-expiration;
                                            color: Palette.n800;
                                            font-size: 12px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    Rectangle {
                                        width: root.narrow ? 150px : 136px;
                                        border-radius: 11px;
                                        background: root.catalog-mode == "Фиксированный" ? Palette.e100 : Palette.a50;
                                        Text {
                                            text: root.catalog-mode == "Фиксированный" ? root.catalog-fixed-mode-label : root.catalog-weight-mode-label;
                                            color: root.catalog-mode == "Фиксированный" ? Palette.e700 : Palette.a700;
                                            font-size: 11px;
                                            font-weight: 800;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 64px;
                                    border-radius: 14px;
                                    border-width: 1px;
                                    border-color: Palette.n200;
                                    background: Palette.n50;
                                    VerticalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        alignment: center;
                                        ThinStatRow { compact: false; label: root.catalog-fixed-weight-label; value: root.catalog-fixed-weight; value-color: Palette.e700; }
                                    }
                                }

                                Rectangle {
                                    height: 208px;
                                    border-radius: 16px;
                                    border-width: 1px;
                                    border-color: Palette.n200;
                                    background: Palette.n50;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 3px;
                                        Text { height: 22px; text: root.catalog-packaging-title; color: Palette.n600; font-size: 11px; font-weight: 700; letter-spacing: 0.6px; vertical-alignment: center; }
                                        ThinStatRow { compact: false; label: root.catalog-portion-container-label; value: root.catalog-portion-container; }
                                        ThinStatRow { compact: false; label: root.catalog-portion-tare-label; value: root.catalog-portion-tare; }
                                        ThinStatRow { compact: false; label: root.catalog-box-container-label; value: root.catalog-box-container; }
                                        ThinStatRow { compact: false; label: root.catalog-box-tare-label; value: root.catalog-box-tare; }
                                        ThinStatRow { compact: false; label: root.catalog-box-limit-label; value: root.catalog-box-limit; }
                                    }
                                }

                                Rectangle {
                                    height: 146px;
                                    border-radius: 16px;
                                    border-width: 1px;
                                    border-color: Palette.n200;
                                    background: Palette.n50;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 3px;
                                        Text { height: 22px; text: root.catalog-templates-title; color: Palette.n600; font-size: 11px; font-weight: 700; letter-spacing: 0.6px; vertical-alignment: center; }
                                        ThinStatRow { compact: false; label: root.catalog-package-label; value: root.catalog-pack-label; }
                                        ThinStatRow { compact: false; label: root.catalog-box-label-text; value: root.catalog-box-label; }
                                        ThinStatRow { compact: false; label: root.catalog-pallet-label-text; value: root.catalog-pallet-label; }
                                    }
                                }

                                Rectangle {
                                    min-height: 94px;
                                    border-radius: 16px;
                                    border-width: 1px;
                                    border-color: Palette.n200;
                                    background: Palette.n50;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 7px;
                                        Text { text: root.catalog-extra-title; color: Palette.n600; font-size: 11px; font-weight: 700; letter-spacing: 0.6px; }
                                        Text { text: root.catalog-extra; color: Palette.n800; font-size: 13px; font-weight: 500; wrap: word-wrap; }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            height: 52px;
                            spacing: 10px;
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            TouchScrollStepButton {
                                glyph: "▲";
                                enabled: root.catalog-detail-scroll-y < 0px;
                                clicked => { root.catalog-detail-scroll-y = min(0px, root.catalog-detail-scroll-y + 180px); }
                            }
                            TouchScrollStepButton {
                                glyph: "▼";
                                enabled: catalog-detail-scroll.viewport-height > catalog-detail-scroll.visible-height
                                    && root.catalog-detail-scroll-y > catalog-detail-scroll.visible-height - catalog-detail-scroll.viewport-height;
                                clicked => {
                                    root.catalog-detail-scroll-y = max(
                                        catalog-detail-scroll.visible-height - catalog-detail-scroll.viewport-height,
                                        root.catalog-detail-scroll-y - 180px
                                    );
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if root.active-page == 8: Rectangle {
        x: (parent.width - root.shell-width) / 2 + root.sidebar-width + root.page-offset;
        width: root.page-width;
        height: parent.height;
        background: Palette.n50;
        VerticalLayout {
            padding: root.content-padding;
            spacing: root.narrow ? 12px : 16px;
            HorizontalLayout {
                height: 58px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: "Станция и лицензия"; color: Palette.n900; font-size: 26px; font-weight: 750; }
                    Text { text: root.license-status; color: root.license-server-online ? Palette.e700 : Palette.n500; font-size: 12px; overflow: elide; }
                }
                Rectangle { horizontal-stretch: 1; }
                StatusPill { text: root.license-server-online ? "Сервер доступен" : "Сервер недоступен"; good: root.license-server-online; }
                CompactActionButton { width: 152px; text: root.license-busy ? "ПРОВЕРКА…" : "ОБНОВИТЬ"; primary: true; enabled: !root.license-busy; clicked => { root.reload-license(); } }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: root.narrow ? 12px : 18px;
                Rectangle {
                    width: root.narrow ? 440px : 520px;
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: Palette.n200;
                    background: white;
                    VerticalLayout {
                        padding: root.narrow ? 14px : 18px;
                        spacing: root.narrow ? 10px : 13px;
                        Text { text: "РАБОЧАЯ СТАНЦИЯ"; color: Palette.n500; font-size: 10px; font-weight: 750; letter-spacing: 0.9px; }
                        Text { text: root.license-station-name; color: Palette.n900; font-size: 21px; font-weight: 800; wrap: word-wrap; }
                        ThinStatRow { compact: root.short; label: "Номер"; value: root.license-station-number; }
                        ThinStatRow { compact: root.short; label: "UUID"; value: root.license-station-uuid; }
                        ThinStatRow { compact: root.short; label: "Последняя синхронизация"; value: root.license-last-sync; }
                        Rectangle { height: 1px; background: Palette.n200; }
                        Text { text: "СЕРВЕР"; color: Palette.n500; font-size: 10px; font-weight: 750; letter-spacing: 0.9px; }
                        Text { text: "IP, host:port или URL"; color: Palette.n500; font-size: 11px; }
                        LineEdit { height: 50px; text <=> root.license-server-address; placeholder-text: "192.168.1.10 или http://server:8000"; accepted => { root.save-server-address(self.text); } }
                        HorizontalLayout {
                            height: 48px;
                            spacing: 9px;
                            CompactActionButton { horizontal-stretch: 1; text: "ПРОВЕРИТЬ"; enabled: !root.license-busy; clicked => { root.reload-license(); } }
                            CompactActionButton { horizontal-stretch: 1; text: "СОХРАНИТЬ"; primary: true; enabled: !root.license-busy; clicked => { root.save-server-address(root.license-server-address); } }
                        }
                        Rectangle {
                            min-height: 82px;
                            border-radius: 14px;
                            border-width: 1px;
                            border-color: !root.license-server-configured ? Palette.n300 : !root.license-server-online ? Palette.r300 : !root.license-server-compatible ? Palette.a300 : Palette.e300;
                            background: !root.license-server-configured ? Palette.n50 : !root.license-server-online ? Palette.r50 : !root.license-server-compatible ? Palette.a50 : Palette.e50;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;
                                Text { text: !root.license-server-configured ? "СЕРВЕР НЕ НАСТРОЕН" : !root.license-server-online ? "НЕТ СОЕДИНЕНИЯ" : !root.license-server-compatible ? "ТРЕБУЕТСЯ ОБНОВЛЕНИЕ КЛИЕНТА" : "СЕРВЕР ГОТОВ"; color: !root.license-server-configured ? Palette.n600 : !root.license-server-online ? Palette.r600 : !root.license-server-compatible ? Palette.a700 : Palette.e700; font-size: 11px; font-weight: 800; }
                                Text { text: root.license-compatibility == "" ? "Версия сервера " + root.license-server-version + " · минимум клиента " + root.license-min-client-version : root.license-compatibility; color: Palette.n600; font-size: 11px; wrap: word-wrap; }
                            }
                        }
                        Text { text: "Синхронизацию данных инициирует сервер; эта кнопка проверяет связь и лицензию без блокировки рабочего экрана."; color: Palette.n500; font-size: 11px; wrap: word-wrap; }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: root.license-active && !root.license-expired ? Palette.e300 : root.license-expired ? Palette.r300 : Palette.a300;
                    background: white;
                    clip: true;
                    ScrollView {
                        width: parent.width;
                        height: parent.height;
                        viewport-width: self.width;
                        VerticalLayout {
                            padding: root.narrow ? 14px : 18px;
                            spacing: 11px;
                            HorizontalLayout {
                                height: 48px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: root.license-edition; color: Palette.n900; font-size: 22px; font-weight: 800; overflow: elide; }
                                    Text { text: root.license-customer; color: Palette.n500; font-size: 12px; overflow: elide; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Rectangle { width: 116px; height: 34px; border-radius: 17px; background: root.license-active && !root.license-expired ? Palette.e100 : root.license-expired ? Palette.r100 : Palette.a50; Text { text: root.license-expired ? "ИСТЕКЛА" : root.license-mode; color: root.license-active && !root.license-expired ? Palette.e700 : root.license-expired ? Palette.r700 : Palette.a700; font-size: 11px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; overflow: elide; } }
                            }
                            ThinStatRow { compact: root.short; label: "Статус API"; value: root.license-online ? "Получен" : "Офлайн"; value-color: root.license-online ? Palette.e700 : Palette.a700; }
                            ThinStatRow { compact: root.short; label: "Действует до"; value: root.license-expires; }
                            ThinStatRow { compact: root.short; label: "Станции"; value: root.license-stations; }
                            ThinStatRow { compact: root.short; label: "License ID"; value: root.license-id; }
                            ThinStatRow { compact: root.short; label: "Подпись"; value: root.license-signature; value-color: root.license-active ? Palette.e700 : Palette.n700; }
                            ThinStatRow { compact: root.short; label: "Machine ID"; value: root.license-machine; }
                            Text { text: "ДОСТУПНЫЕ ФУНКЦИИ"; color: Palette.n500; font-size: 10px; font-weight: 750; letter-spacing: 0.9px; }
                            Rectangle {
                                min-height: 110px;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: Palette.n200;
                                background: Palette.n50;
                                Text { x: 14px; y: 14px; width: parent.width - 28px; text: root.license-features; color: Palette.n700; font-size: 12px; wrap: word-wrap; }
                            }
                            Rectangle {
                                min-height: 82px;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: root.license-active && !root.license-expired ? Palette.e300 : Palette.a300;
                                background: root.license-active && !root.license-expired ? Palette.e50 : Palette.a50;
                                VerticalLayout {
                                    padding: 13px;
                                    spacing: 4px;
                                    Text { text: root.license-active && !root.license-expired ? "ЛИЦЕНЗИЯ АКТИВНА" : root.license-expired ? "СРОК ЛИЦЕНЗИИ ИСТЁК" : "ДЕМОНСТРАЦИОННЫЙ РЕЖИМ"; color: root.license-active && !root.license-expired ? Palette.e700 : Palette.a700; font-size: 12px; font-weight: 800; }
                                    Text { text: root.license-online ? "Статус получен с настроенного сервера." : "Показан последний доступный локальный статус интерфейса."; color: Palette.n600; font-size: 11px; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.active-page == 9: Rectangle {
        x: (parent.width - root.shell-width) / 2 + root.sidebar-width + root.page-offset;
        width: root.page-width;
        height: parent.height;
        background: Palette.n50;
        VerticalLayout {
            padding: root.content-padding;
            spacing: root.narrow ? 12px : 18px;

            HorizontalLayout {
                height: root.short ? 48px : 58px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.update-page-title-label;
                        color: Palette.n900;
                        font-size: root.narrow ? 23px : 27px;
                        font-weight: 800;
                    }
                    Text {
                        text: root.update-error == "" ? root.update-status : root.update-error;
                        color: root.update-error == "" ? Palette.n500 : Palette.r600;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                Rectangle { horizontal-stretch: 1; }
                update-card := Rectangle {
                    width: min(820px, root.page-width - root.content-padding * 2);
                    border-radius: 22px;
                    border-width: 1px;
                    border-color: root.update-error != "" ? Palette.r300 : root.update-available ? Palette.e300 : Palette.n200;
                    background: white;

                    VerticalLayout {
                        padding: root.short ? 18px : root.narrow ? 22px : 28px;
                        spacing: root.short ? 10px : 14px;

                        Text {
                            text: root.update-current-label;
                            color: Palette.n500;
                            font-size: 11px;
                            font-weight: 750;
                            letter-spacing: 0.9px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "LabelPilot";
                            color: Palette.n900;
                            font-size: root.short ? 24px : 28px;
                            font-weight: 800;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.update-current-version;
                            color: Palette.n900;
                            font-size: root.short ? 34px : 42px;
                            font-weight: 800;
                            horizontal-alignment: center;
                        }

                        update-status-row := HorizontalLayout {
                            height: root.short ? 34px : 38px;
                            Rectangle { horizontal-stretch: 1; }
                            update-status-badge := Rectangle {
                                width: root.narrow ? 144px : 166px;
                                height: parent.height;
                                border-radius: parent.height / 2;
                                background: root.update-ready || root.update-available ? Palette.a50 : Palette.e100;
                                Text {
                                    text: root.update-ready ? root.update-ready-label : root.update-available ? root.update-available-label : root.update-actual-label;
                                    color: root.update-ready || root.update-available ? Palette.a700 : Palette.e700;
                                    font-size: 11px;
                                    font-weight: 800;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        Text {
                            text: root.update-busy
                                ? root.update-status
                                : root.update-available
                                    ? root.update-available-label + ": " + root.update-available-version
                                    : root.update-current-message-label;
                            color: root.update-available ? Palette.e700 : Palette.n600;
                            font-size: root.narrow ? 13px : 14px;
                            font-weight: root.update-available ? 700 : 500;
                            horizontal-alignment: center;
                            overflow: elide;
                        }

                        if root.update-error != "": Rectangle {
                            min-height: 64px;
                            border-radius: 14px;
                            border-width: 1px;
                            border-color: Palette.r300;
                            background: Palette.r50;
                            Text {
                                x: 14px;
                                y: 10px;
                                width: parent.width - 28px;
                                height: parent.height - 20px;
                                text: root.update-error;
                                color: Palette.r700;
                                font-size: 12px;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        if root.update-available: Rectangle {
                            min-height: root.short ? 82px : 108px;
                            border-radius: 15px;
                            border-width: 1px;
                            border-color: Palette.n200;
                            background: Palette.n50;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 6px;
                                Text {
                                    text: root.update-changes-label;
                                    color: Palette.n500;
                                    font-size: 10px;
                                    font-weight: 800;
                                    letter-spacing: 0.8px;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: root.update-notes;
                                    color: Palette.n700;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    overflow: elide;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        if root.update-state == "downloading" || root.update-ready: VerticalLayout {
                            height: 52px;
                            spacing: 7px;
                            Text {
                                text: root.update-progress + "%";
                                color: root.update-ready ? Palette.e700 : Palette.n700;
                                font-size: 12px;
                                font-weight: 750;
                                horizontal-alignment: center;
                            }
                            Rectangle {
                                height: 12px;
                                border-radius: 6px;
                                background: Palette.n200;
                                clip: true;
                                Rectangle {
                                    width: parent.width * root.update-progress / 100;
                                    height: parent.height;
                                    border-radius: 6px;
                                    background: Palette.e500;
                                }
                            }
                        }

                        update-recovery-card := Rectangle {
                            min-height: root.update-rollback-available ? (root.short ? 122px : 138px) : (root.short ? 72px : 84px);
                            border-radius: 15px;
                            border-width: 1px;
                            border-color: root.update-rollback-available ? Palette.e300 : Palette.n200;
                            background: root.update-rollback-available ? Palette.e50 : Palette.n50;
                            VerticalLayout {
                                padding: root.short ? 10px : 12px;
                                spacing: 3px;
                                Text {
                                    text: root.update-protection-title-label;
                                    color: root.update-rollback-available ? Palette.e700 : Palette.n700;
                                    font-size: 10px;
                                    font-weight: 800;
                                    letter-spacing: 0.8px;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: root.update-rollback-available
                                        ? root.update-protection-ready-label
                                        : root.update-protection-planned-label;
                                    color: Palette.n800;
                                    font-size: root.short ? 11px : 12px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.update-protection-message-label;
                                    color: Palette.n500;
                                    font-size: root.short ? 10px : 11px;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }
                                if root.update-rollback-available: CompactActionButton {
                                    height: root.short ? 38px : 44px;
                                    text-size: root.short ? 10px : 11px;
                                    text: root.update-manual-restore-label;
                                    danger: true;
                                    enabled: !root.update-busy;
                                    clicked => { root.update-rollback-confirm-visible = true; }
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }

                        if !root.update-available: CompactActionButton {
                            height: 54px;
                            text-size: 14px;
                            text: root.update-busy ? root.update-checking-label : root.update-check-label;
                            primary: true;
                            enabled: !root.update-busy;
                            clicked => { root.check-update(); }
                        }
                        if root.update-available && !root.update-ready: CompactActionButton {
                            height: 54px;
                            text-size: 14px;
                            text: root.update-download-label;
                            primary: true;
                            enabled: !root.update-busy;
                            clicked => { root.download-update(); }
                        }
                        if root.update-ready: CompactActionButton {
                            height: 54px;
                            text-size: 14px;
                            text: root.update-install-label;
                            primary: true;
                            enabled: !root.update-busy;
                            clicked => { root.install-update(); }
                        }

                        if !root.update-available && !root.update-ready: Rectangle {
                            height: 1px;
                            background: Palette.n200;
                        }
                        if !root.update-available && !root.update-ready: CompactActionButton {
                            height: 50px;
                            text: root.update-offline-visible ? root.update-usb-hide-label : root.update-usb-label;
                            enabled: !root.update-busy;
                            clicked => { root.update-offline-visible = !root.update-offline-visible; }
                        }
                        if root.update-offline-visible && !root.update-available && !root.update-ready: Rectangle {
                            min-height: 132px;
                            border-radius: 15px;
                            border-width: 1px;
                            border-color: Palette.n200;
                            background: Palette.n50;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                LineEdit {
                                    height: 48px;
                                    text <=> root.update-offline-path;
                                    placeholder-text: root.update-usb-path-label;
                                    accepted => { root.stage-offline-update(self.text); }
                                }
                                CompactActionButton {
                                    height: 48px;
                                    text: root.update-usb-check-label;
                                    enabled: !root.update-busy && root.update-offline-path != "";
                                    clicked => { root.stage-offline-update(root.update-offline-path); }
                                }
                            }
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
    if root.update-rollback-confirm-visible: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000cc;
        Rectangle {
            width: root.medium-dialog-width;
            height: min(root.dialog-max-height, root.short ? 390px : 430px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 30px;
            border-width: 1px;
            border-color: Palette.a300;
            background: white;
            VerticalLayout {
                padding: root.short ? 24px : 34px;
                spacing: root.short ? 11px : 16px;
                VerticalIcon {
                    icon-size: root.short ? 46px : 54px;
                    icon: @image-url("../assets/icons/list-restart.png");
                    icon-color: Palette.a600;
                }
                Text {
                    text: root.update-restore-title-label;
                    color: Palette.n900;
                    font-size: root.short ? 22px : 27px;
                    font-weight: 750;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.update-restore-message-label;
                    color: Palette.n600;
                    font-size: root.short ? 14px : 16px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.update-restore-restart-label;
                    color: Palette.a700;
                    font-size: root.short ? 13px : 14px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 12px;
                    MainButton {
                        horizontal-stretch: 1;
                        text: root.update-restore-back-label;
                        icon: @image-url("../assets/icons/x.png");
                        normal-color: Palette.n600;
                        hover-color: Palette.n500;
                        pressed-color: Palette.n700;
                        border-radius: 16px;
                        clicked => { root.update-rollback-confirm-visible = false; }
                    }
                    MainButton {
                        horizontal-stretch: 1;
                        text: root.update-restore-confirm-label;
                        icon: @image-url("../assets/icons/list-restart.png");
                        normal-color: Palette.a600;
                        hover-color: Palette.a500;
                        pressed-color: Palette.a700;
                        border-radius: 16px;
                        enabled: !root.update-busy;
                        clicked => {
                            root.update-rollback-confirm-visible = false;
                            root.rollback-update();
                        }
                    }
                }
            }
        }
    }

    if root.confirm-print-action-visible: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000cc;
        Rectangle {
            width: root.medium-dialog-width;
            height: min(root.dialog-max-height, root.short ? 380px : 410px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 30px;
            border-width: 1px;
            border-color: root.confirm-print-action == "cancel" ? Palette.r300 : root.confirm-print-uncertain ? Palette.a300 : Palette.e300;
            background: white;
            VerticalLayout {
                padding: 34px;
                spacing: 16px;
                VerticalIcon {
                    icon-size: 54px;
                    icon: root.confirm-print-action == "cancel" ? @image-url("../assets/icons/trash2-red.png") : @image-url("../assets/icons/list-restart.png");
                    icon-color: root.confirm-print-action == "cancel" ? Palette.r600 : root.confirm-print-uncertain ? Palette.a600 : Palette.e600;
                }
                Text {
                    text: root.confirm-print-action == "cancel" ? "Отменить задание?" : "Повторить печать?";
                    color: Palette.n900;
                    font-size: 27px;
                    font-weight: 750;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.confirm-print-action == "cancel"
                        ? "Задание #" + root.confirm-print-job-title + " будет удалено из активной очереди."
                        : root.confirm-print-uncertain
                            ? "Принтер мог уже принять задание #" + root.confirm-print-job-title + ". Повтор может создать дубликат этикетки."
                            : "Задание #" + root.confirm-print-job-title + " будет поставлено в очередь повторно.";
                    color: root.confirm-print-uncertain ? Palette.a700 : Palette.n600;
                    font-size: 17px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 12px;
                    MainButton {
                        horizontal-stretch: 1;
                        text: "НАЗАД";
                        icon: @image-url("../assets/icons/x.png");
                        normal-color: Palette.n600;
                        hover-color: Palette.n500;
                        pressed-color: Palette.n700;
                        border-radius: 16px;
                        clicked => { root.confirm-print-action-visible = false; }
                    }
                    MainButton {
                        horizontal-stretch: 1;
                        text: root.confirm-print-action == "cancel" ? "ОТМЕНИТЬ" : "ПОВТОРИТЬ";
                        icon: root.confirm-print-action == "cancel" ? @image-url("../assets/icons/trash2-red.png") : @image-url("../assets/icons/list-restart.png");
                        normal-color: root.confirm-print-action == "cancel" ? Palette.r600 : root.confirm-print-uncertain ? Palette.a600 : Palette.e600;
                        hover-color: root.confirm-print-action == "cancel" ? Palette.r500 : root.confirm-print-uncertain ? Palette.a500 : Palette.e500;
                        pressed-color: root.confirm-print-action == "cancel" ? Palette.r700 : root.confirm-print-uncertain ? Palette.a700 : Palette.e700;
                        border-radius: 16px;
                        clicked => {
                            if root.confirm-print-action == "retry" {
                                root.retry-print-job(root.confirm-print-job-id);
                            } else {
                                root.cancel-print-job(root.confirm-print-job-id);
                            }
                            root.confirm-print-action-visible = false;
                        }
                    }
                }
            }
        }
    }

    if root.toast-visible: Rectangle {
        width: root.small-dialog-width;
        height: 52px;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 32px;
        border-radius: 16px;
        background: Palette.e600;
        drop-shadow-color: #10b98199;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            HorizontalIcon {
                icon-size: 20px;
                icon: @image-url("../assets/icons/printer-white.png");
                icon-color: white;
            }
            Text {
                text: root.toast-text;
                color: white;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }


    if root.fixed-product-modal-visible: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000cc;

        Rectangle {
            width: root.large-dialog-width;
            height: root.touch-keyboard-visible ? root.dialog-max-height : min(root.dialog-max-height, root.tall ? 680px : 560px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 32px;
            border-width: 1px;
            border-color: Palette.n200;
            background: white;
            drop-shadow-color: #00000080;
            drop-shadow-blur: 30px;

            VerticalLayout {
                padding: root.short ? 16px : 24px;
                spacing: root.short ? 7px : 10px;
                Text { text: root.fixed-product-dialog-title; color: Palette.n900; font-size: root.short ? 22px : 27px; font-weight: 750; horizontal-alignment: center; }
                Text { text: root.fixed-product-dialog-hint; color: Palette.n500; font-size: 14px; horizontal-alignment: center; }
                HorizontalLayout {
                    height: root.short ? 48px : 52px;
                    spacing: root.short ? 6px : 10px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.fixed-product-search;
                        placeholder-text: root.product-search-placeholder;
                        edited => { root.fixed-product-scroll-y = 0px; root.search-fixed-products(self.text); }
                        accepted => { root.fixed-product-scroll-y = 0px; root.search-fixed-products(self.text); root.touch-keyboard-visible = false; }
                    }
                    CompactActionButton {
                        width: root.short ? 116px : 138px;
                        height: root.short ? 48px : 52px;
                        text: root.touch-keyboard-visible ? root.hide-keyboard-label : root.keyboard-label;
                        primary: root.touch-keyboard-visible;
                        clicked => { root.touch-keyboard-visible = !root.touch-keyboard-visible; }
                    }
                    MainButton {
                        width: root.short ? 118px : 138px;
                        height: root.short ? 48px : 52px;
                        text: root.product-search-label;
                        icon: @image-url("../assets/icons/search.png");
                        border-radius: 14px;
                        clicked => { root.fixed-product-scroll-y = 0px; root.search-fixed-products(root.fixed-product-search); root.touch-keyboard-visible = false; }
                    }
                }
                if root.touch-keyboard-visible: TouchKeyboard {
                    layout <=> root.touch-keyboard-layout;
                    uppercase <=> root.touch-keyboard-uppercase;
                    compact: root.short;
                    space-label: root.keyboard-space-label;
                    clear-label: root.keyboard-clear-label;
                    done-label: root.keyboard-done-label;
                    key-pressed(key, uppercase) => { root.fixed-product-search = root.edit-touch-text(root.fixed-product-search, key, uppercase); root.fixed-product-scroll-y = 0px; root.search-fixed-products(root.fixed-product-search); }
                    backspace => { root.fixed-product-search = root.edit-touch-text(root.fixed-product-search, "__BACKSPACE__", false); root.fixed-product-scroll-y = 0px; root.search-fixed-products(root.fixed-product-search); }
                    clear => { root.fixed-product-search = ""; root.fixed-product-scroll-y = 0px; root.search-fixed-products(""); }
                    done => { root.fixed-product-scroll-y = 0px; root.search-fixed-products(root.fixed-product-search); root.touch-keyboard-visible = false; }
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 8px;
                    fixed-product-scroll := ScrollView {
                        horizontal-stretch: 1;
                        viewport-width: self.width;
                        viewport-y <=> root.fixed-product-scroll-y;
                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                        mouse-drag-pan-enabled: true;
                        VerticalLayout {
                            spacing: 8px;
                            if root.fixed-products.length == 0: Text {
                                height: 80px;
                                text: root.fixed-busy ? "…" : root.fixed-product-empty-label;
                                color: Palette.n500;
                                font-size: 15px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            for product[index] in root.fixed-products: Rectangle {
                                height: 70px;
                                border-radius: 14px;
                                border-width: product.id == root.fixed-selected-product-id ? 2px : 1px;
                                border-color: product.id == root.fixed-selected-product-id ? Palette.e400 : Palette.n300;
                                background: fixed-row-touch.pressed ? Palette.e100 : fixed-row-touch.has-hover ? Palette.e50 : Palette.n50;
                                HorizontalLayout {
                                    padding-left: 15px;
                                    padding-right: 15px;
                                    spacing: 12px;
                                    Rectangle {
                                        width: 42px;
                                        vertical-stretch: 1;
                                        background: transparent;
                                        Rectangle {
                                            width: 42px;
                                            height: 42px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 12px;
                                            background: Palette.e100;
                                            AppIcon { width: 22px; height: 22px; x: 10px; y: 10px; icon: @image-url("../assets/icons/weight.png"); icon-color: Palette.e600; }
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 3px;
                                        Text { text: product.name; color: Palette.n900; font-size: 15px; font-weight: 700; horizontal-alignment: center; overflow: elide; }
                                        Text { text: product.details; color: Palette.n500; font-size: 11px; horizontal-alignment: center; overflow: elide; }
                                    }
                                    Rectangle { width: 42px; vertical-stretch: 1; background: transparent; }
                                }
                                fixed-row-touch := TouchArea { enabled: !root.fixed-busy; clicked => { root.select-fixed-product(index); } }
                            }
                        }
                        }
                    if root.fixed-products.length > 3: VerticalLayout {
                        width: 52px;
                        TouchScrollStepButton {
                            glyph: "▲";
                            enabled: root.fixed-product-scroll-y < 0px;
                            clicked => { root.fixed-product-scroll-y = min(0px, root.fixed-product-scroll-y + 156px); }
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        TouchScrollStepButton {
                            glyph: "▼";
                            enabled: fixed-product-scroll.viewport-height > fixed-product-scroll.visible-height && root.fixed-product-scroll-y > fixed-product-scroll.visible-height - fixed-product-scroll.viewport-height;
                            clicked => { root.fixed-product-scroll-y = max(fixed-product-scroll.visible-height - fixed-product-scroll.viewport-height, root.fixed-product-scroll-y - 156px); }
                        }
                    }
                }
                MainButton {
                    text: root.close-label;
                    icon: @image-url("../assets/icons/x.png");
                    border-radius: 16px;
                    normal-color: Palette.n800;
                    hover-color: Palette.n700;
                    pressed-color: Palette.n900;
                    clicked => { root.fixed-product-modal-visible = false; root.touch-keyboard-visible = false; }
                }
            }
        }
    }

    if root.fixed-quantity-keypad-visible: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000cc;

        Rectangle {
            width: root.small-dialog-width;
            height: min(root.dialog-max-height, root.short ? 510px : 560px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 28px;
            border-width: 1px;
            border-color: Palette.n200;
            background: white;
            drop-shadow-color: #00000080;
            drop-shadow-blur: 30px;

            VerticalLayout {
                padding: root.short ? 16px : 22px;
                spacing: root.short ? 7px : 10px;

                Text { text: root.fixed-quantity-dialog-title; color: Palette.n900; font-size: root.short ? 22px : 26px; font-weight: 750; horizontal-alignment: center; }
                Text { text: root.fixed-quantity-dialog-hint; color: Palette.n500; font-size: 13px; horizontal-alignment: center; }

                Rectangle {
                    height: root.short ? 54px : 64px;
                    border-radius: 14px;
                    border-width: 2px;
                    border-color: Palette.e400;
                    background: Palette.e50;
                    Text { text: root.fixed-copies-draft == "" ? "—" : root.fixed-copies-draft; color: Palette.e700; font-family: "Consolas"; font-size: root.short ? 28px : 34px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                }

                HorizontalLayout {
                    spacing: 9px;
                    KeyButton { horizontal-stretch: 1; height: root.short ? 48px : 56px; text: "1"; clicked => { root.fixed-copies-draft = root.edit-fixed-copies(root.fixed-copies-draft, "1"); } }
                    KeyButton { horizontal-stretch: 1; height: root.short ? 48px : 56px; text: "2"; clicked => { root.fixed-copies-draft = root.edit-fixed-copies(root.fixed-copies-draft, "2"); } }
                    KeyButton { horizontal-stretch: 1; height: root.short ? 48px : 56px; text: "3"; clicked => { root.fixed-copies-draft = root.edit-fixed-copies(root.fixed-copies-draft, "3"); } }
                }
                HorizontalLayout {
                    spacing: 9px;
                    KeyButton { horizontal-stretch: 1; height: root.short ? 48px : 56px; text: "4"; clicked => { root.fixed-copies-draft = root.edit-fixed-copies(root.fixed-copies-draft, "4"); } }
                    KeyButton { horizontal-stretch: 1; height: root.short ? 48px : 56px; text: "5"; clicked => { root.fixed-copies-draft = root.edit-fixed-copies(root.fixed-copies-draft, "5"); } }
                    KeyButton { horizontal-stretch: 1; height: root.short ? 48px : 56px; text: "6"; clicked => { root.fixed-copies-draft = root.edit-fixed-copies(root.fixed-copies-draft, "6"); } }
                }
                HorizontalLayout {
                    spacing: 9px;
                    KeyButton { horizontal-stretch: 1; height: root.short ? 48px : 56px; text: "7"; clicked => { root.fixed-copies-draft = root.edit-fixed-copies(root.fixed-copies-draft, "7"); } }
                    KeyButton { horizontal-stretch: 1; height: root.short ? 48px : 56px; text: "8"; clicked => { root.fixed-copies-draft = root.edit-fixed-copies(root.fixed-copies-draft, "8"); } }
                    KeyButton { horizontal-stretch: 1; height: root.short ? 48px : 56px; text: "9"; clicked => { root.fixed-copies-draft = root.edit-fixed-copies(root.fixed-copies-draft, "9"); } }
                }
                HorizontalLayout {
                    spacing: 9px;
                    KeyButton { horizontal-stretch: 1; height: root.short ? 48px : 56px; text: "×"; clicked => { root.fixed-copies-draft = root.edit-fixed-copies(root.fixed-copies-draft, "__CLEAR__"); } }
                    KeyButton { horizontal-stretch: 1; height: root.short ? 48px : 56px; text: "0"; clicked => { root.fixed-copies-draft = root.edit-fixed-copies(root.fixed-copies-draft, "0"); } }
                    KeyButton { horizontal-stretch: 1; height: root.short ? 48px : 56px; text: "⌫"; clicked => { root.fixed-copies-draft = root.edit-fixed-copies(root.fixed-copies-draft, "__BACKSPACE__"); } }
                }

                HorizontalLayout {
                    height: root.short ? 48px : 54px;
                    spacing: 10px;
                    CompactActionButton { horizontal-stretch: 1; height: parent.height; text: root.fixed-cancel-label; clicked => { root.fixed-quantity-keypad-visible = false; root.fixed-copies-draft = ""; } }
                    CompactActionButton { horizontal-stretch: 1; height: parent.height; text: root.fixed-apply-label; primary: true; enabled: root.fixed-copies-draft != ""; clicked => { root.fixed-copies = root.fixed-copies-draft; root.fixed-copies-draft = ""; root.fixed-quantity-keypad-visible = false; } }
                }
            }
        }
    }
    if root.product-modal-visible: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000cc;

        Rectangle {
            width: root.large-dialog-width;
            height: root.touch-keyboard-visible ? root.dialog-max-height : min(root.dialog-max-height, root.tall ? 640px : 520px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 32px;
            border-width: 1px;
            border-color: Palette.n200;
            background: white;
            drop-shadow-color: #00000080;
            drop-shadow-blur: 30px;

            VerticalLayout {
                padding: root.short ? 16px : 24px;
                spacing: root.short ? 7px : 10px;
                Text {
                    text: root.product-picker-title;
                    color: Palette.n900;
                    font-size: root.short ? 22px : 28px;
                    font-weight: 700;
                }
                Text {
                    text: root.product-picker-hint;
                    color: Palette.n500;
                    font-size: 15px;
                }
                HorizontalLayout {
                    height: root.short ? 48px : 52px;
                    spacing: root.short ? 6px : 10px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.product-search;
                        placeholder-text: root.product-search-placeholder;
                        edited => { root.product-scroll-y = 0px; root.search-products(self.text); }
                        accepted => { root.product-scroll-y = 0px; root.search-products(self.text); root.touch-keyboard-visible = false; }
                    }
                    CompactActionButton {
                        width: root.short ? 116px : 138px;
                        height: root.short ? 48px : 52px;
                        text: root.touch-keyboard-visible ? root.hide-keyboard-label : root.keyboard-label;
                        primary: root.touch-keyboard-visible;
                        clicked => { root.touch-keyboard-visible = !root.touch-keyboard-visible; }
                    }
                    MainButton {
                        width: root.short ? 118px : 138px;
                        height: root.short ? 48px : 52px;
                        text: root.product-search-busy ? "…" : root.product-search-label;
                        icon: @image-url("../assets/icons/search.png");
                        border-radius: 14px;
                        clicked => { root.product-scroll-y = 0px; root.search-products(root.product-search); root.touch-keyboard-visible = false; }
                    }
                }
                if root.touch-keyboard-visible: TouchKeyboard {
                    layout <=> root.touch-keyboard-layout;
                    uppercase <=> root.touch-keyboard-uppercase;
                    compact: root.short;
                    space-label: root.keyboard-space-label;
                    clear-label: root.keyboard-clear-label;
                    done-label: root.keyboard-done-label;
                    key-pressed(key, uppercase) => { root.product-search = root.edit-touch-text(root.product-search, key, uppercase); root.product-scroll-y = 0px; root.search-products(root.product-search); }
                    backspace => { root.product-search = root.edit-touch-text(root.product-search, "__BACKSPACE__", false); root.product-scroll-y = 0px; root.search-products(root.product-search); }
                    clear => { root.product-search = ""; root.product-scroll-y = 0px; root.search-products(""); }
                    done => { root.product-scroll-y = 0px; root.search-products(root.product-search); root.touch-keyboard-visible = false; }
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 8px;
                    product-scroll := ScrollView {
                        horizontal-stretch: 1;
                        viewport-width: self.width;
                        viewport-y <=> root.product-scroll-y;
                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                        mouse-drag-pan-enabled: true;
                        VerticalLayout {
                            spacing: 8px;
                            if root.products.length == 0: Text {
                                height: 72px;
                                text: root.product-search-busy ? "…" : root.product-empty-label;
                                color: Palette.n500;
                                font-size: 16px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            for product[index] in root.products: Rectangle {
                                height: 64px;
                                border-radius: 14px;
                                border-width: 1px;
                                border-color: product.id == root.selected-product-id ? Palette.e400 : Palette.n300;
                                background: product-row-touch.pressed ? Palette.e100 : product-row-touch.has-hover ? Palette.e50 : Palette.n50;
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 12px;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 3px;
                                        Text {
                                            text: product.name;
                                            color: Palette.n900;
                                            font-size: 16px;
                                            font-weight: 600;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: product.details;
                                            color: Palette.n500;
                                            font-size: 12px;
                                            overflow: elide;
                                        }
                                    }
                                    HorizontalIcon {
                                        icon-size: 20px;
                                        icon: @image-url("../assets/icons/package.png");
                                        icon-color: product.id == root.selected-product-id ? Palette.e600 : Palette.n400;
                                    }
                                }
                                product-row-touch := TouchArea {
                                    clicked => {
                                        root.select-product(index);
                                        root.product-modal-visible = false;
                                        root.touch-keyboard-visible = false;
                                    }
                                }
                            }
                        }
                    }
                    if root.products.length > 3: VerticalLayout {
                        width: 52px;
                        TouchScrollStepButton {
                            glyph: "▲";
                            enabled: root.product-scroll-y < 0px;
                            clicked => { root.product-scroll-y = min(0px, root.product-scroll-y + 144px); }
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        TouchScrollStepButton {
                            glyph: "▼";
                            enabled: product-scroll.viewport-height > product-scroll.visible-height && root.product-scroll-y > product-scroll.visible-height - product-scroll.viewport-height;
                            clicked => { root.product-scroll-y = max(product-scroll.visible-height - product-scroll.viewport-height, root.product-scroll-y - 144px); }
                        }
                    }
                }
                MainButton {
                    text: root.close-label;
                    icon: @image-url("../assets/icons/x.png");
                    border-radius: 16px;
                    normal-color: Palette.n800;
                    hover-color: Palette.n700;
                    pressed-color: Palette.n900;
                    clicked => { root.product-modal-visible = false; root.touch-keyboard-visible = false; }
                }
            }
        }
    }

    if root.keypad-visible: Rectangle {
        height: parent.height;
        background: #000000cc;

        Rectangle {
            width: root.small-dialog-width;
            height: min(root.dialog-max-height, root.tall ? 660px : 590px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 32px;
            background: white;

            VerticalLayout {
                padding: 24px;
                spacing: 11px;
                Text {
                    text: "Номер партии";
                    color: Palette.n900;
                    font-size: 25px;
                    font-weight: 700;
                }
                Rectangle {
                    height: 58px;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Palette.e300;
                    background: Palette.e50;
                    Text {
                        text: root.batch-number;
                        color: Palette.e700;
                        font-family: "Consolas";
                        font-size: 24px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 9px;
                    KeyButton { horizontal-stretch: 1; text: "1"; clicked => { root.batch-number += "1"; } }
                    KeyButton { horizontal-stretch: 1; text: "2"; clicked => { root.batch-number += "2"; } }
                    KeyButton { horizontal-stretch: 1; text: "3"; clicked => { root.batch-number += "3"; } }
                }
                HorizontalLayout {
                    spacing: 9px;
                    KeyButton { horizontal-stretch: 1; text: "4"; clicked => { root.batch-number += "4"; } }
                    KeyButton { horizontal-stretch: 1; text: "5"; clicked => { root.batch-number += "5"; } }
                    KeyButton { horizontal-stretch: 1; text: "6"; clicked => { root.batch-number += "6"; } }
                }
                HorizontalLayout {
                    spacing: 9px;
                    KeyButton { horizontal-stretch: 1; text: "7"; clicked => { root.batch-number += "7"; } }
                    KeyButton { horizontal-stretch: 1; text: "8"; clicked => { root.batch-number += "8"; } }
                    KeyButton { horizontal-stretch: 1; text: "9"; clicked => { root.batch-number += "9"; } }
                }
                HorizontalLayout {
                    spacing: 9px;
                    KeyButton { horizontal-stretch: 1; text: "-"; clicked => { root.batch-number += "-"; } }
                    KeyButton { horizontal-stretch: 1; text: "0"; clicked => { root.batch-number += "0"; } }
                    KeyButton { horizontal-stretch: 1; text: "⌫"; clicked => { root.batch-number = ""; } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    MainButton {
                        horizontal-stretch: 1;
                        text: "ОЧИСТИТЬ";
                        icon: @image-url("../assets/icons/x.png");
                        border-radius: 16px;
                        normal-color: Palette.n600;
                        hover-color: Palette.n500;
                        pressed-color: Palette.n700;
                        clicked => { root.batch-number = ""; }
                    }
                    MainButton {
                        horizontal-stretch: 1;
                        text: "ГОТОВО";
                        icon: @image-url("../assets/icons/check-circle2.png");
                        border-radius: 16px;
                        clicked => { root.keypad-visible = false; }
                    }
                }
            }
        }
    }

    if root.date-modal-visible: Rectangle {
        height: parent.height;
        background: #000000cc;

        Rectangle {
            width: root.medium-dialog-width;
            height: min(root.dialog-max-height, root.short ? 552px : 620px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 32px;
            background: white;

            VerticalLayout {
                padding: root.short ? 18px : 24px;
                spacing: root.short ? 8px : 10px;
                Text {
                    text: root.production-date-title;
                    color: Palette.n900;
                    font-size: root.short ? 23px : 27px;
                    font-weight: 700;
                }
                Text {
                    text: root.production-date-hint;
                    color: Palette.n500;
                    font-size: root.short ? 13px : 15px;
                }

                HorizontalLayout {
                    height: root.short ? 46px : 50px;
                    spacing: 10px;
                    CalendarNavButton {
                        compact: root.short;
                        height: parent.height;
                        text: "‹";
                        clicked => { root.shift-calendar-month(-1); }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.calendar-month-label;
                        color: Palette.n900;
                        font-size: root.short ? 17px : 19px;
                        font-weight: 750;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    CalendarNavButton {
                        compact: root.short;
                        height: parent.height;
                        text: "›";
                        clicked => { root.shift-calendar-month(1); }
                    }
                }

                HorizontalLayout {
                    height: 24px;
                    spacing: root.short ? 4px : 6px;
                    for weekday in root.calendar-weekdays: Text {
                        horizontal-stretch: 1;
                        text: weekday;
                        color: Palette.n500;
                        font-size: root.short ? 10px : 11px;
                        font-weight: 750;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                GridLayout {
                    height: root.short ? 252px : 294px;
                    spacing-horizontal: root.short ? 4px : 6px;
                    spacing-vertical: root.short ? 4px : 6px;
                    for week-index in 6: Row {
                        for day-index in 7: CalendarDayButton {
                            compact: root.short;
                            day: root.calendar-days[week-index * 7 + day-index];
                            clicked => {
                                root.labeling-date = self.day.date;
                                root.date-modal-visible = false;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    height: 48px;
                    spacing: 10px;
                    CompactActionButton {
                        horizontal-stretch: 1;
                        height: 48px;
                        text: root.today-label + " · " + root.today-date;
                        primary: true;
                        clicked => {
                            root.labeling-date = root.today-date;
                            root.date-modal-visible = false;
                        }
                    }
                    CompactActionButton {
                        horizontal-stretch: 1;
                        height: 48px;
                        text: root.close-label;
                        clicked => { root.date-modal-visible = false; }
                    }
                }
            }
        }
    }

    if root.delete-modal-visible: Rectangle {
        height: parent.height;
        background: #000000cc;

        Rectangle {
            width: root.medium-dialog-width;
            height: min(root.dialog-max-height, 390px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 32px;
            background: white;

            VerticalLayout {
                padding: 32px;
                spacing: 16px;
                VerticalIcon {
                    icon-size: 52px;
                    icon: @image-url("../assets/icons/trash2-red.png");
                    icon-color: Palette.r500;
                }
                Text {
                    text: "Удалить последнюю упаковку?";
                    color: Palette.n900;
                    font-size: 27px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Счётчик текущего короба и общий счётчик упаковок будут уменьшены на один.";
                    color: Palette.n500;
                    font-size: 17px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 12px;
                    MainButton {
                        horizontal-stretch: 1;
                        text: "ОТМЕНА";
                        icon: @image-url("../assets/icons/x.png");
                        border-radius: 16px;
                        normal-color: Palette.n600;
                        hover-color: Palette.n500;
                        pressed-color: Palette.n700;
                        clicked => { root.delete-modal-visible = false; }
                    }
                    MainButton {
                        horizontal-stretch: 1;
                        text: "УДАЛИТЬ";
                        icon: @image-url("../assets/icons/trash2-red.png");
                        border-radius: 16px;
                        normal-color: Palette.r600;
                        hover-color: Palette.r500;
                        pressed-color: Palette.r700;
                        clicked => {
                            root.delete-modal-visible = false;
                            root.delete-last();
                        }
                    }
                }
            }
        }
    }

    if root.alert-visible: Rectangle {
        height: parent.height;
        background: #000000cc;

        Rectangle {
            width: root.large-dialog-width;
            height: min(root.dialog-max-height, root.tall ? 520px : 430px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 32px;
            border-width: 1px;
            border-color: Palette.n200;
            background: white;

            VerticalLayout {
                padding: 40px;
                spacing: 16px;
                HorizontalLayout {
                    height: 96px;
                    alignment: center;
                    Rectangle {
                        width: 96px;
                        height: 96px;
                        border-radius: 48px;
                        background: Palette.r100;
                        AppIcon {
                            width: 48px;
                            height: 48px;
                            x: 24px;
                            y: 24px;
                            icon: @image-url("../assets/icons/alert-red.png");
                            icon-color: Palette.r500;
                        }
                    }
                }
                Text {
                    text: "Внимание";
                    color: Palette.n900;
                    font-size: 30px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.alert-text;
                    color: Palette.n600;
                    font-size: 20px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                MainButton {
                    height: 64px;
                    text: "ПОНЯТНО";
                    icon: @image-url("../assets/icons/check-circle2.png");
                    normal-color: Palette.n800;
                    hover-color: Palette.n700;
                    pressed-color: Palette.n900;
                    border-radius: 16px;
                    clicked => { root.alert-visible = false; }
                }
            }
        }
    }

    if root.operator-login-visible: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #f5f5f5fa;
        Rectangle {
            width: root.operator-dialog-width;
            height: root.operator-dialog-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 32px;
            border-width: 1px;
            border-color: Palette.n200;
            background: white;
            drop-shadow-color: #00000035;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 10px;
            VerticalLayout {
                padding: root.short ? 22px : 32px;
                spacing: root.short ? 10px : 16px;
                HorizontalLayout {
                    height: 64px;
                    alignment: center;
                    spacing: 16px;
                    Rectangle {
                        width: 58px;
                        vertical-stretch: 1;
                        Rectangle {
                            width: 58px;
                            height: 58px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 18px;
                            border-width: 1px;
                            border-color: Palette.e200;
                            background: Palette.e50;
                            AppIcon { width: 30px; height: 30px; x: 14px; y: 14px; icon: @image-url("../assets/icons/user.png"); icon-color: Palette.e600; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text { text: "Выберите оператора"; color: Palette.n900; font-size: 28px; font-weight: 700; }
                        Text { text: "Коснитесь имени для входа"; color: Palette.n500; font-size: 15px; }
                    }
                }
                if root.operator-login-error != "": Rectangle {
                    height: 52px;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Palette.r300;
                    background: Palette.r50;
                    Text { text: root.operator-login-error; color: Palette.r700; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
                }
                ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    VerticalLayout {
                        spacing: 10px;
                        if root.operators.length == 0: Rectangle {
                            height: 170px;
                            border-radius: 22px;
                            border-width: 1px;
                            border-color: Palette.n200;
                            background: Palette.n50;
                            VerticalLayout {
                                alignment: center;
                                spacing: 12px;
                                VerticalIcon { icon-size: 44px; icon: @image-url("../assets/icons/user.png"); icon-color: Palette.n400; }
                                Text { text: "Операторы ещё не загружены"; color: Palette.n700; font-size: 18px; font-weight: 600; horizontal-alignment: center; }
                                Text { text: "Рабочий экран доступен без блокировки"; color: Palette.n500; font-size: 14px; horizontal-alignment: center; }
                            }
                        }
                        for operator[index] in root.operators: Rectangle {
                            height: root.short ? 64px : 76px;
                            border-radius: 18px;
                            border-width: operator.is-last ? 2px : 1px;
                            border-color: operator.is-last ? Palette.e400 : Palette.n300;
                            background: operator-row-touch.pressed ? Palette.e100 : operator-row-touch.has-hover ? Palette.e50 : operator.is-last ? #ecfdf580 : Palette.n50;
                            HorizontalLayout {
                                padding-left: 18px;
                                padding-right: 18px;
                                spacing: 14px;
                                Rectangle {
                                    width: 46px;
                                    vertical-stretch: 1;
                                    Rectangle {
                                        width: 46px;
                                        height: 46px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 23px;
                                        background: operator.is-last ? Palette.e100 : Palette.n100;
                                        AppIcon { width: 24px; height: 24px; x: 11px; y: 11px; icon: @image-url("../assets/icons/user.png"); icon-color: operator.is-last ? Palette.e600 : Palette.n500; }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;
                                    Text { text: operator.full-name; color: Palette.n900; font-size: 17px; font-weight: 700; overflow: elide; }
                                    Text { text: operator.short-code == "" ? "Без кода" : "Код " + operator.short-code; color: Palette.n500; font-family: "Consolas"; font-size: 12px; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: operator.has-pin ? "PIN" : "ВХОД"; color: Palette.e600; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                            }
                            operator-row-touch := TouchArea {
                                enabled: !root.operator-login-busy;
                                clicked => { root.operator-login-error = ""; root.select-operator(index); }
                            }
                        }
                    }
                }
                if root.operators.length == 0: MainButton {
                    text: "ПРОДОЛЖИТЬ БЕЗ ОПЕРАТОРА";
                    icon: @image-url("../assets/icons/check-circle2.png");
                    border-radius: 16px;
                    normal-color: Palette.n700;
                    hover-color: Palette.n600;
                    pressed-color: Palette.n800;
                    clicked => { root.continue-without-operator(); }
                }
                operator-exit-button := MainButton {
                    height: 60px;
                    text: root.exit-label;
                    icon: @image-url("../assets/icons/log-out-red.png");
                    border-radius: 16px;
                    normal-color: Palette.r600;
                    hover-color: Palette.r500;
                    pressed-color: Palette.r700;
                    clicked => { root.quit-app(); }
                }
            }
        }
    }

    if root.operator-pin-visible: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000cc;
        Rectangle {
            width: root.small-dialog-width;
            height: min(root.dialog-max-height, root.tall ? 680px : 620px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 32px;
            border-width: 1px;
            border-color: Palette.n200;
            background: white;
            VerticalLayout {
                padding: 24px;
                spacing: 10px;
                Text { text: "Введите PIN"; color: Palette.n900; font-size: 26px; font-weight: 700; horizontal-alignment: center; }
                Text { text: root.selected-operator-name; color: Palette.n500; font-size: 16px; horizontal-alignment: center; overflow: elide; }
                Rectangle {
                    height: 58px;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: root.operator-login-error == "" ? Palette.e300 : Palette.r300;
                    background: root.operator-login-error == "" ? Palette.e50 : Palette.r50;
                    if root.operator-pin == "": Text {
                        width: parent.width;
                        height: parent.height;
                        text: "—";
                        color: Palette.e700;
                        font-size: 25px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if root.operator-pin != "": HorizontalLayout {
                        width: parent.width;
                        height: parent.height;
                        alignment: center;
                        spacing: 7px;
                        padding-left: 12px;
                        padding-right: 12px;
                        for _[index] in root.operator-pin-length: Text {
                            width: 14px;
                            text: "•";
                            color: Palette.e700;
                            font-size: 25px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                Text {
                    height: 20px;
                    text: root.operator-login-busy ? "Проверка PIN…" : root.operator-pin == "" ? "Коснитесь цифровой клавиши" : "Введено цифр: " + root.operator-pin-length;
                    color: root.operator-login-busy ? Palette.a600 : Palette.n500;
                    font-size: 13px;
                    font-weight: root.operator-login-busy ? 700 : 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if root.operator-login-error != "": Text { height: 30px; text: root.operator-login-error; color: Palette.r700; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 9px;
                    KeyButton { horizontal-stretch: 1; enabled: !root.operator-login-busy; text: "1"; clicked => { root.operator-pin += "1"; root.operator-login-error = ""; } }
                    KeyButton { horizontal-stretch: 1; enabled: !root.operator-login-busy; text: "2"; clicked => { root.operator-pin += "2"; root.operator-login-error = ""; } }
                    KeyButton { horizontal-stretch: 1; enabled: !root.operator-login-busy; text: "3"; clicked => { root.operator-pin += "3"; root.operator-login-error = ""; } }
                }
                HorizontalLayout {
                    spacing: 9px;
                    KeyButton { horizontal-stretch: 1; enabled: !root.operator-login-busy; text: "4"; clicked => { root.operator-pin += "4"; root.operator-login-error = ""; } }
                    KeyButton { horizontal-stretch: 1; enabled: !root.operator-login-busy; text: "5"; clicked => { root.operator-pin += "5"; root.operator-login-error = ""; } }
                    KeyButton { horizontal-stretch: 1; enabled: !root.operator-login-busy; text: "6"; clicked => { root.operator-pin += "6"; root.operator-login-error = ""; } }
                }
                HorizontalLayout {
                    spacing: 9px;
                    KeyButton { horizontal-stretch: 1; enabled: !root.operator-login-busy; text: "7"; clicked => { root.operator-pin += "7"; root.operator-login-error = ""; } }
                    KeyButton { horizontal-stretch: 1; enabled: !root.operator-login-busy; text: "8"; clicked => { root.operator-pin += "8"; root.operator-login-error = ""; } }
                    KeyButton { horizontal-stretch: 1; enabled: !root.operator-login-busy; text: "9"; clicked => { root.operator-pin += "9"; root.operator-login-error = ""; } }
                }
                HorizontalLayout {
                    spacing: 9px;
                    KeyButton { horizontal-stretch: 1; enabled: !root.operator-login-busy; text: "ОЧИСТИТЬ"; clicked => { root.operator-pin = ""; root.operator-login-error = ""; } }
                    KeyButton { horizontal-stretch: 1; enabled: !root.operator-login-busy; text: "0"; clicked => { root.operator-pin += "0"; root.operator-login-error = ""; } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    MainButton {
                        horizontal-stretch: 1;
                        text: "ОТМЕНА";
                        icon: @image-url("../assets/icons/x.png");
                        border-radius: 16px;
                        normal-color: Palette.n600;
                        hover-color: Palette.n500;
                        pressed-color: Palette.n700;
                        clicked => { root.operator-pin = ""; root.operator-pin-visible = false; root.operator-login-error = ""; }
                    }
                    MainButton {
                        horizontal-stretch: 1;
                        text: "ВОЙТИ";
                        icon: @image-url("../assets/icons/check-circle2.png");
                        border-radius: 16px;
                        enabled: root.operator-pin != "" && !root.operator-login-busy;
                        clicked => { root.submit-operator-pin(root.selected-operator-index, root.operator-pin); }
                    }
                }
            }
        }
    }
    if root.settings-input-keyboard-visible: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000cc;

        Rectangle {
            width: root.large-dialog-width;
            height: min(root.dialog-max-height, root.short ? 540px : 610px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 30px;
            border-width: 1px;
            border-color: Palette.n200;
            background: white;
            drop-shadow-color: #00000080;
            drop-shadow-blur: 30px;

            VerticalLayout {
                padding: root.short ? 16px : 22px;
                spacing: root.short ? 7px : 10px;

                Text {
                    text: root.settings-input-dialog-title;
                    color: Palette.n900;
                    font-size: root.short ? 22px : 27px;
                    font-weight: 750;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.settings-input-dialog-hint;
                    color: Palette.n500;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.settings-input-caption;
                    color: Palette.n600;
                    font-size: 11px;
                    font-weight: 750;
                    letter-spacing: 0.7px;
                    horizontal-alignment: center;
                }
                Rectangle {
                    height: root.short ? 54px : 64px;
                    border-radius: 14px;
                    border-width: 2px;
                    border-color: Palette.e400;
                    background: Palette.e50;
                    Text {
                        x: 14px;
                        width: parent.width - 28px;
                        text: root.settings-input-draft == "" ? "—" : root.settings-input-draft;
                        color: Palette.e700;
                        font-family: "Consolas";
                        font-size: root.short ? 23px : 28px;
                        font-weight: 750;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                TouchKeyboard {
                    layout <=> root.touch-keyboard-layout;
                    uppercase <=> root.touch-keyboard-uppercase;
                    compact: root.short;
                    roomy: true;
                    space-label: root.keyboard-space-label;
                    clear-label: root.keyboard-clear-label;
                    done-label: root.keyboard-done-label;
                    key-pressed(key, uppercase) => {
                        root.settings-input-draft = root.edit-touch-text(root.settings-input-draft, key, uppercase);
                    }
                    backspace => {
                        root.settings-input-draft = root.edit-touch-text(root.settings-input-draft, "__BACKSPACE__", false);
                    }
                    clear => { root.settings-input-draft = ""; }
                    done => {
                        if root.settings-input-target == "printer-ip" {
                            root.settings-ip = root.settings-input-draft;
                            root.settings-dirty = true;
                        } else if root.settings-input-target == "printer-port" {
                            root.settings-port = root.settings-input-draft;
                            root.settings-dirty = true;
                        } else if root.settings-input-target == "printer-baud" {
                            root.settings-baud-rate = root.settings-input-draft;
                            root.settings-dirty = true;
                        } else if root.settings-input-target == "scale-host" {
                            root.scale-settings-host = root.settings-input-draft;
                            root.scale-settings-dirty = true;
                        } else if root.settings-input-target == "scale-port" {
                            root.scale-settings-port = root.settings-input-draft;
                            root.scale-settings-dirty = true;
                        } else if root.settings-input-target == "scale-baud" {
                            root.scale-settings-baud-rate = root.settings-input-draft;
                            root.scale-settings-dirty = true;
                        }
                        root.settings-input-keyboard-visible = false;
                    }
                }
                CompactActionButton {
                    height: root.short ? 46px : 50px;
                    text: root.settings-cancel-label;
                    clicked => {
                        root.settings-input-keyboard-visible = false;
                        root.settings-input-draft = "";
                    }
                }
            }
        }
    }
}
