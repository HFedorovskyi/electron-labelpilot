// Shared semantic palette for application pages and settings controls.
export global Palette {
    in-out property <bool> dark: false;
    out property <color> surface: dark ? #1b2432 : white;
    out property <color> n50: dark ? #151b25 : #fafafa;
    out property <color> n100: dark ? #202938 : #f5f5f5;
    out property <color> n200: dark ? #334155 : #e5e5e5;
    out property <color> n300: dark ? #475569 : #d4d4d4;
    out property <color> n400: dark ? #94a3b8 : #a3a3a3;
    out property <color> n500: dark ? #a8b3c4 : #737373;
    out property <color> n600: dark ? #bdc8d8 : #525252;
    out property <color> n700: dark ? #d5dce6 : #404040;
    out property <color> n800: dark ? #e5eaf1 : #262626;
    out property <color> n900: dark ? #f3f6fa : #171717;
    out property <color> e50: dark ? #102f2a : #ecfdf5;
    out property <color> e100: dark ? #163f34 : #d1fae5;
    out property <color> e200: dark ? #215c47 : #a7f3d0;
    out property <color> e300: dark ? #3baf84 : #6ee7b7;
    out property <color> e400: dark ? #34d399 : #34d399;
    out property <color> e500: dark ? #10b981 : #10b981;
    out property <color> e600: dark ? #059669 : #059669;
    out property <color> e700: dark ? #6ee7b7 : #047857;
    out property <color> a50: dark ? #342817 : #fffbeb;
    out property <color> a300: dark ? #ad8427 : #fcd34d;
    out property <color> a500: dark ? #f59e0b : #f59e0b;
    out property <color> a600: dark ? #fbbf24 : #d97706;
    out property <color> a700: dark ? #fcd34d : #b45309;
    out property <color> r50: dark ? #361e25 : #fef2f2;
    out property <color> r100: dark ? #4a242b : #fee2e2;
    out property <color> r300: dark ? #b65a66 : #fca5a5;
    out property <color> r400: dark ? #f87171 : #f87171;
    out property <color> r500: dark ? #ef4444 : #ef4444;
    out property <color> r600: dark ? #fb7185 : #dc2626;
    out property <color> r700: dark ? #fda4af : #b91c1c;
    out property <color> solid-n500: #737373;
    out property <color> solid-n600: #525252;
    out property <color> solid-n700: #404040;
    out property <color> solid-n800: #262626;
    out property <color> solid-n900: #171717;
    out property <color> solid-a600: #d97706;
    out property <color> solid-a700: #b45309;
    out property <color> solid-r600: #dc2626;
    out property <color> solid-r700: #b91c1c;
    out property <color> solid-e700: #047857;
}
